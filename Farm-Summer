-- HÀM PHÁT HIỆN VẬT PHẨM QUY ĐỔI SỰ KIỆN (KHÔNG DÙNG TÊN)
-- =============================================
local function FindEventCurrency()
    local items = {}
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character then return items end
    local rootPos = character:FindFirstChild("HumanoidRootPart")
    if not rootPos then return items end
    
    local allObjects = workspace:GetDescendants()
    
    for _, obj in ipairs(allObjects) do
        local isCurrency = false
        local position = nil
        
        -- CÁCH 1: PHÁT HIỆN QUA CƠ CHẾ TƯƠNG TÁC
        local clickDetector = obj:FindFirstChild("ClickDetector")
        local proximityPrompt = obj:FindFirstChild("ProximityPrompt")
        
        if clickDetector or proximityPrompt then
            if not obj:IsDescendantOf(character) then
                -- CÁCH 2: KIỂM TRA ATTRIBUTE
                local attrs = {
                    "CurrencyType", "EventCurrency", "Collectible", 
                    "Currency", "Reward", "Value", "Points",
                    "Collectable", "Pickup", "Item"
                }
                
                for _, attr in ipairs(attrs) do
                    if obj:GetAttribute(attr) then
                        isCurrency = true
                        break
                    end
                end
                
                -- CÁCH 3: KIỂM TRA GIÁ TRỊ TRONG CLICKDETECTOR
                if not isCurrency and clickDetector then
                    local value = clickDetector:GetAttribute("Value")
                    if value and value > 0 then
                        isCurrency = true
                    end
                end
                
                -- CÁCH 4: KIỂM TRA GIÁ TRỊ TRONG PROXIMITYPROMPT
                if not isCurrency and proximityPrompt then
                    local value = proximityPrompt:GetAttribute("Value")
                    if value and value > 0 then
                        isCurrency = true
                    end
                end
            end
        end
        
        if isCurrency then
            if obj:IsA("BasePart") then
                position = obj.Position
            elseif obj:IsA("Model") then
                if obj:FindFirstChild("PrimaryPart") then
                    position = obj.PrimaryPart.Position
                elseif obj:FindFirstChild("HumanoidRootPart") then
                    position = obj.HumanoidRootPart.Position
                elseif obj:FindFirstChild("Head") then
                    position = obj.Head.Position
                else
                    local sumPos = Vector3.new(0, 0, 0)
                    local count = 0
                    for _, part in ipairs(obj:GetChildren()) do
                        if part:IsA("BasePart") then
                            sumPos = sumPos + part.Position
                            count = count + 1
                        end
                    end
                    if count > 0 then position = sumPos / count end
                end
            end
            
            if position then
                table.insert(items, {
                    object = obj,
                    position = position,
                    name = obj.Name,
                    distance = (rootPos.Position - position).Magnitude,
                    clickDetector = clickDetector,
                    proximityPrompt = proximityPrompt
                })
            end
        end
    end
    
    table.sort(items, function(a, b)
        return a.distance < b.distance
    end)
    
    return items
end

-- =============================================
-- HÀM KIỂM TRA SỰ KIỆN
-- =============================================
local function CheckEventStatus()
    pcall(function()
        local items = FindEventCurrency()
        local hasItems = #items > 0
        
        local eventTime = workspace:FindFirstChild("EventTimeLeft")
        if eventTime then
            local timeLeft = eventTime.Value or 0
            if timeLeft > 0 then
                local days = math.floor(timeLeft / 86400)
                local hours = math.floor((timeLeft % 86400) / 3600)
                local minutes = math.floor((timeLeft % 3600) / 60)
                EventTimeLabel:Set("⏰ Event remaining: " .. days .. "d " .. hours .. "h " .. minutes .. "m")
                EventActive = true
            else
                EventTimeLabel:Set("⏰ Event has ended!")
                EventActive = false
            end
        else
            if hasItems then
                EventTimeLabel:Set("⏰ Event is active! (" .. #items .. " items found)")
                EventActive = true
            else
                EventTimeLabel:Set("⏰ No event detected. Waiting...")
                EventActive = false
            end
        end
        
        return EventActive
    end)
    return EventActive
end

