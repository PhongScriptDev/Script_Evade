local function ForceRespawn()
    local LocalPlayer = game.Players.LocalPlayer
    if not HasShownDied then
        HasShownDied = true
        HasShownRevived = false
        ShowNotification("💀 BỊ HẠ GỤC!", "Đang tự động respawn...", 3, Color3.fromRGB(255, 0, 0))
    end
    pcall(function() LocalPlayer:LoadCharacter() end)
    wait(0.5)
    local char = LocalPlayer.Character
    if char then
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then
            root.CFrame = CFrame.new(FindSafeWallPosition())
        end
        local humanoid = char:FindFirstChild("Humanoid")
        if humanoid then humanoid.Health = 100 end
    end
    if not HasShownRevived then
        HasShownRevived = true
        HasShownDied = false
        ShowNotification("🔄 ĐÃ RESPAWN", "Đã tự động respawn thành công!", 3, Color3.fromRGB(0, 255, 0))
    end
end

local function CheckDeath()
    if not AntiDied then return end
    local LocalPlayer = game.Players.LocalPlayer
    local char = LocalPlayer.Character
    if not char then
        LocalPlayer:LoadCharacter()
        return
    end
    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid then return end
    if humanoid.Health <= 0 or humanoid:GetState() == Enum.HumanoidStateType.Dead then
        ForceRespawn()
        return
    end
    for _, child in ipairs(char:GetChildren()) do
        if child.Name:lower():find("downed") or child.Name:lower():find("dead") then
            ForceRespawn()
            return
        end
    end
end

