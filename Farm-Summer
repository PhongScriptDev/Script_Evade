local AutoFarm = false
local FarmConnection = nil
local CollectedCount = 0
local EventItems = {}
local CurrentTarget = nil
local IsMoving = false
local FarmCooldown = 0

-- Tìm vật phẩm sự kiện (BÓNG BAY)
local function FindEventItems()
    EventItems = {}
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character then return EventItems end
    
    local rootPos = character:FindFirstChild("HumanoidRootPart")
    if not rootPos then return EventItems end
    
    -- Tìm bóng bay (balloon) - vật phẩm sự kiện mùa hè 2026
    for _, obj in ipairs(workspace:GetDescendants()) do
        -- Kiểm tra tên có chứa "balloon" hoặc "bong"
        local name = obj.Name:lower()
        if name:find("balloon") or name:find("bong") or name:find("event") then
            -- Lấy vị trí
            local position = nil
            
            if obj:IsA("Part") or obj:IsA("MeshPart") then
                position = obj.Position
            elseif obj:IsA("Model") then
                if obj:FindFirstChild("PrimaryPart") then
                    position = obj.PrimaryPart.Position
                elseif obj:FindFirstChild("HumanoidRootPart") then
                    position = obj.HumanoidRootPart.Position
                elseif obj:FindFirstChild("Head") then
                    position = obj.Head.Position
                else
                    -- Lấy vị trí trung bình
                    local sumPos = Vector3.new(0, 0, 0)
                    local count = 0
                    for _, part in ipairs(obj:GetChildren()) do
                        if part:IsA("Part") or part:IsA("MeshPart") then
                            sumPos = sumPos + part.Position
                            count = count + 1
                        end
                    end
                    if count > 0 then
                        position = sumPos / count
                    end
                end
            end
            
            if position then
                local dist = (rootPos.Position - position).Magnitude
                -- Chỉ lấy vật phẩm trong bán kính 300 studs
                if dist < 300 then
                    table.insert(EventItems, {
                        object = obj,
                        position = position,
                        distance = dist,
                        name = obj.Name
                    })
                end
            end
        end
    end
    
    -- Sắp xếp theo khoảng cách gần nhất
    table.sort(EventItems, function(a, b)
        return a.distance < b.distance
    end)
    
    print("[AutoFarm] 🎈 Tìm thấy " .. #EventItems .. " bóng bay")
    return EventItems
end

-- Di chuyển đến vị trí (KHÔNG TELEPORT)
local function MoveToPosition(targetPos)
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character then return false end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end
    
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid then return false end
    
    local currentPos = rootPart.Position
    local dist = (currentPos - targetPos).Magnitude
    
    if dist < 8 then
        return true -- Đã đến gần
    end
    
    -- DI CHUYỂN TỪ TỪ (KHÔNG TELEPORT)
    local moveDirection = (targetPos - currentPos).Unit
    local moveSpeed = 16 -- Tốc độ di chuyển
    local step = math.min(dist, moveSpeed * 0.5)
    local newPos = currentPos + moveDirection * step
    
    -- Giữ nguyên Y để không bị rơi
    newPos = Vector3.new(newPos.X, currentPos.Y, newPos.Z)
    
    rootPart.CFrame = CFrame.new(newPos)
    return false
end

-- Nhặt bóng bay
local function CollectBalloon(item)
    if not item or not item.object then return false end
    
    print("[AutoFarm] 🎈 Đang nhặt: " .. item.name)
    
    local success = false
    
    -- Cách 1: ClickDetector
    local clickDetector = item.object:FindFirstChild("ClickDetector")
    if clickDetector then
        pcall(function()
            clickDetector:FireClick()
            success = true
        end)
    end
    
    -- Cách 2: ProximityPrompt
    local proximityPrompt = item.object:FindFirstChild("ProximityPrompt")
    if proximityPrompt then
        pcall(function()
            proximityPrompt:Fire()
            success = true
        end)
    end
    
    -- Cách 3: Di chuyển đến gần để tự động nhặt
    if not success then
        local LocalPlayer = game.Players.LocalPlayer
        local character = LocalPlayer.Character
        if character and character:FindFirstChild("HumanoidRootPart") then
            local root = character.HumanoidRootPart
            root.CFrame = CFrame.new(item.position + Vector3.new(0, 0, 0))
            success = true
        end
    end
    
    if success then
        CollectedCount = CollectedCount + 1
        print("[AutoFarm] ✅ Đã nhặt: " .. item.name .. " (Tổng: " .. CollectedCount .. ")")
        ShowNotification("🎈 Đã nhặt!", "Bóng bay #" .. CollectedCount, 2, Color3.fromRGB(0, 255, 255))
    end
    
    return success
end

-- Farm loop - Klocal function FarmLoop()
    if not AutoFarm then return end
    
    -- Cooldown để không spam
    if tick() - FarmCooldown < 2 then
        return
    end
    
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character then return end
    
    -- Tìm vật phẩm
    local items = FindEventItems()
    
    if #items == 0 then
        print("[AutoFarm] ⚠️ Không tìm thấy bóng bay nào!")
        FarmCooldown = tick()
        return
    end
    
    -- Lấy vật phẩm gần nhất
    local target = items[1]
    if not target then return end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    local currentPos = rootPart.Position
    local dist = (currentPos - target.position).Magnitude
    
    if dist < 10 then
        -- Ở gần -> nhặt
        CollectBalloon(target)
        FarmCooldown = tick()
        wait(0.5)
    else
        -- Di chuyển đến gần (KHÔNG TELEPORT)
        print("[AutoFarm] 🚶 Đang di chuyển đến bóng bay (Khoảng cách: " .. tostring(math.floor(dist)) .. " studs)")
        MoveToPosition(target.position)
        FarmCooldown = tick()
    end
end

