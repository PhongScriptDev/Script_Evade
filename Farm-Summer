-- FARM LOOP (CÓ TỰ ĐỘNG HỒI SINH)
-- =============================================
local function FarmLoop()
    if not AutoFarm then return end
    
    -- TỰ ĐỘNG HỒI SINH NẾU BỊ HẠ GỤC
    CheckAndRevive()
    
    if tick() - FarmCooldown < 0.3 then return end
    
    local eventActive, eventName, eventTime = ScanGameForEvent()
    
    if not eventActive then
        if AutoFarm then
            AutoFarm = false
            if FarmConnection then
                FarmConnection:Disconnect()
                FarmConnection = nil
            end
            SendNotification("⛔ KHÔNG CÓ SỰ KIỆN!", "Không tìm thấy sự kiện trong game. Đã tự động tắt farm.", 5)
            EventStatusLabel:Set("📌 Event: ❌ NONE")
        end
        return
    end
    
    local LocalPlayer = game.Players.LocalPlayer
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    if char:GetAttribute("Downed") then
        FarmCooldown = tick()
        return
    end
    
    CheckAndKeepOnWall()
    
    local items = FindEventItems()
    TotalItems = #items
    CurrencyLabel:Set("🎯 Event Items: " .. TotalItems)
    
    if TotalItems == 0 then
        if not IsAtWall then
            TeleportToWall()
        end
        FarmCooldown = tick()
        return
    end
    
    local currentPos = root.Position
    local nearestItem = items[1]
    
    if not nearestItem then
        FarmCooldown = tick()
        return
    end
    
    local distToItem = (currentPos - nearestItem.position).Magnitude
    
    if IsAtWall then
        SendNotification("❗ Tìm thấy!", "📌 Đang đến vật phẩm...", 1.5)
        StopEmote()
        TeleportToItem(nearestItem.position)
        FarmCooldown = tick()
        return
    end
    
    if distToItem < 20 then
        local collected = CollectItemWithRetry(nearestItem)
        TeleportToWall()
        SendNotification("📍 Về tường", "🔄 Đã quay lại!", 1.5)
        FarmCooldown = tick()
        return
    end
    
    TeleportToItem(nearestItem.position)
    FarmCooldown = tick()
end

