-- Tạo vị trí trên trời ngẫu nhiên
local function GenerateSkyPositions()
    SkyPositions = {}
    for i = 1, 50 do
        local x = math.random(-350, 350)
        local z = math.random(-350, 350)
        local y = math.random(200, 450)
        table.insert(SkyPositions, Vector3.new(x, y, z))
    end
end

-- Kiểm tra vị trí an toàn
local function IsPositionSafeFast(position, minDistance)
    local LocalPlayer = game.Players.LocalPlayer
    
    for _, player in ipairs(game.Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local enemyChar = player.Character
            if enemyChar and enemyChar:FindFirstChild("HumanoidRootPart") then
                local enemyPos = enemyChar.HumanoidRootPart.Position
                local dist = (position - enemyPos).Magnitude
                if dist < minDistance then
                    return false, enemyPos
                end
            end
        end
    end
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("HumanoidRootPart") then
            local name = obj.Name:lower()
            if name:find("bot") or name:find("next") or name:find("npc") or name:find("enemy") then
                local enemyPos = obj.HumanoidRootPart.Position
                local dist = (position - enemyPos).Magnitude
                if dist < minDistance then
                    return false, enemyPos
                end
            end
        end
    end
    
    return true, nil
end

-- Lấy tất cả bot
local function GetAllBots()
    local bots = {}
    local LocalPlayer = game.Players.LocalPlayer
    
    for _, player in ipairs(game.Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local enemyChar = player.Character
            if enemyChar and enemyChar:FindFirstChild("HumanoidRootPart") then
                local enemyPos = enemyChar.HumanoidRootPart.Position
                
                if not BotPositions[player] then
                    BotPositions[player] = {
                        positions = {},
                        speed = 0,
                        direction = Vector3.new(0, 0, 0)
                    }
                end
                
                table.insert(bots, {
                    name = player.Name,
                    position = enemyPos,
                    velocity = Vector3.new(0, 0, 0),
                    data = BotPositions[player]
                })
            end
        end
    end
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("HumanoidRootPart") then
            local name = obj.Name:lower()
            if name:find("bot") or name:find("next") or name:find("npc") or name:find("enemy") then
                local enemyPos = obj.HumanoidRootPart.Position
                
                local botKey = "npc_" .. obj.Name
                if not BotPositions[botKey] then
                    BotPositions[botKey] = {
                        positions = {},
                        speed = 0,
                        direction = Vector3.new(0, 0, 0)
                    }
                end
                
                table.insert(bots, {
                    name = obj.Name,
                    position = enemyPos,
                    velocity = Vector3.new(0, 0, 0),
                    data = BotPositions[botKey]
                })
            end
        end
    end
    
    return bots
end

-- Tính tốc độ bot
local function CalculateBotSpeed(bot)
    local botData = bot.data
    local currentPos = bot.position
    
    table.insert(botData.positions, currentPos)
    if #botData.positions > 5 then
        table.remove(botData.positions, 1)
    end
    
    if #botData.positions >= 2 then
        local lastPos = botData.positions[#botData.positions - 1]
        local timeDiff = 0.1
        
        if lastPos then
            local velocity = (currentPos - lastPos) / timeDiff
            local speed = velocity.Magnitude
            botData.speed = speed
            botData.direction = velocity.Unit
            return speed, velocity.Unit
        end
    end
    
    return 0, Vector3.new(0, 0, 0)
end

-- Dịch chuyển khẩn cấp
local function EmergencyTeleportNow()
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        return
    end
    
    local rootPart = character.HumanoidRootPart
    
    local emergencyPos = Vector3.new(
        math.random(-400, 400),
        math.random(300, 500),
        math.random(-400, 400)
    )
    
    local safePos = nil
    local attempts = 0
    local maxAttempts = 20
    
    while safePos == nil and attempts < maxAttempts do
        attempts = attempts + 1
        local randomPos = Vector3.new(
            math.random(-350, 350),
            math.random(250, 450),
            math.random(-350, 350)
        )
        
        local isSafe, _ = IsPositionSafeFast(randomPos, 60)
        if isSafe then
            safePos = randomPos
            break
        end
    end
    
    if not safePos then
        safePos = emergencyPos
    end
    
    rootPart.CFrame = CFrame.new(safePos)
    CurrentSkyPos = safePos
    
    local humanoid = character:FindFirstChild("Humanoid")
    if humanoid then
        humanoid.PlatformStand = false
    end
    
    print("[Chống NextBot] DỊCH CHUYỂN KHẨN CẤP!")
end

-- Dịch chuyển lên trời nhanh
local function TeleportToSkyFast()
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        return
    end
    
    local rootPart = character.HumanoidRootPart
    
    if #SkyPositions == 0 then
        GenerateSkyPositions()
    end
    
    local safePos = nil
    local attempts = 0
    local maxAttempts = 15
    
    while safePos == nil and attempts < maxAttempts do
        attempts = attempts + 1
        local randomPos = SkyPositions[math.random(1, #SkyPositions)]
        
        local isSafe, _ = IsPositionSafeFast(randomPos, 50)
        if isSafe then
            safePos = randomPos
            break
        else
            table.remove(SkyPositions, table.find(SkyPositions, randomPos))
            if #SkyPositions == 0 then
                GenerateSkyPositions()
            end
        end
    end
    
    if not safePos then
        safePos = Vector3.new(
            math.random(-300, 300),
            math.random(250, 450),
            math.random(-300, 300)
        )
    end
    
    rootPart.CFrame = CFrame.new(safePos)
    CurrentSkyPos = safePos
    
    local humanoid = character:FindFirstChild("Humanoid")
    if humanoid then
        humanoid.PlatformStand = false
    end
end

-- Kiểm tra và phản ứng nhanh
local function CheckAndReactFast()
    if not AntiNextBot then
        return
    end
    
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        return
    end
    
    local rootPart = character.HumanoidRootPart
    local currentPos = rootPart.Position
    
    if currentPos.Y < 50 then
        print("[Chống NextBot] Đang ở dưới đất! Dịch chuyển khẩn cấp!")
        EmergencyTeleportNow()
        return
    end
    
    local bots = GetAllBots()
    local nearestBot = nil
    local nearestDist = math.huge
    local approachingBot = nil
    local fastestBot = nil
    local fastestSpeed = 0
    
    for _, bot in ipairs(bots) do
        local dist = (currentPos - bot.position).Magnitude
        
        local speed, direction = CalculateBotSpeed(bot)
        
        if speed > fastestSpeed then
            fastestSpeed = speed
            fastestBot = bot
        end
        
        if speed > 5 then
            local dirToBot = (bot.position - currentPos).Unit
            local dotProduct = direction:Dot(dirToBot)
            
            if dotProduct > 0.3 then
                if dist < 100 then
                    approachingBot = bot
                    print("[Chống NextBot] Bot đang tiến đến! Tốc độ: " .. tostring(speed))
                    break
                end
            end
        end
        
        if dist < nearestDist then
            nearestDist = dist
            nearestBot = bot
        end
    end
    
    if approachingBot then
        print("[Chống NextBot] KHẨN CẤP: Bot đang tiến đến nhanh!")
        EmergencyTeleportNow()
        return
    end
    
    if nearestDist < 45 then
        print("[Chống NextBot] KHẨN CẤP: Bot quá gần! (" .. tostring(nearestDist) .. " studs)")
        EmergencyTeleportNow()
        return
    end
    
    if fastestBot and fastestSpeed > 20 then
        local dirToFastBot = (fastestBot.position - currentPos).Unit
        local dirToFastBotOld = (fastestBot.data.positions[#fastestBot.data.positions - 1] - currentPos).Unit
        
        if dirToFastBot and dirToFastBotOld then
            local dotProduct = dirToFastBot:Dot(dirToFastBotOld)
            if dotProduct > 0.5 and nearestDist < 120 then
                print("[Chống NextBot] KHẨN CẤP: Bot chạy nhanh phát hiện! Tốc độ: " .. tostring(fastestSpeed))
                EmergencyTeleportNow()
                return
            end
        end
    end
    
    local currentTime = tick()
    local teleportInterval = IsSpecialRound and 3 or 5
    
    if not character:FindFirstChild("LastTeleportTime") then
        local timeVal = Instance.new("NumberValue")
        timeVal.Name = "LastTeleportTime"
        timeVal.Value = currentTime
        timeVal.Parent = character
    else
        local lastTime = character.LastTeleportTime.Value
        if currentTime - lastTime > teleportInterval then
            print("[Chống NextBot] Dịch chuyển định kỳ (" .. (IsSpecialRound and "Đặc biệt" or "Bình thường") .. " vòng)")
            TeleportToSkyFast()
            character.LastTeleportTime.Value = currentTime
        end
    end
    
    local isSafe, unsafePos = IsPositionSafeFast(currentPos, 40)
    if not isSafe then
        print("[Chống NextBot] Vị trí không an toàn! Đang dịch chuyển...")
        TeleportToSkyFast()
    end
end

-- Kiểm tra vòng đặc biệt
local function CheckRoundType()
    local gameState = game:GetService("Workspace"):FindFirstChild("GameState")
    if gameState then
        local stateText = tostring(gameState.Value or "")
        if stateText:lower():find("special") or stateText:lower():find("boss") then
            IsSpecialRound = true
        else
            IsSpecialRound = false
        end
    end
end

