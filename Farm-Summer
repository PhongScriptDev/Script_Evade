local function CheckPlayerState()
    local LocalPlayer = game.Players.LocalPlayer
    local char = LocalPlayer.Character
    if not char then
        if not IsWaitingToJoin then
            IsWaitingToJoin = true
            IsDead = true
            SendNotification("🔔 Thông báo tạm dừng farm", "❗ Đã phát hiện người dùng chết...", 3)
        end
        return "dead"
    end
    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid then return "unknown"
    local isDowned = char:GetAttribute("Downed") or false
    local health = humanoid.Health or 0
    local isDeadState = humanoid:GetState() == Enum.HumanoidStateType.Dead
    if isDowned then
        if not IsDowned then
            IsDowned = true
            SendNotification("🔔 Thông báo tạm dừng farm", "😡 Địt mẹ thằng chó next-bot cắn tao cái lồn", 3)
        end
        return "downed"
    end
    if health <= 0 or isDeadState then
        if not IsDead then
            IsDead = true
            SendNotification("🔔 Thông báo tạm dừng farm", "❗ Đã phát hiện người dùng chết...", 3)
        end
        return "dead"
    end
    if IsDowned or IsDead then
        IsDowned = false
        IsDead = false
        IsWaitingToJoin = false
        SendNotification("🔔 Thông báo hồi sinh!", "👤 Đã hồi sinh thành công...", 3)
    end
    return "alive"
end

local function CheckAndJoinMap()
    if not IsWaitingToJoin then return end
    if AutoJoinMap() then
        IsWaitingToJoin = false
        return
    end
    if IsPlayerInMap() then
        IsWaitingToJoin = false
        return
    end
end

-- FARM LOOP
local function FarmLoop()
    if not AutoFarm then return end
    local state = CheckPlayerState()
    if state == "dead" then
        CheckAndJoinMap()
        FarmCooldown = tick()
        return
    elseif state == "downed" then
        AutoRevive()
        FarmCooldown = tick()
        return
    elseif state == "unknown" then
        FarmCooldown = tick()
        return
    end
    if tick() - FarmCooldown < 0.3 then return end
    local eventActive, eventName, eventTime = ScanGameForEvent()
    if not eventActive then
        if AutoFarm then
            AutoFarm = false
            if FarmConnection then
                FarmConnection:Disconnect()
                FarmConnection = nil
            end
            SendNotification("⛔ KHÔNG CÓ SỰ KIỆN!", "Không tìm thấy sự kiện trong game. Đã tự động tắt farm.", 5)
            EventStatusLabel:Set("📌 Event: ❌ NONE")
        end
        return
    end
    local LocalPlayer = game.Players.LocalPlayer
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    CheckAndKeepOnWall()
    local items = FindEventItems()
    TotalItems = #items
    CurrencyLabel:Set("🎯 Event Items: " .. TotalItems)
    if TotalItems == 0 then
        if not IsAtWall then TeleportToWall() end
        FarmCooldown = tick()
        return
    end
    local currentPos = root.Position
    local nearestItem = items[1]
    if not nearestItem then
        FarmCooldown = tick()
        return
    end
    local distToItem = (currentPos - nearestItem.position).Magnitude
    if IsAtWall then
        SendNotification("❗ Tìm thấy!", "📌 Đang đến vật phẩm...", 1.5)
        StopEmote()
        TeleportToItem(nearestItem.position)
        FarmCooldown = tick()
        return
    end
    if distToItem < 20 then
        local collected = CollectItemWithRetry(nearestItem)
        TeleportToWall()
        SendNotification("📍 Về tường", "🔄 Đã quay lại!", 1.5)
        FarmCooldown = tick()
        return
    end
    TeleportToItem(nearestItem.position)
    FarmCooldown = tick()
end

