        local count = 0
        for _, obj in ipairs(workspace:GetDescendants()) do
            local name = obj.Name or ""
            if name:lower():find("bubble") then
                count = count + 1
            end
        end
        BubbleCount = count
        BubbleLabel:Set("🎈 Bubble trong map: " .. count)
        TotalLabel:Set("🎯 Đã nhặt: " .. CollectedCount .. " Bubble")
    end)
end

