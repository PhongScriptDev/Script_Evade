local function ShowNotification(title, message, duration, color)
    duration = duration or 3
    if tick() - LastNotificationTime < 1.5 then return end
    LastNotificationTime = tick()
    pcall(function()
        Rayfield:Notify({
            Title = title,
            Content = message,
            Duration = duration,
            Image = 0,
            Actions = {}
        })
    end)
end

local function GetTimeInfo()
    local now = os.time()
    local date = os.date("*t", now)
    local timeStr = string.format("%02d:%02d:%02d", date.hour, date.min, date.sec)
    local days = {"Chủ nhật", "Thứ hai", "Thứ ba", "Thứ tư", "Thứ năm", "Thứ sáu", "Thứ bảy"}
    local dayStr = days[date.wday]
    local dateStr = string.format("%s, %02d/%02d/%04d", dayStr, date.day, date.month, date.year)
    local period = ""
    if date.hour >= 5 and date.hour < 12 then period = "buổi sáng"
    elseif date.hour >= 12 and date.hour < 18 then period = "buổi chiều"
    elseif date.hour >= 18 and date.hour < 22 then period = "buổi tối"
    else period = "buổi đêm" end
    return timeStr, dateStr, period, "Ngựa"
end

local function GetRainbowColor(offset)
    offset = offset or 0
    local time = tick() * 0.5 + offset
    return Color3.fromHSV((time % 1), 1, 1)
end

