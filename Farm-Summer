local function StopEmote()
    pcall(function()
        local char = game.Players.LocalPlayer.Character
        if char then
            local humanoid = char:FindFirstChild("Humanoid")
            if humanoid then
                humanoid:LoadAnimation(nil)
                local animator = char:FindFirstChild("Animator")
                if animator then
                    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                        track:Stop()
                    end
                end
            end
        end
    end)
end

local function CollectItemWithRetry(item)
    if not item or IsCollecting then return false end
    IsCollecting = true
    
    local success = false
    local attempt = 0
    local maxAttempts = 3
    local beforeCurrency = GetCurrentCurrency()
    
    while attempt < maxAttempts and not success do
        attempt = attempt + 1
        
        StopEmote()
        
        if item.clickDetector then
            pcall(function()
                item.clickDetector:FireClick()
                success = true
            end)
        end
        
        if not success and item.proximityPrompt then
            pcall(function()
                item.proximityPrompt:Fire()
                success = true
            end)
        end
        
        if success then
            break
        end
        
        if attempt < maxAttempts then
            local char = game.Players.LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                char.HumanoidRootPart.CFrame = CFrame.new(item.position + Vector3.new(0, 0.5, 0))
                wait(0.1)
            end
        end
    end
    
    local afterCurrency = GetCurrentCurrency()
    local gained = afterCurrency - beforeCurrency
    
    if success and gained > 0 then
        CollectedCount = CollectedCount + gained
        CurrentCurrency = afterCurrency
        
        SendNotification("🔔 Thông báo nhận vật phẩm sự kiện!", "❓ Vật phẩm nhận được: " .. gained, 2.5)
        SendNotification("🔔 Thông báo vật phẩm sự kiện...", "📌 Vật phẩm hiện tại của bạn là: " .. afterCurrency, 2.5)
        
        CurrentCurrencyLabel:Set("💰 Current currency: " .. afterCurrency)
        RetryCount = 0
        IsCollecting = false
        return true
    end
    
    local stillExists = false
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj == item.object then
            stillExists = true
            break
        end
    end
    
    if not stillExists then
        if afterCurrency > beforeCurrency then
            CollectedCount = CollectedCount + (afterCurrency - beforeCurrency)
            CurrentCurrency = afterCurrency
            CurrentCurrencyLabel:Set("💰 Current currency: " .. afterCurrency)
            SendNotification("🔔 Thông báo nhận vật phẩm sự kiện!", "❓ Vật phẩm nhận được: " .. (afterCurrency - beforeCurrency), 2.5)
            SendNotification("🔔 Thông báo vật phẩm sự kiện...", "📌 Vật phẩm hiện tại của bạn là: " .. afterCurrency, 2.5)
            IsCollecting = false
            return true
        end
    end
    
    IsCollecting = false
    return false
end

