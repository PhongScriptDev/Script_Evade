-- =============================================
-- FARM LOOP
-- =============================================
local function FarmLoop()
    if not AutoFarm then return end
    if tick() - FarmCooldown < 0.5 then return end
    
    local LocalPlayer = game.Players.LocalPlayer
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    if char:GetAttribute("Downed") then
        FarmCooldown = tick()
        return
    end
    
    -- Quét tìm vật phẩm
    SendNotification("⚡ Quét Server", "⚙️ Đang quét toàn diện server", 2)
    local items = FindEventItems()
    TotalItems = #items
    CurrencyLabel:Set("🎯 Event Items: " .. TotalItems)
    
    if TotalItems == 0 then
        if not IsAtWall then
            TeleportToWall()
        end
        FarmCooldown = tick()
        return
    end
    
    local currentPos = root.Position
    local nearestItem = items[1]
    
    if not nearestItem then
        FarmCooldown = tick()
        return
    end
    
    local distToItem = (currentPos - nearestItem.position).Magnitude
    
    -- Đang ở tường -> teleport đến vật phẩm
    if IsAtWall then
        SendNotification("❗ Đã thấy vật phẩm", "📌 Đang tiến hành đến vật phẩm...", 2)
        TeleportToItem(nearestItem.position)
        FarmCooldown = tick()
        return
    end
    
    -- Đang ở gần vật phẩm -> nhặt và về tường
    if distToItem < 15 then
        local collected = CollectItem(nearestItem)
        if collected then
            TeleportToWall()
            SendNotification("📍 Về tường", "🔄 Đã teleport về tường thành công!", 2)
        else
            -- Nếu chưa nhặt được -> thử teleport lại
            TeleportToItem(nearestItem.position)
            wait(0.2)
            CollectItem(nearestItem)
            TeleportToWall()
        end
        FarmCooldown = tick()
        return
    end
    
    -- Chưa đến gần -> teleport tiếp
    TeleportToItem(nearestItem.position)
    FarmCooldown = tick()
end

