local AntiNextBot = false
local NextBotConnection = nil
local NextBotCheckCooldown = 0
local MapBounds = {
    MinX = -250, MaxX = 250,
    MinZ = -250, MaxZ = 250,
    MinY = 30, MaxY = 200
}

-- Quét map để cập nhật giới hạn (KHÔNG BAO GỒM DƯỚI ĐẤT)
local function UpdateMapBounds()
    local minX, maxX = -250, 250
    local minZ, maxZ = -250, 250
    local minY, maxY = 30, 200
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Part") and obj.Size.Magnitude > 50 then
            local pos = obj.Position
            local size = obj.Size
            minX = math.min(minX, pos.X - size.X/2)
            maxX = math.max(maxX, pos.X + size.X/2)
            minZ = math.min(minZ, pos.Z - size.Z/2)
            maxZ = math.max(maxZ, pos.Z + size.Z/2)
            -- KHÔNG lấy minY từ map để tránh teleport xuống đất
            maxY = math.max(maxY, pos.Y + size.Y/2)
        end
    end
    
    MapBounds.MinX = minX + 20
    MapBounds.MaxX = maxX - 20
    MapBounds.MinZ = minZ + 20
    MapBounds.MaxZ = maxZ - 20
    MapBounds.MinY = 30 -- LUÔN TRÊN MẶT ĐẤT
    MapBounds.MaxY = math.min(maxY - 10, 250)
    
    print("[NextBot] Đã cập nhật giới hạn map (Y >= 30)")
end

-- Kiểm tra vị trí có trong map và TRÊN MẶT ĐẤT không
local function IsInsideMap(pos)
    return pos.X >= MapBounds.MinX and pos.X <= MapBounds.MaxX and
           pos.Z >= MapBounds.MinZ and pos.Z <= MapBounds.MaxZ and
           pos.Y >= MapBounds.MinY and pos.Y <= MapBounds.MaxY
end

-- Tìm vị trí an toàn (TRÊN MẶT ĐẤT, không có bot)
local function FindSafePosition()
    UpdateMapBounds()
    
    for attempt = 1, 50 do
        local testPos = Vector3.new(
            math.random(MapBounds.MinX, MapBounds.MaxX),
            math.random(MapBounds.MinY + 10, MapBounds.MaxY - 10),
            math.random(MapBounds.MinZ, MapBounds.MaxZ)
        )
        
        -- Đảm bảo không dưới đất
        if testPos.Y < 30 then
            testPos = Vector3.new(testPos.X, math.random(40, 150), testPos.Z)
        end
        
        if not IsInsideMap(testPos) then
            testPos = Vector3.new(
                math.random(MapBounds.MinX + 10, MapBounds.MaxX - 10),
                math.random(MapBounds.MinY + 10, MapBounds.MaxY - 10),
                math.random(MapBounds.MinZ + 10, MapBounds.MaxZ - 10)
            )
        end
        
        local isSafe = true
        local LocalPlayer = game.Players.LocalPlayer
        
        for _, player in ipairs(game.Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local enemy = player.Character
                if enemy and enemy:FindFirstChild("HumanoidRootPart") then
                    local dist = (testPos - enemy.HumanoidRootPart.Position).Magnitude
                    if dist < 55 then
                        isSafe = false
                        break
                    end
                end
            end
        end
        
        if isSafe then
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("Model") and obj:FindFirstChild("HumanoidRootPart") then
                    local name = obj.Name:lower()
                    if name:find("bot") or name:find("next") or name:find("npc") then
                        local dist = (testPos - obj.HumanoidRootPart.Position).Magnitude
                        if dist < 55 then
                            isSafe = false
                            break
                        end
                    end
                end
            end
        end
        
        if isSafe and IsInsideMap(testPos) and testPos.Y > 30 then
            return testPos
        end
    end
    
    return Vector3.new(0, 50, 0)
end

-- Kiểm tra NextBot
local function CheckNextBot()
    if not AntiNextBot then return end
    
    if tick() - NextBotCheckCooldown < 0.3 then
        return
    end
    NextBotCheckCooldown = tick()
    
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character then return end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    local currentPos = rootPart.Position
    
    UpdateMapBounds()
    
    -- Nếu đang ở dưới đất hoặc ngoài map -> teleport lên
    if currentPos.Y < 30 or not IsInsideMap(currentPos) then
        local safePos = FindSafePosition()
        if safePos and safePos.Y > 30 then
            rootPart.CFrame = CFrame.new(safePos)
            print("[NextBot] Đang ở dưới đất/ngoài map, teleport lên")
            return
        end
    end
    
    -- Kiểm tra bot gần
    local botNear = false
    
    for _, player in ipairs(game.Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local enemy = player.Character
            if enemy and enemy:FindFirstChild("HumanoidRootPart") then
                local dist = (currentPos - enemy.HumanoidRootPart.Position).Magnitude
                if dist < 55 then
                    botNear = true
                    break
                end
            end
        end
    end
    
    if not botNear then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and obj:FindFirstChild("HumanoidRootPart") then
                local name = obj.Name:lower()
                if name:find("bot") or name:find("next") or name:find("npc") then
                    local dist = (currentPos - obj.HumanoidRootPart.Position).Magnitude
                    if dist < 55 then
                        botNear = true
                        break
                    end
                end
            end
        end
    end
    
    if botNear then
        local safePos = FindSafePosition()
        if safePos and IsInsideMap(safePos) and safePos.Y > 30 then
            rootPart.CFrame = CFrame.new(safePos)
            ShowNotification("🛡️ NextBot", "Phát hiện bot! Teleport đến vị trí an toàn", 2, Color3.fromRGB(255, 200, 0))
            print("[NextBot] Teleport đến: " .. tostring(safePos))
        end
    end
end

