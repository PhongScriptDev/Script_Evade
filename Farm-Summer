local function GetActiveItems()
    local active = {}
    local hasManual = false
    
    for _, name in ipairs(ItemNameList) do
        local trimmed = name:gsub("^%s+", ""):gsub("%s+$", "")
        if trimmed ~= "" and trimmed:lower() ~= "none" then
            hasManual = true
            break
        end
    end
    
    if hasManual then
        UseAutoDetect = false
        for _, name in ipairs(ItemNameList) do
            local trimmed = name:gsub("^%s+", ""):gsub("%s+$", "")
            if trimmed ~= "" and trimmed:lower() ~= "none" then
                table.insert(active, trimmed)
            end
        end
        EventStatusLabel:Set("📌 Item target: " .. table.concat(active, ", "))
        return active
    end
    
    UseAutoDetect = true
    local detected = AutoDetectEventItems()
    
    if #detected > 0 then
        EventStatusLabel:Set("📌 Item target: 🔍 Auto Detect (" .. #detected .. " items)")
    else
        EventStatusLabel:Set("📌 Item target: ⚠️ No items found!")
    end
    
    return detected
end

local function AutoDetectEventItems()
    local detected = {}
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character then return detected end
    
    local currencyNames = {}
    local stats = LocalPlayer:FindFirstChild("leaderstats")
    if stats then
        for _, child in ipairs(stats:GetChildren()) do
            if child:IsA("NumberValue") or child:IsA("IntValue") then
                local name = child.Name
                local skipNames = {"Level", "Exp", "Experience", "Wins", "Kills", "Deaths", "Points", "Score", "Coin", "Robux"}
                local shouldSkip = false
                for _, skip in ipairs(skipNames) do
                    if name == skip then
                        shouldSkip = true
                        break
                    end
                end
                if not shouldSkip then
                    table.insert(currencyNames, name)
                end
            end
        end
    end
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsDescendantOf(character) then continue end
        
        local clickDetector = obj:FindFirstChild("ClickDetector")
        local proximityPrompt = obj:FindFirstChild("ProximityPrompt")
        
        if clickDetector or proximityPrompt then
            local objName = obj.Name or ""
            local nameLower = objName:lower()
            
            local isCurrency = false
            for _, cName in ipairs(currencyNames) do
                if nameLower:find(cName:lower()) then
                    isCurrency = true
                    break
                end
            end
            
            if not isCurrency then
                if obj:GetAttribute("CurrencyType") or obj:GetAttribute("EventCurrency") or 
                   obj:GetAttribute("Currency") or obj:GetAttribute("Value") then
                    isCurrency = true
                end
            end
            
            if isCurrency then
                table.insert(detected, objName)
            end
        end
    end
    
    return detected
end

local function ScanGameForEvent()
    local found = false
    local name = "Unknown"
    local timeLeft = "Unknown"
    local source = "none"
    
    local LocalPlayer = game.Players.LocalPlayer
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        for _, gui in ipairs(playerGui:GetDescendants()) do
            if gui:IsA("TextLabel") or gui:IsA("TextButton") or gui:IsA("Frame") then
                local text = gui.Text or ""
                local textLower = text:lower()
                
                local eventKeywords = {
                    "sự kiện", "event", "summer", "halloween", "christmas", 
                    "valentine", "easter", "spring", "fall", "winter", "newyear",
                    "festival", "mùa hè", "giáng sinh", "lễ hội",
                    "bubble", "coconut", "candy", "gift", "present", "coin",
                    "token", "collect", "reward", "currency"
                }
                for _, keyword in ipairs(eventKeywords) do
                    if textLower:find(keyword) then
                        found = true
                        name = text
                        source = "menu"
                        break
                    end
                end
                
                if textLower:find("ngày") or textLower:find("còn lại") or textLower:find("remaining") then
                    if text:match("%d+") then
                        timeLeft = text
                    end
                end
                
                if found then break end
            end
        end
    end
    
    if not found then
        for _, obj in ipairs(workspace:GetDescendants()) do
            local nameLower = obj.Name:lower()
            if nameLower:find("event") or nameLower:find("summer") or 
               nameLower:find("halloween") or nameLower:find("christmas") or
               nameLower:find("festival") then
                found = true
                name = obj.Name
                source = "map"
                break
            end
        end
    end
    
    return found, name, timeLeft, source
end

