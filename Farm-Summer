local function IsPlayerDowned(player)
    if not player then return false end
    local char = player.Character
    if not char then return false end
    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid then return false end
    if humanoid.Health <= 0 then
        local downedState = char:FindFirstChild("Downed")
        if downedState then
            return true, "Downed"
        end
        local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
        if torso and humanoid:GetState() == Enum.HumanoidStateType.Physics then
            return true, "Downed"
        end
    end
    return false, nil
end

local function FindDownedPlayer()
    local LocalPlayer = game.Players.LocalPlayer
    local nearestDowned = nil
    local nearestDist = math.huge
    for _, player in ipairs(game.Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local isDowned, status = IsPlayerDowned(player)
            if isDowned then
                local char = player.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local dist = (char.HumanoidRootPart.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
                    if dist < nearestDist then
                        nearestDist = dist
                        nearestDowned = player
                    end
                end
            end
        end
    end
    return nearestDowned
end

local function IsBotNearPositionToken(pos, radius)
    radius = radius or 50
    local LocalPlayer = game.Players.LocalPlayer
    for _, player in ipairs(game.Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local enemy = player.Character
            if enemy and enemy:FindFirstChild("HumanoidRootPart") then
                if (pos - enemy.HumanoidRootPart.Position).Magnitude < radius then
                    return true
                end
            end
        end
    end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("HumanoidRootPart") then
            local name = obj.Name:lower()
            if name:find("bot") or name:find("next") or name:find("npc") then
                if (pos - obj.HumanoidRootPart.Position).Magnitude < radius then
                    return true
                end
            end
        end
    end
    return false
end

local function FindSafePositionToken()
    UpdateMapBounds()
    for attempt = 1, 30 do
        local testPos = Vector3.new(
            math.random(MapBounds.MinX + 50, MapBounds.MaxX - 50),
            math.random(80, MapBounds.MaxY - 20),
            math.random(MapBounds.MinZ + 50, MapBounds.MaxZ - 50)
        )
        if IsInsideMap(testPos) and not IsBotNearPositionToken(testPos, 50) then
            return testPos
        end
    end
    return Vector3.new(0, 100, 0)
end

local function CarryPlayer(player)
    if not player then return false end
    local LocalPlayer = game.Players.LocalPlayer
    local char = LocalPlayer.Character
    if not char then return false end
    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid then return false end
    local targetChar = player.Character
    if targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then
            root.CFrame = targetChar.HumanoidRootPart.CFrame + Vector3.new(0, 2, 0)
        end
    end
    pcall(function()
        humanoid:Carry(player)
        CarriedPlayer = player
        IsCarrying = true
        ShowNotification("🤝 Đang carry!", "Đang carry " .. player.Name, 2, Color3.fromRGB(255, 200, 0))
        return true
    end)
    return false
end

local function ResurrectPlayer(player)
    if not player then return false end
    local targetChar = player.Character
    if not targetChar then return false end
    local humanoid = targetChar:FindFirstChild("Humanoid")
    if not humanoid then return false end
    pcall(function()
        humanoid.Health = 100
        local downed = targetChar:FindFirstChild("Downed")
        if downed then downed:Destroy() end
        ShowNotification("❤️ Đã cứu!", "Đã hồi sinh " .. player.Name, 3, Color3.fromRGB(0, 255, 0))
        return true
    end)
    return false
end

local function FarmTokenLoop()
    if not FarmToken then return end
    if tick() - FarmTokenCooldown < 1 then return end
    local LocalPlayer = game.Players.LocalPlayer
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    local gameState = workspace:FindFirstChild("GameState")
    if gameState then
        local stateText = tostring(gameState.Value or "")
        if stateText:lower():find("voting") or stateText:lower():find("bình chọn") then
            IsVoting = true
            if (root.Position - LastPosition).Magnitude > 10 then
                root.CFrame = CFrame.new(LastPosition)
            end
            FarmTokenCooldown = tick()
            return
        elseif stateText:lower():find("paused") or stateText:lower():find("tạm dừng") then
            IsPaused = true
            if not IsAtWall then
                TeleportToWall()
            end
            FarmTokenCooldown = tick()
            return
        else
            IsVoting = false
            IsPaused = false
        end
    end
    
    local downedPlayer = FindDownedPlayer()
    if downedPlayer then
        local targetChar = downedPlayer.Character
        if targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
            local targetPos = targetChar.HumanoidRootPart.Position
            root.CFrame = CFrame.new(targetPos + Vector3.new(0, 2, 0))
            wait(0.2)
            CarryPlayer(downedPlayer)
            wait(0.3)
            local safePos = FindSafePositionToken()
            if safePos and IsInsideMap(safePos) and safePos.Y > 30 then
                root.CFrame = CFrame.new(safePos)
            end
            wait(0.2)
            pcall(function()
                local humanoid = char:FindFirstChild("Humanoid")
                if humanoid then
                    humanoid:DropCarry()
                    IsCarrying = false
                    CarriedPlayer = nil
                end
            end)
            ResurrectPlayer(downedPlayer)
            FarmTokenCooldown = tick()
            return
        end
    else
        if not IsAtWall then
            TeleportToWall()
        end
        FarmTokenCooldown = tick()
    end
end

