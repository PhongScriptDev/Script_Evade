local function GetCurrentCurrency()
    local LocalPlayer = game.Players.LocalPlayer
    local stats = LocalPlayer:FindFirstChild("leaderstats")
    if stats then
        local activeItems = GetActiveItems()
        for _, itemName in ipairs(activeItems) do
            local stat = stats:FindFirstChild(itemName)
            if stat then
                return stat.Value or 0
            end
        end
    end
    return 0
end

local function FindEventItems()
    local items = {}
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character then return items end
    local rootPos = character:FindFirstChild("HumanoidRootPart")
    if not rootPos then return items end
    
    local activeItems = GetActiveItems()
    if #activeItems == 0 then
        return items
    end
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsDescendantOf(character) then continue end
        
        local objName = obj.Name or ""
        local isMatch = false
        
        for _, itemName in ipairs(activeItems) do
            if objName:lower():find(itemName:lower()) then
                isMatch = true
                break
            end
        end
        
        if isMatch then
            local position = nil
            
            if obj:IsA("BasePart") then
                position = obj.Position
            elseif obj:IsA("Model") then
                if obj:FindFirstChild("PrimaryPart") then
                    position = obj.PrimaryPart.Position
                elseif obj:FindFirstChild("HumanoidRootPart") then
                    position = obj.HumanoidRootPart.Position
                elseif obj:FindFirstChild("Head") then
                    position = obj.Head.Position
                else
                    local sumPos = Vector3.new(0, 0, 0)
                    local count = 0
                    for _, part in ipairs(obj:GetChildren()) do
                        if part:IsA("BasePart") then
                            sumPos = sumPos + part.Position
                            count = count + 1
                        end
                    end
                    if count > 0 then position = sumPos / count end
                end
            end
            
            if position then
                table.insert(items, {
                    object = obj,
                    position = position,
                    distance = (rootPos.Position - position).Magnitude,
                    clickDetector = obj:FindFirstChild("ClickDetector"),
                    proximityPrompt = obj:FindFirstChild("ProximityPrompt"),
                    name = objName
                })
            end
        end
    end
    
    table.sort(items, function(a, b)
        return a.distance < b.distance
    end)
    
    return items
end

local function TeleportToWall()
    if not SafeWall then 
        CreateSafeWall(FindSafeWallPosition())
        wait(0.1)
    end
    
    if not SafeWall then return false end
    
    local char = game.Players.LocalPlayer.Character
    if not char then return false end
    
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    
    root.CFrame = CFrame.new(SafeWall.Position + Vector3.new(0, 2, 0))
    IsAtWall = true
    
    local humanoid = char:FindFirstChild("Humanoid")
    if humanoid then
        humanoid.PlatformStand = false
        humanoid.Sit = false
    end
    
    return true
end

local function CheckAndKeepOnWall()
    if not AutoFarm and not FarmLV and not AutoRescue then return end
    if not SafeWall then return end
    
    local char = game.Players.LocalPlayer.Character
    if not char then return end
    
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    if root.Position.Y < WallPosition.Y - 5 then
