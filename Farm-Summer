-- Lọc danh sách (bỏ qua "none")
local function GetActiveItems()
    local active = {}
    for _, name in ipairs(ItemNameList) do
        local trimmed = name:gsub("^%s+", ""):gsub("%s+$", "")
        if trimmed ~= "" and trimmed:lower() ~= "none" then
            table.insert(active, trimmed)
        end
    end
    return active
end

-- =============================================
-- HÀM GỬI THÔNG BÁO
-- =============================================
local function SendNotification(title, content, duration)
    duration = duration or 3
    if tick() - LastNotifyTime < 0.5 then return end
    LastNotifyTime = tick()
    pcall(function()
        Rayfield:Notify({
            Title = title,
            Content = content,
            Duration = duration,
            Image = 0
        })
    end)
end

-- =============================================
-- HÀM TÌM VẬT PHẨM
-- =============================================
local function FindEventItems()
    local items = {}
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character then return items end
    local rootPos = character:FindFirstChild("HumanoidRootPart")
    if not rootPos then return items end
    
    local activeItems = GetActiveItems()
    if #activeItems == 0 then
        return items
    end
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsDescendantOf(character) then continue end
        
        local objName = obj.Name or ""
        local isMatch = false
        
        for _, itemName in ipairs(activeItems) do
            if objName:lower():find(itemName:lower()) then
                isMatch = true
                break
            end
        end
        
        if isMatch then
            local position = nil
            
            if obj:IsA("BasePart") then
                position = obj.Position
            elseif obj:IsA("Model") then
                if obj:FindFirstChild("PrimaryPart") then
                    position = obj.PrimaryPart.Position
                elseif obj:FindFirstChild("HumanoidRootPart") then
                    position = obj.HumanoidRootPart.Position
                elseif obj:FindFirstChild("Head") then
                    position = obj.Head.Position
                else
                    local sumPos = Vector3.new(0, 0, 0)
                    local count = 0
                    for _, part in ipairs(obj:GetChildren()) do
                        if part:IsA("BasePart") then
                            sumPos = sumPos + part.Position
                            count = count + 1
                        end
                    end
                    if count > 0 then position = sumPos / count end
                end
            end
            
            if position then
                local clickDetector = obj:FindFirstChild("ClickDetector")
                local proximityPrompt = obj:FindFirstChild("ProximityPrompt")
                
                table.insert(items, {
                    object = obj,
                    position = position,
                    distance = (rootPos.Position - position).Magnitude,
                    clickDetector = clickDetector,
                    proximityPrompt = proximityPrompt,
                    name = objName
                })
            end
        end
    end
    
    table.sort(items, function(a, b)
        return a.distance < b.distance
    end)
    
    return items
end

-- =============================================
-- TƯỜNG AN TOÀN (FIX LỖI TELEPORT)
-- =============================================
local function FindSafeWallPosition()
    local mapCenter = Vector3.new(0, 0, 0)
    local foundPart = false
    
    -- Tìm center của map
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Part") and obj.Size.Magnitude > 50 then
            mapCenter = obj.Position
            foundPart = true
            break
        end
    end
    
    if not foundPart then
        -- Nếu không tìm thấy, dùng vị trí người chơi
        local char = game.Players.LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            mapCenter = char.HumanoidRootPart.Position
        end
    end
    
    -- Tạo vị trí tường: cao hơn map, xa map một chút
    local safePos = Vector3.new(
        mapCenter.X + math.random(-200, 200),
        math.random(150, 300),
        mapCenter.Z + math.random(-200, 200)
    )
    
    return safePos
end

local function CreateSafeWall(position)
    if SafeWall then SafeWall:Destroy() end
    
    -- Tạo tường lớn hơn để dễ đứng
    SafeWall = Instance.new("Part")
    SafeWall.Name = "SafeWall_Private"
    SafeWall.Size = Vector3.new(60, 2, 60)
    SafeWall.CFrame = CFrame.new(position)
    SafeWall.Anchored = true
    SafeWall.CanCollide = true
    SafeWall.Transparency = 0.15
    SafeWall.Material = Enum.Material.Glass
    SafeWall.Locked = true
    SafeWall.Color = Color3.fromRGB(0, 200, 255)
    SafeWall.Parent = workspace
    WallPosition = position
    
    print("[Farm] Đã tạo tường tại:", position)
end

local function TeleportToWall()
    if not SafeWall then 
        print("[Farm] Chưa có tường, đang tạo...")
        CreateSafeWall(FindSafeWallPosition())
        wait(0.3)
    end
    
    if not SafeWall then return false end
    
    local char = game.Players.LocalPlayer.Character
    if not char then return false end
    
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    
    -- Teleport lên tường (ở giữa tường)
    local wallPos = SafeWall.Position + Vector3.new(0, 1.5, 0)
    root.CFrame = CFrame.new(wallPos)
    IsAtWall = true
    
    -- Đảm bảo nhân vật đứng vững
    local humanoid = char:FindFirstChild("Humanoid")
    if humanoid then
        humanoid.PlatformStand = false
        humanoid.Sit = false
    end
    
    print("[Farm] Đã teleport lên tường tại:", wallPos)
    return true
end

-- =============================================
-- HÀM KIỂM TRA VÀ GIỮ NHÂN VẬT TRÊN TƯỜNG
-- =============================================
local function CheckAndKeepOnWall()
    if not AutoFarm and not FarmLV then return end
    if not SafeWall then return end
    
    local char = game.Players.LocalPlayer.Character
    if not char then return end
    
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    local currentPos = root.Position
    local wallPos = SafeWall.Position
    
    -- Nếu nhân vật rơi xuống dưới tường quá xa -> teleport lại lên tường
    if currentPos.Y < wallPos.Y - 5 then
        print("[Farm] Nhân vật rơi khỏi tường, đang teleport lại...")
        TeleportToWall()
        SendNotification("📍 Đã teleport lại!", "Tự động quay lại tường an toàn.", 2)
    end
end

local function TeleportToItem(targetPos)
    local char = game.Players.LocalPlayer.Character
    if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    root.CFrame = CFrame.new(targetPos)
    IsAtWall = false
    return true
end

-- =============================================
-- HÀM NHẶT VẬT PHẨM
-- =============================================
local function CollectItem(item)
    if not item then return false end
    
    local success = false
    
    if item.clickDetector then
        pcall(function()
            item.clickDetector:FireClick()
            success = true
        end)
    end
    
    if not success and item.proximityPrompt then
        pcall(function()
            item.proximityPrompt:Fire()
            success = true
        end)
    end
    
    if not success then
        local char = game.Players.LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local root = char.HumanoidRootPart
            root.CFrame = CFrame.new(item.position + Vector3.new(0, 0.5, 0))
            wait(0.1)
            
            if item.clickDetector then
                pcall(function()
                    item.clickDetector:FireClick()
                    success = true
                end)
            end
            if not success and item.proximityPrompt then
                pcall(function()
                    item.proximityPrompt:Fire()
                    success = true
                end)
            end
        end
    end
    
    if success then
        CollectedCount = CollectedCount + 1
        RetryCount = 0
        SendNotification("✔️ Nhận Thành Công!", "🔎 Đã nhận: " .. item.name .. " (#" .. CollectedCount .. ")", 3)
        SendNotification("📦 Tổng vật phẩm!", "🔎 Tổng cộng: " .. CollectedCount .. " vật phẩm", 3)
        return true
    end
    
    return false
end

-- =============================================
local function RetryCollectItem(item)
    if not item then return false end
    
    RetryCount = RetryCount + 1
    print("[Farm] Thử nhặt lần " .. RetryCount .. "/" .. MaxRetries)
    
    local char = game.Players.LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.CFrame = CFrame.new(item.position + Vector3.new(0, 1, 0))
    end
    
    wait(0.2)
    
    local success = false
    if item.clickDetector then
        pcall(function()
            item.clickDetector:FireClick()
            success = true
        end)
    end
    if not success and item.proximityPrompt then
        pcall(function()
            item.proximityPrompt:Fire()
            success = true
        end)
    end
    
    if success then
        CollectedCount = CollectedCount + 1
        RetryCount = 0
        SendNotification("✔️ Nhận Thành Công!", "🔎 Đã nhận: " .. item.name .. " (#" .. CollectedCount .. ")", 3)
        SendNotification("📦 Tổng vật phẩm!", "🔎 Tổng cộng: " .. CollectedCount .. " vật phẩm", 3)
        return true
    end
    
    if RetryCount >= MaxRetries then
        print("[Farm] Đã thử " .. MaxRetries .. " lần, bỏ qua!")
        RetryCount = 0
        return false
    end
    
    return false
end

-- =============================================
-- FARM LOOP
-- =============================================
local function FarmLoop()
    if not AutoFarm then return end
    
    if tick() - FarmCooldown < 0.5 then return end
    
    local LocalPlayer = game.Players.LocalPlayer
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    if char:GetAttribute("Downed") then
        FarmCooldown = tick()
        return
    end
    
    -- Kiểm tra giữ trên tường
    CheckAndKeepOnWall()
    
    local items = FindEventItems()
    TotalItems = #items
    CurrencyLabel:Set("🎯 Event Items: " .. TotalItems)
    
    if TotalItems == 0 then
        if not IsAtWall then
            TeleportToWall()
        end
        FarmCooldown = tick()
        return
    end
    
    local currentPos = root.Position
    local nearestItem = items[1]
    
    if not nearestItem then
        FarmCooldown = tick()
        return
    end
    
    local distToItem = (currentPos - nearestItem.position).Magnitude
    
    if IsAtWall then
        SendNotification("❗ Đã thấy vật phẩm", "📌 Đang tiến hành đến vật phẩm...", 2)
        TeleportToItem(nearestItem.position)
        FarmCooldown = tick()
        return
    end
    
    if distToItem < 20 then
        local collected = CollectItem(nearestItem)
        if not collected then
            print("[Farm] Nhặt thất bại, đang thử lại...")
            RetryCollectItem(nearestItem)
        end
        
        TeleportToWall()
        SendNotification("📍 Về tường", "🔄 Đã teleport về tường!", 2)
        FarmCooldown = tick()
        return
    end
    
    TeleportToItem(nearestItem.position)
    FarmCooldown = tick()
end

-- =============================================
-- FARM LV LOOP (CÓ THỂ DI CHUYỂN TRÊN TƯỜNG)
-- =============================================
local function FarmLVLoop()
    if not FarmLV then return end
    
    -- Kiểm tra và giữ trên tường
    CheckAndKeepOnWall()
    
    if not SafeWall then
        CreateSafeWall(FindSafeWallPosition())
        wait(0.3)
        TeleportToWall()
    end
    
    -- Chỉ teleport lên tường nếu không ở trên tường
    local char = game.Players.LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local root = char.HumanoidRootPart
        if root.Position.Y < WallPosition.Y - 5 then
            TeleportToWall()
        end
    end
end

