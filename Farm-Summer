local function ForceRespawn()
    local LocalPlayer = game.Players.LocalPlayer
    
    print("[Chống Gục] 🚨 PHÁT HIỆN BỊ HẠ GỤC! Đang respawn...")
    
    if not HasShownDied then
        HasShownDied = true
        HasShownRevived = false
        ShowNotification("💀 BỊ HẠ GỤC!", "Đang tự động respawn...", 3, Color3.fromRGB(255, 0, 0))
    end
    
    pcall(function()
        LocalPlayer:LoadCharacter()
        print("[Chống Gục] ✅ Đã respawn!")
    end)
    
    wait(0.5)
    
    local character = LocalPlayer.Character
    if character then
        local root = character:FindFirstChild("HumanoidRootPart")
        if root then
            local pos = Vector3.new(
                math.random(-150, 150),
                math.random(100, 180),
                math.random(-150, 150)
            )
            root.CFrame = CFrame.new(pos)
        end
        
        local humanoid = character:FindFirstChild("Humanoid")
        if humanoid then
            humanoid.Health = 100
        end
    end
    
    if not HasShownRevived then
        HasShownRevived = true
        HasShownDied = false
        ShowNotification("🔄 ĐÃ RESPAWN", "Đã tự động respawn thành công!", 3, Color3.fromRGB(0, 255, 0))
    end
end

local function DetectDeathMessage()
    for _, gui in ipairs(game:GetService("CoreGui"):GetChildren()) do
        local function searchForDeathMessage(obj)
            if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                local text = obj.Text or ""
                if text:lower():find("hạ gục") or 
                   text:lower():find("bị hạ") or 
                   text:lower():find("knock") or
                   text:lower():find("down") or
                   text:lower():find("eliminated") or
                   text:lower():find("bị loại") then
                    print("[Chống Gục] 🔍 Phát hiện thông báo hạ gục: " .. text)
                    return true
                end
            end
            
            for _, child in ipairs(obj:GetChildren()) do
                if searchForDeathMessage(child) then
                    return true
                end
            end
            return false
        end
        
        if searchForDeathMessage(gui) then
            ForceRespawn()
            return true
        end
    end
    return false
end

local function CheckDeath()
    if not AntiDied then return end
    
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    
    if not character then
        print("[Chống Gục] ⚠️ Không có nhân vật! Đang respawn...")
        LocalPlayer:LoadCharacter()
        return
    end
    
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid then return end
    
    if humanoid.Health <= 0 then
        ForceRespawn()
        return
    end
    
    if humanoid:GetState() == Enum.HumanoidStateType.Dead then
        ForceRespawn()
        return
    end
    
    for _, child in ipairs(character:GetChildren()) do
        if child.Name:lower():find("downed") or child.Name:lower():find("dead") then
            ForceRespawn()
            return
        end
    end
end

