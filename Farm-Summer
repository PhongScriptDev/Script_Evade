local WallPosition = nil
local LastNotifyTime = 0

-- Lọc danh sách (bỏ qua "none")
local function GetActiveItems()
    local active = {}
    for _, name in ipairs(ItemNameList) do
        local trimmed = name:gsub("^%s+", ""):gsub("%s+$", "")
        if trimmed ~= "" and trimmed:lower() ~= "none" then
            table.insert(active, trimmed)
        end
    end
    return active
end

-- =============================================
-- HÀM GỬI THÔNG BÁO
-- =============================================
local function SendNotification(title, content, duration)
    duration = duration or 3
    if tick() - LastNotifyTime < 0.5 then return end
    LastNotifyTime = tick()
    pcall(function()
        Rayfield:Notify({
            Title = title,
            Content = content,
            Duration = duration,
            Image = 0
        })
    end)
end

-- =============================================
-- HÀM TÌM VẬT PHẨM
-- =============================================
local function FindEventItems()
    local items = {}
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character then return items end
    local rootPos = character:FindFirstChild("HumanoidRootPart")
    if not rootPos then return items end
    
    local activeItems = GetActiveItems()
    if #activeItems == 0 then
        return items
    end
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsDescendantOf(character) then continue end
        
        local objName = obj.Name or ""
        local isMatch = false
        
        for _, itemName in ipairs(activeItems) do
            if objName:lower():find(itemName:lower()) then
                isMatch = true
                break
            end
        end
        
        if isMatch then
            local position = nil
            
            if obj:IsA("BasePart") then
                position = obj.Position
            elseif obj:IsA("Model") then
                if obj:FindFirstChild("PrimaryPart") then
                    position = obj.PrimaryPart.Position
                elseif obj:FindFirstChild("HumanoidRootPart") then
                    position = obj.HumanoidRootPart.Position
                elseif obj:FindFirstChild("Head") then
                    position = obj.Head.Position
                else
                    local sumPos = Vector3.new(0, 0, 0)
                    local count = 0
                    for _, part in ipairs(obj:GetChildren()) do
                        if part:IsA("BasePart") then
                            sumPos = sumPos + part.Position
                            count = count + 1
                        end
                    end
                    if count > 0 then position = sumPos / count end
                end
            end
            
            if position then
                local clickDetector = obj:FindFirstChild("ClickDetector")
                local proximityPrompt = obj:FindFirstChild("ProximityPrompt")
                
                table.insert(items, {
                    object = obj,
                    position = position,
                    distance = (rootPos.Position - position).Magnitude,
                    clickDetector = clickDetector,
                    proximityPrompt = proximityPrompt,
                    name = objName
                })
            end
        end
    end
    
    table.sort(items, function(a, b)
        return a.distance < b.distance
    end)
    
    return items
end

-- =============================================
-- TƯỜNG AN TOÀN
-- =============================================
local function FindSafeWallPosition()
    local mapCenter = Vector3.new(0, 0, 0)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Part") and obj.Size.Magnitude > 100 then
            mapCenter = obj.Position
            break
        end
    end
    return Vector3.new(mapCenter.X - 400, math.random(250, 400), mapCenter.Z + math.random(-100, 100))
end

local function CreateSafeWall(position)
    if SafeWall then SafeWall:Destroy() end
    SafeWall = Instance.new("Part")
    SafeWall.Name = "SafeWall_Private"
    SafeWall.Size = Vector3.new(50, 2, 50)
    SafeWall.CFrame = CFrame.new(position)
    SafeWall.Anchored = true
    SafeWall.CanCollide = true
    SafeWall.Transparency = 0.2
    SafeWall.Material = Enum.Material.Glass
    SafeWall.Locked = true
    SafeWall.Color = Color3.fromRGB(0, 200, 255)
    SafeWall.Parent = workspace
    WallPosition = position
    print("[Farm] Đã tạo tường tại:", position)
end

local function TeleportToWall()
    if not SafeWall then 
        print("[Farm] Lỗi: Không có tường!")
        return false 
    end
    local char = game.Players.LocalPlayer.Character
    if not char then 
        print("[Farm] Lỗi: Không có nhân vật!")
        return false 
    end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then 
        print("[Farm] Lỗi: Không có RootPart!")
        return false 
    end
    root.CFrame = CFrame.new(SafeWall.Position + Vector3.new(0, 1, 0))
    IsAtWall = true
    print("[Farm] Đã teleport lên tường!")
    return true
end

local function TeleportToItem(targetPos)
    local char = game.Players.LocalPlayer.Character
    if not char then 
        print("[Farm] Lỗi: Không có nhân vật!")
        return false 
    end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then 
        print("[Farm] Lỗi: Không có RootPart!")
        return false 
    end
    root.CFrame = CFrame.new(targetPos)
    IsAtWall = false
    print("[Farm] Đã teleport đến vật phẩm tại:", targetPos)
    return true
end

local function CollectItem(item)
    if not item then 
        print("[Farm] Lỗi: Không có vật phẩm để nhặt!")
        return false 
    end
    
    local success = false
    pcall(function()
        if item.clickDetector then
            item.clickDetector:FireClick()
            success = true
            print("[Farm] Đã nhặt qua ClickDetector!")
        end
        if item.proximityPrompt then
            item.proximityPrompt:Fire()
            success = true
            print("[Farm] Đã nhặt qua ProximityPrompt!")
        end
    end)
    
    if success then
        CollectedCount = CollectedCount + 1
        SendNotification("✔️ Nhận Thành Công!", "🔎 Giá trị vật phẩm: 1", 3)
        SendNotification("🔔 Thông báo đã làm!", "🔎 Số lần làm xong: " .. CollectedCount, 3)
        return true
    end
    return false
end

-- =============================================
-- FARM LOOP
-- =============================================
local function FarmLoop()
    if not AutoFarm then 
        print("[Farm] AutoFarm đang tắt!")
        return 
    end
    
    if tick() - FarmCooldown < 0.5 then 
        return 
    end
    
    local LocalPlayer = game.Players.LocalPlayer
    local char = LocalPlayer.Character
    if not char then 
        print("[Farm] Lỗi: Không có nhân vật!")
        return 
    end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then 
        print("[Farm] Lỗi: Không có RootPart!")
        return 
    end
    
    if char:GetAttribute("Downed") then
        print("[Farm] Đang bị gục!")
        FarmCooldown = tick()
        return
    end
    
    -- Quét tìm vật phẩm
    print("[Farm] Đang quét tìm vật phẩm...")
    local items = FindEventItems()
    TotalItems = #items
    CurrencyLabel:Set("🎯 Event Items: " .. TotalItems)
    
    if TotalItems == 0 then
        print("[Farm] Không tìm thấy vật phẩm!")
        if not IsAtWall then
            TeleportToWall()
        end
        FarmCooldown = tick()
        return
    end
    
    local currentPos = root.Position
    local nearestItem = items[1]
    
    if not nearestItem then
        print("[Farm] Lỗi: Không có vật phẩm gần nhất!")
        FarmCooldown = tick()
        return
    end
    
    local distToItem = (currentPos - nearestItem.position).Magnitude
    print("[Farm] Vật phẩm gần nhất cách:", distToItem, "studs")
    
    if IsAtWall then
        print("[Farm] Đang ở tường, teleport đến vật phẩm...")
        SendNotification("❗ Đã thấy vật phẩm", "📌 Đang tiến hành đến vật phẩm...", 2)
        TeleportToItem(nearestItem.position)
        FarmCooldown = tick()
        return
    end
    
    if distToItem < 15 then
        print("[Farm] Đã đến gần vật phẩm, đang nhặt...")
        local collected = CollectItem(nearestItem)
        if collected then
            TeleportToWall()
            SendNotification("📍 Về tường", "🔄 Đã teleport về tường thành công!", 2)
        else
            print("[Farm] Nhặt thất bại, thử lại...")
            TeleportToItem(nearestItem.position)
            wait(0.2)
            CollectItem(nearestItem)
            TeleportToWall()
        end
        FarmCooldown = tick()
        return
    end
    
    print("[Farm] Teleport đến vật phẩm...")
    TeleportToItem(nearestItem.position)
    FarmCooldown = tick()
end

