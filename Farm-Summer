local AutoFarm = false
local FarmConnection = nil
local FarmCooldown = 0
local CurrentIndex = 1
local AllBubbles = {}
local IsFarming = false
local LastBubblePos = nil

-- QUÉT TOÀN BỘ MAP
local function ScanAllBubbles()
    AllBubbles = {}
    local LocalPlayer = game.Players.LocalPlayer
    
    print("[AutoFarm] 🔍 Đang quét toàn bộ map...")
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        local name = obj.Name or ""
        if name:lower():find("bubble") then
            local position = nil
            
            if obj:IsA("BasePart") then
                position = obj.Position
            elseif obj:IsA("Model") then
                if obj:FindFirstChild("PrimaryPart") then
                    position = obj.PrimaryPart.Position
                elseif obj:FindFirstChild("HumanoidRootPart") then
                    position = obj.HumanoidRootPart.Position
                elseif obj:FindFirstChild("Head") then
                    position = obj.Head.Position
                else
                    local sumPos = Vector3.new(0, 0, 0)
                    local count = 0
                    for _, part in ipairs(obj:GetChildren()) do
                        if part:IsA("BasePart") then
                            sumPos = sumPos + part.Position
                            count = count + 1
                        end
                    end
                    if count > 0 then
                        position = sumPos / count
                    end
                end
            end
            
            if position then
                table.insert(AllBubbles, {
                    object = obj,
                    position = position,
                    name = obj.Name,
                    collected = false
                })
            end
        end
    end
    
    TotalBubbles = #AllBubbles
    print("[AutoFarm] ✅ Tìm thấy " .. TotalBubbles .. " Bubble")
    BubbleLabel:Set("🎈 Bubble trong map: " .. TotalBubbles)
    return AllBubbles
end

-- KIỂM TRA BOT GẦN BUBBLE
local function IsBotNearPosition(pos, radius)
    radius = radius or 60
    local LocalPlayer = game.Players.LocalPlayer
    
    for _, player in ipairs(game.Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local enemy = player.Character
            if enemy and enemy:FindFirstChild("HumanoidRootPart") then
                local dist = (pos - enemy.HumanoidRootPart.Position).Magnitude
                if dist < radius then
                    return true
                end
            end
        end
    end
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("HumanoidRootPart") then
            local name = obj.Name:lower()
            if name:find("bot") or name:find("next") or name:find("npc") then
                local dist = (pos - obj.HumanoidRootPart.Position).Magnitude
                if dist < radius then
                    return true
                end
            end
        end
    end
    
    return false
end

-- TELEPORT ĐẾN BUBBLE
local function TeleportToBubble(targetPos)
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character then return false end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end
    
    rootPart.CFrame = CFrame.new(targetPos)
    LastBubblePos = targetPos
    return true
end

-- NHẶT BUBBLE
local function CollectBubble(item)
    if not item or not item.object then return false end
    if item.collected then return false end
    
    local success = false
    
    local clickDetector = item.object:FindFirstChild("ClickDetector")
    if clickDetector then
        pcall(function()
            clickDetector:FireClick()
            success = true
        end)
    end
    
    local proximityPrompt = item.object:FindFirstChild("ProximityPrompt")
    if proximityPrompt then
        pcall(function()
            proximityPrompt:Fire()
            success = true
        end)
    end
    
    if not success then
        success = true
    end
    
    if success then
        item.collected = true
        CollectedCount = CollectedCount + 1
        print("[AutoFarm] ✅ Đã nhặt Bubble #" .. CollectedCount)
        TotalLabel:Set("🎯 Đã nhặt: " .. CollectedCount .. " Bubble")
        return true
    end
    
    return false
end

-- FARM LOOP
local function FarmLoop()
    if not AutoFarm then return end
    
    -- Chống spam
    if tick() - FarmCooldown < 0.5 then
        return
    end
    
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character then return end
    
    -- Quét lại nếu hết Bubble
    if #AllBubbles == 0 or CurrentIndex > #AllBubbles then
        ScanAllBubbles()
        CurrentIndex = 1
        if #AllBubbles == 0 then
            FarmCooldown = tick()
            return
        end
    end
    
    -- Tìm Bubble chưa nhặt
    local target = nil
    for i = CurrentIndex, #AllBubbles do
        if not AllBubbles[i].collected then
            target = AllBubbles[i]
            CurrentIndex = i
            break
        end
    end
    
    if not target then
        -- Đã nhặt hết -> quét lại
        CurrentIndex = #AllBubbles + 1
        FarmCooldown = tick()
        return
    end
    
    -- Kiểm tra bot gần Bubble
    if IsBotNearPosition(target.position, 60) then
        print("[AutoFarm] ⚠️ Bot gần Bubble, đợi...")
        FarmCooldown = tick()
        return
    end
    
    -- TELEPORT ĐẾN BUBBLE (KHÔNG DELAY)
    TeleportToBubble(target.position)
    print("[AutoFarm] 🚀 Teleport đến Bubble #" .. CurrentIndex)
    
    wait(0.1)
    
    -- Nhặt Bubble
    CollectBubble(target)
    
    -- Chuyển tiếp
    CurrentIndex = CurrentIndex + 1
    FarmCooldown = tick()
end

