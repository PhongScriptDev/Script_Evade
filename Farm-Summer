-- Kiểm tra vòng đặc biệt
local function CheckSpecialRound()
    local gameState = workspace:FindFirstChild("GameState")
    if gameState then
        local stateText = tostring(gameState.Value or "")
        if stateText:lower():find("special") or stateText:lower():find("boss") then
            IsSpecialRound = true
        else
            IsSpecialRound = false
        end
    end
end

-- Tìm vị trí an toàn TRONG MAP (không ra ngoài, không dưới đất)
local function FindSafePosition()
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character then return nil end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil end
    
    local currentPos = rootPart.Position
    
    -- Thử tìm vị trí an toàn
    for attempt = 1, 30 do
        local testPos = Vector3.new(
            math.random(-180, 180),
            math.random(60, 180),
            math.random(-180, 180)
        )
        
        -- Kiểm tra có bot nào ở gần không
        local isSafe = true
        for _, player in ipairs(game.Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local enemy = player.Character
                if enemy and enemy:FindFirstChild("HumanoidRootPart") then
                    local dist = (testPos - enemy.HumanoidRootPart.Position).Magnitude
                    if dist < 50 then
                        isSafe = false
                        break
                    end
                end
            end
        end
        
        -- Kiểm tra NextBot NPC
        if isSafe then
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("Model") and obj:FindFirstChild("HumanoidRootPart") then
                    local name = obj.Name:lower()
                    if name:find("bot") or name:find("next") or name:find("npc") then
                        local dist = (testPos - obj.HumanoidRootPart.Position).Magnitude
                        if dist < 50 then
                            isSafe = false
                            break
                        end
                    end
                end
            end
        end
        
        if isSafe then
            return testPos
        end
    end
    
    -- Fallback: vị trí cố định an toàn
    return Vector3.new(0, 120, 0)
end

-- Kiểm tra NextBot
local function CheckNextBot()
    if not AntiNextBot then return end
    
    if tick() - NextBotCheckCooldown < 0.3 then
        return
    end
    NextBotCheckCooldown = tick()
    
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character then return end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    local currentPos = rootPart.Position
    
    -- Kiểm tra vòng đặc biệt
    CheckSpecialRound()
    
    -- Kiểm tra bot gần
    local botNear = false
    local nearestDist = math.huge
    local botApproaching = false
    
    for _, player in ipairs(game.Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local enemy = player.Character
            if enemy and enemy:FindFirstChild("HumanoidRootPart") then
                local enemyPos = enemy.HumanoidRootPart.Position
                local dist = (currentPos - enemyPos).Magnitude
                if dist < nearestDist then
                    nearestDist = dist
                end
                
                -- Bot đang tiến đến?
                if dist < 70 then
                    botNear = true
                end
                
                -- Kiểm tra hướng di chuyển (nếu có)
                local humanoid = enemy:FindFirstChild("Humanoid")
                if humanoid and humanoid.MoveDirection.Magnitude > 5 then
                    local dirToBot = (enemyPos - currentPos).Unit
                    local botDir = humanoid.MoveDirection.Unit
                    local dot = dirToBot:Dot(botDir)
                    if dot > 0.5 and dist < 100 then
                        botApproaching = true
                    end
                end
            end
        end
    end
    
    -- Kiểm tra NextBot NPC
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("HumanoidRootPart") then
            local name = obj.Name:lower()
            if name:find("bot") or name:find("next") or name:find("npc") then
                local enemyPos = obj.HumanoidRootPart.Position
                local dist = (currentPos - enemyPos).Magnitude
                if dist < nearestDist then
                    nearestDist = dist
                end
                if dist < 70 then
                    botNear = true
                end
            end
        end
    end
    
    -- Nếu bot gần hoặc đang tiến đến -> teleport
    if botNear or botApproaching then
        local safePos = FindSafePosition()
        if safePos then
            rootPart.CFrame = CFrame.new(safePos)
            print("[NextBot] Đã teleport đến vị trí an toàn: " .. tostring(safePos))
        end
        return
    end
    
    -- Teleport định kỳ (nếu cần)
    local interval = IsSpecialRound and 2.5 or 4
    if not character:FindFirstChild("LastTeleportTime") then
        local t = Instance.new("NumberValue")
        t.Name = "LastTeleportTime"
        t.Value = tick()
        t.Parent = character
    else
        if tick() - character.LastTeleportTime.Value > interval then
            local safePos = FindSafePosition()
            if safePos then
                rootPart.CFrame = CFrame.new(safePos)
                character.LastTeleportTime.Value = tick()
            end
        end
    end
end

