local function UpdateServerInfo()
    pcall(function()
        local LocalPlayer = game.Players.LocalPlayer
        local players = game.Players:GetPlayers()
        local playerCount = #players
        local maxPlayers = game.Players.MaxPlayers
        
        PlayerCountLabel:Set("👤 Players in server: " .. playerCount)
        MaxPlayersLabel:Set("📊 Max players: " .. maxPlayers)
        
        local serverId = game.JobId or "Unknown"
        ServerIDLabel:Set("🆔 Server ID: " .. serverId)
        
        local currentTime = os.date("%H:%M:%S")
        local currentDate = os.date("%d/%m/%Y")
        
        local mapName = "Unknown"
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and obj.Name:lower():find("map") then
                mapName = obj.Name
                break
            end
        end
        if mapName == "Unknown" then
            for _, obj in ipairs(workspace:GetChildren()) do
                if obj:IsA("Model") and obj.Name ~= "Terrain" then
                    mapName = obj.Name
                    break
                end
            end
        end
        
        local info = "📋 SERVER INFORMATION\n"
        info = info .. "═══════════════════════════\n"
        info = info .. "🆔 Server ID: " .. serverId .. "\n"
        info = info .. "📍 Map: " .. mapName .. "\n"
        info = info .. "👤 Players: " .. playerCount .. " / " .. maxPlayers .. "\n"
        info = info .. "🟢 Status: Active\n"
        info = info .. "⏰ Time: " .. currentTime .. "\n"
        info = info .. "📅 Date: " .. currentDate .. "\n"
        info = info .. "═══════════════════════════\n"
        
        info = info .. "📋 Player List:\n"
        local playerNames = {}
        for _, player in ipairs(players) do
            table.insert(playerNames, player.Name)
        end
        table.sort(playerNames)
        for i, name in ipairs(playerNames) do
            if i <= 10 then
                info = info .. "   👤 " .. name .. "\n"
            else
                info = info .. "   ... and " .. (#playerNames - 10) .. " more\n"
                break
            end
        end
        
        ServerInfoParagraph:Set(info)
    end)
end

