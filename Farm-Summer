-- =============================================
-- HÀM TÌM VẬT PHẨM SỰ KIỆN (KHÔNG DÙNG TÊN - QUÉT TOÀN DIỆN)
-- =============================================
local function FindEventItems()
    local items = {}
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character then return items end
    local rootPos = character:FindFirstChild("HumanoidRootPart")
    if not rootPos then return items end
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsDescendantOf(character) then continue end
        
        local isEventItem = false
        local position = nil
        local clickDetector = obj:FindFirstChild("ClickDetector")
        local proximityPrompt = obj:FindFirstChild("ProximityPrompt")
        
        -- CÁCH 1: PHÁT HIỆN QUA TƯƠNG TÁC
        if clickDetector or proximityPrompt then
            isEventItem = true
        end
        
        -- CÁCH 2: PHÁT HIỆN QUA ATTRIBUTE
        if not isEventItem then
            local attrs = obj:GetAttributes()
            if next(attrs) then
                for attrName, attrValue in pairs(attrs) do
                    local nameLower = attrName:lower()
                    if nameLower:find("collect") or nameLower:find("event") or 
                       nameLower:find("currency") or nameLower:find("reward") or
                       nameLower:find("item") or nameLower:find("pickup") or
                       nameLower:find("value") or nameLower:find("point") then
                        isEventItem = true
                        break
                    end
                    if type(attrValue) == "number" and attrValue > 0 then
                        isEventItem = true
                        break
                    end
                end
            end
        end
        
        -- CÁCH 3: PHÁT HIỆN QUA FOLDER CHỨA
        if not isEventItem then
            local parent = obj.Parent
            while parent do
                local parentName = parent.Name:lower()
                if parentName:find("collect") or parentName:find("event") or 
                   parentName:find("currency") or parentName:find("item") or
                   parentName:find("reward") or parentName:find("pickup") then
                    isEventItem = true
                    break
                end
                parent = parent.Parent
            end
        end
        
        -- CÁCH 4: PHÁT HIỆN QUA SCRIPT
        if not isEventItem then
            for _, script in ipairs(obj:GetChildren()) do
                if script:IsA("Script") or script:IsA("LocalScript") then
                    local src = script.Source or ""
                    if src:find("collect") or src:find("pickup") or 
                       src:find("click") or src:find("prompt") or
                       src:find("event") or src:find("reward") then
                        isEventItem = true
                        break
                    end
                end
            end
        end
        
        -- CÁCH 5: PHÁT HIỆN QUA VỊ TRÍ (VẬT PHẨM TRÊN MẶT ĐẤT)
        if not isEventItem and obj:IsA("BasePart") then
            local pos = obj.Position
            local raycastParams = RaycastParams.new()
            raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
            raycastParams.FilterDescendantsInstances = {character}
            local rayOrigin = pos + Vector3.new(0, 5, 0)
            local rayDirection = Vector3.new(0, -10, 0)
            local rayResult = workspace:Raycast(rayOrigin, rayDirection, raycastParams)
            
            if rayResult then
                local dist = (rootPos.Position - pos).Magnitude
                if dist > 10 and dist < 500 then
                    isEventItem = true
                end
            end
        end
        
        if isEventItem then
            if obj:IsA("BasePart") then
                position = obj.Position
            elseif obj:IsA("Model") then
                if obj:FindFirstChild("PrimaryPart") then
                    position = obj.PrimaryPart.Position
                elseif obj:FindFirstChild("HumanoidRootPart") then
                    position = obj.HumanoidRootPart.Position
                elseif obj:FindFirstChild("Head") then
                    position = obj.Head.Position
                else
                    local sumPos = Vector3.new(0, 0, 0)
                    local count = 0
                    for _, part in ipairs(obj:GetChildren()) do
                        if part:IsA("BasePart") then
                            sumPos = sumPos + part.Position
                            count = count + 1
                        end
                    end
                    if count > 0 then position = sumPos / count end
                end
            end
            
            if position then
                table.insert(items, {
                    object = obj,
                    position = position,
                    name = obj.Name,
                    distance = (rootPos.Position - position).Magnitude,
                    clickDetector = clickDetector,
                    proximityPrompt = proximityPrompt
                })
            end
        end
    end
    
    table.sort(items, function(a, b)
        return a.distance < b.distance
    end)
    
    return items
end

