-- AUTO FARM EVENT - QUÉT TOÀN BỘ MAP
-- =============================================
local AutoFarm = false
local FarmConnection = nil
local CollectedCount = 0
local TotalBubbles = 0
local FarmCooldown = 0
local CurrentIndex = 1
local AllBubbles = {}
local IsScanning = false

-- QUÉT TOÀN BỘ MAP TÌM BUBBLE
local function ScanAllBubbles()
    AllBubbles = {}
    local LocalPlayer = game.Players.LocalPlayer
    
    print("[AutoFarm] 🔍 Đang quét toàn bộ map tìm Bubble...")
    
    -- Quét toàn bộ workspace
    for _, obj in ipairs(workspace:GetDescendants()) do
        local name = obj.Name or ""
        if name:lower():find("bubble") then
            local position = nil
            
            -- Lấy vị trí
            if obj:IsA("BasePart") then
                position = obj.Position
            elseif obj:IsA("Model") then
                if obj:FindFirstChild("PrimaryPart") then
                    position = obj.PrimaryPart.Position
                elseif obj:FindFirstChild("HumanoidRootPart") then
                    position = obj.HumanoidRootPart.Position
                elseif obj:FindFirstChild("Head") then
                    position = obj.Head.Position
                else
                    local sumPos = Vector3.new(0, 0, 0)
                    local count = 0
                    for _, part in ipairs(obj:GetChildren()) do
                        if part:IsA("BasePart") then
                            sumPos = sumPos + part.Position
                            count = count + 1
                        end
                    end
                    if count > 0 then
                        position = sumPos / count
                    end
                end
            end
            
            if position then
                table.insert(AllBubbles, {
                    object = obj,
                    position = position,
                    name = obj.Name,
                    collected = false
                })
                print("[AutoFarm] 🎈 Tìm thấy Bubble: " .. obj.Name .. " tại " .. tostring(position))
            end
        end
    end
    
    TotalBubbles = #AllBubbles
    print("[AutoFarm] ✅ Quét hoàn tất! Tìm thấy " .. TotalBubbles .. " Bubble trên toàn bộ map")
    return AllBubbles
end

-- TELEPORT ĐẾN BUBBLE
local function TeleportToBubble(targetPos)
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character then return false end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end
    
    rootPart.CFrame = CFrame.new(targetPos)
    return true
end

-- NHẶT BUBBLE
local function CollectBubble(item)
    if not item or not item.object then return false end
    if item.collected then return false end
    
    local success = false
    
    -- Cách 1: ClickDetector
    local clickDetector = item.object:FindFirstChild("ClickDetector")
    if clickDetector then
        pcall(function()
            clickDetector:FireClick()
            success = true
        end)
    end
    
    -- Cách 2: ProximityPrompt
    local proximityPrompt = item.object:FindFirstChild("ProximityPrompt")
    if proximityPrompt then
        pcall(function()
            proximityPrompt:Fire()
            success = true
        end)
    end
    
    -- Cách 3: Chạm vào
    if not success then
        success = true
    end
    
    if success then
        item.collected = true
        CollectedCount = CollectedCount + 1
        print("[AutoFarm] ✅ Đã nhặt Bubble #" .. CollectedCount .. ": " .. item.name)
        ShowNotification("🎈 Đã nhặt!", "Bubble #" .. CollectedCount .. "/" .. TotalBubbles, 2, Color3.fromRGB(0, 255, 255))
        UpdateFarmLabel()
        return true
    end
    
    return false
end

-- FARM LOOP - QUÉT TOÀN BỘ MAP
local function FarmLoop()
    if not AutoFarm then return end
    
    -- Chống spam
    if tick() - FarmCooldown < 0.8 then
        return
    end
    
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character then return end
    
    -- Nếu chưa có danh sách Bubble hoặc đã nhặt hết -> Quét lại
    if #AllBubbles == 0 or CurrentIndex > #AllBubbles then
        ScanAllBubbles()
        CurrentIndex = 1
        
        if #AllBubbles == 0 then
            print("[AutoFarm] ⚠️ Không tìm thấy Bubble nào!")
            FarmCooldown = tick()
            return
        end
        
        ShowNotification("🎈 Đã quét!", "Tìm thấy " .. #AllBubbles .. " Bubble trên map", 3, Color3.fromRGB(0, 255, 255))
    end
    
    -- Tìm Bubble chưa nhặt
    local target = nil
    for i = CurrentIndex, #AllBubbles do
        if not AllBubbles[i].collected then
            target = AllBubbles[i]
            CurrentIndex = i
            break
        end
    end
    
    -- Nếu tất cả đã nhặt -> reset
    if not target then
        print("[AutoFarm] 🎉 Đã nhặt hết tất cả Bubble! Đang quét lại...")
        CurrentIndex = #AllBubbles + 1
        FarmCooldown = tick()
        return
    end
    
    -- TELEPORT ĐẾN BUBBLE
    TeleportToBubble(target.position)
    print("[AutoFarm] 🚀 Teleport đến Bubble #" .. CurrentIndex .. ": " .. target.name)
    
    wait(0.2)
    
    -- Nhặt Bubble
    CollectBubble(target)
    
    -- Chuyển sang Bubble tiếp theo
    CurrentIndex = CurrentIndex + 1
    FarmCooldown = tick()
end

