local function UpdateMapBounds()
    local minX, maxX = -250, 250
    local minZ, maxZ = -250, 250
    local minY, maxY = 30, 200
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Part") and obj.Size.Magnitude > 50 then
            local pos = obj.Position
            local size = obj.Size
            minX = math.min(minX, pos.X - size.X/2)
            maxX = math.max(maxX, pos.X + size.X/2)
            minZ = math.min(minZ, pos.Z - size.Z/2)
            maxZ = math.max(maxZ, pos.Z + size.Z/2)
            maxY = math.max(maxY, pos.Y + size.Y/2)
        end
    end
    MapBounds.MinX = minX + 20
    MapBounds.MaxX = maxX - 20
    MapBounds.MinZ = minZ + 20
    MapBounds.MaxZ = maxZ - 20
    MapBounds.MinY = 30
    MapBounds.MaxY = math.min(maxY - 10, 250)
end

local function IsInsideMap(pos)
    return pos.X >= MapBounds.MinX and pos.X <= MapBounds.MaxX and
           pos.Z >= MapBounds.MinZ and pos.Z <= MapBounds.MaxZ and
           pos.Y >= MapBounds.MinY and pos.Y <= MapBounds.MaxY
end

local function FindSafePosition()
    UpdateMapBounds()
    for attempt = 1, 50 do
        local testPos = Vector3.new(
            math.random(MapBounds.MinX, MapBounds.MaxX),
            math.random(MapBounds.MinY + 10, MapBounds.MaxY - 10),
            math.random(MapBounds.MinZ, MapBounds.MaxZ)
        )
        if testPos.Y < 30 then
            testPos = Vector3.new(testPos.X, math.random(40, 150), testPos.Z)
        end
        if not IsInsideMap(testPos) then
            testPos = Vector3.new(
                math.random(MapBounds.MinX + 10, MapBounds.MaxX - 10),
                math.random(MapBounds.MinY + 10, MapBounds.MaxY - 10),
                math.random(MapBounds.MinZ + 10, MapBounds.MaxZ - 10)
            )
        end
        local isSafe = true
        local LocalPlayer = game.Players.LocalPlayer
        for _, player in ipairs(game.Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local enemy = player.Character
                if enemy and enemy:FindFirstChild("HumanoidRootPart") then
                    if (testPos - enemy.HumanoidRootPart.Position).Magnitude < 55 then
                        isSafe = false
                        break
                    end
                end
            end
        end
        if isSafe then
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("Model") and obj:FindFirstChild("HumanoidRootPart") then
                    local name = obj.Name:lower()
                    if name:find("bot") or name:find("next") or name:find("npc") then
                        if (testPos - obj.HumanoidRootPart.Position).Magnitude < 55 then
                            isSafe = false
                            break
                        end
                    end
                end
            end
        end
        if isSafe and IsInsideMap(testPos) and testPos.Y > 30 then
            return testPos
        end
    end
    return Vector3.new(0, 50, 0)
end

local function CheckNextBot()
    if not AntiNextBot then return end
    if tick() - NextBotCheckCooldown < 0.3 then return end
    NextBotCheckCooldown = tick()
    local LocalPlayer = game.Players.LocalPlayer
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local currentPos = root.Position
    UpdateMapBounds()
    if currentPos.Y < 30 or not IsInsideMap(currentPos) then
        local safePos = FindSafePosition()
        if safePos and safePos.Y > 30 then
            root.CFrame = CFrame.new(safePos)
            return
        end
    end
    local botNear = false
    for _, player in ipairs(game.Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local enemy = player.Character
            if enemy and enemy:FindFirstChild("HumanoidRootPart") then
                if (currentPos - enemy.HumanoidRootPart.Position).Magnitude < 55 then
                    botNear = true
                    break
                end
            end
        end
    end
    if not botNear then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and obj:FindFirstChild("HumanoidRootPart") then
                local name = obj.Name:lower()
                if name:find("bot") or name:find("next") or name:find("npc") then
                    if (currentPos - obj.HumanoidRootPart.Position).Magnitude < 55 then
                        botNear = true
                        break
                    end
                end
            end
        end
    end
    if botNear then
        local safePos = FindSafePosition()
        if safePos and IsInsideMap(safePos) and safePos.Y > 30 then
            root.CFrame = CFrame.new(safePos)
            ShowNotification("🛡️ NextBot", "Phát hiện bot! Teleport đến vị trí an toàn", 2, Color3.fromRGB(255, 200, 0))
        end
    end
end

