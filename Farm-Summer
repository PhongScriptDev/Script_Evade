-- =============================================
-- CHỐNG NEXTBOT
-- =============================================
local AntiNextBot = false
local NextBotConnection = nil

local function GetSafePosition()
    local pos = Vector3.new(
        math.random(-180, 180),
        math.random(50, 150),
        math.random(-180, 180)
    )
    return pos
end

local function CheckNextBot()
    if not AntiNextBot then return end
    
    local LocalPlayer = game.Players.LocalPlayer
    local char = LocalPlayer.Character
    if not char then return end
    
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    local botNear = false
    for _, player in ipairs(game.Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local enemy = player.Character
            if enemy and enemy:FindFirstChild("HumanoidRootPart") then
                local dist = (root.Position - enemy.HumanoidRootPart.Position).Magnitude
                if dist < 50 then
                    botNear = true
                    break
                end
            end
        end
    end
    
    if botNear then
        local safePos = GetSafePosition()
        root.CFrame = CFrame.new(safePos)
        print("[NextBot] Teleport đến: " .. tostring(safePos))
    end
end

MainTab:CreateToggle({
    Name = "Chống NextBot V2 🛡️",
    Description = "Tự động teleport khi bot gần",
