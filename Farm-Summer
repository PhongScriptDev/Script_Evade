local AutoFarm = false
local FarmConnection = nil
local CollectedCount = 0
local EventItems = {}
local CurrentTarget = nil
local IsMoving = false

-- Tìm tất cả vật phẩm sự kiện trên map
local function FindEventItems()
    EventItems = {}
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character then return end
    
    local rootPos = character:FindFirstChild("HumanoidRootPart")
    if not rootPos then return end
    
    -- Tìm các object có tên liên quan đến sự kiện
    local searchNames = {
        "balloon", "bong", "bongbong", "event", "item", "collect", 
        "gift", "qua", "vật phẩm", "summer", "mùa hè", "2026",
        "pickup", "collectible", "token", "coin", "xu"
    }
    
    -- Quét toàn bộ workspace
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Part") or obj:IsA("MeshPart") or obj:IsA("Model") then
            local name = obj.Name:lower()
            local isEventItem = false
            
            for _, keyword in ipairs(searchNames) do
                if name:find(keyword) then
                    isEventItem = true
                    break
                end
            end
            
            -- Kiểm tra nếu có ClickDetector hoặc có thể tương tác
            local hasClickDetector = obj:FindFirstChild("ClickDetector") or obj:FindFirstChild("ProximityPrompt")
            
            if isEventItem or hasClickDetector then
                local position = nil
                local itemObj = obj
                
                -- Nếu là Model, tìm PrimaryPart hoặc HumanoidRootPart
                if obj:IsA("Model") then
                    if obj:FindFirstChild("PrimaryPart") then
                        position = obj.PrimaryPart.Position
                    elseif obj:FindFirstChild("HumanoidRootPart") then
                        position = obj.HumanoidRootPart.Position
                    elseif obj:FindFirstChild("Head") then
                        position = obj.Head.Position
                    else
                        -- Lấy vị trí trung bình của các part trong model
                        local sumPos = Vector3.new(0, 0, 0)
                        local count = 0
                        for _, part in ipairs(obj:GetChildren()) do
                            if part:IsA("Part") or part:IsA("MeshPart") then
                                sumPos = sumPos + part.Position
                                count = count + 1
                            end
                        end
                        if count > 0 then
                            position = sumPos / count
                        end
                    end
                else
                    position = obj.Position
                end
                
                if position then
                    -- Kiểm tra khoảng cách để loại bỏ vật phẩm quá xa (nếu cần)
                    local dist = (rootPos.Position - position).Magnitude
                    if dist < 500 then -- Chỉ farm trong bán kính 500 studs
                        table.insert(EventItems, {
                            object = obj,
                            position = position,
                            distance = dist,
                            name = obj.Name
                        })
                    end
                end
            end
        end
    end
    
    -- Sắp xếp theo khoảng cách gần nhất
    table.sort(EventItems, function(a, b)
        return a.distance < b.distance
    end)
    
    print("[AutoFarm] Tìm thấy " .. #EventItems .. " vật phẩm sự kiện")
    return EventItems
end

-- Di chuyển đến vị trí
local function MoveToPosition(targetPos)
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character then return false end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end
    
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid then return false end
    
    -- Kiểm tra khoảng cách
    local currentPos = rootPart.Position
    local dist = (currentPos - targetPos).Magnitude
    
    if dist < 5 then
        return true -- Đã đến gần
    end
    
    -- Di chuyển đến target
    local moveDirection = (targetPos - currentPos).Unit
    local movePos = currentPos + moveDirection * math.min(dist, 10)
    
    -- Tạo CFrame mới
    rootPart.CFrame = CFrame.new(movePos)
    
    return false
end

-- Nhặt vật phẩm
local function CollectItem(item)
    if not item or not item.object then return false end
    
    local success = false
    
    -- Cách 1: ClickDetector
    local clickDetector = item.object:FindFirstChild("ClickDetector")
    if clickDetector then
        pcall(function()
            clickDetector:FireClick()
            success = true
            print("[AutoFarm] ✅ Đã nhặt: " .. item.name)
        end)
    end
    
    -- Cách 2: ProximityPrompt
    local proximityPrompt = item.object:FindFirstChild("ProximityPrompt")
    if proximityPrompt then
        pcall(function()
            proximityPrompt:Fire()
            success = true
            print("[AutoFarm] ✅ Đã nhặt: " .. item.name)
        end)
    end
    

    -- Cách 3: Touched (di chuyển đến gần để tự động nhặt)
    if not success then
        local LocalPlayer = game.Players.LocalPlayer
        local character = LocalPlayer.Character
        if character and character:FindFirstChild("HumanoidRootPart") then
            local root = character.HumanoidRootPart
            local targetPos = item.position
            root.CFrame = CFrame.new(targetPos + Vector3.new(0, 0, 0))
            success = true
            print("[AutoFarm] ✅ Đã di chuyển đến: " .. item.name)
        end
    end
    
    if success then
        CollectedCount = CollectedCount + 1
        ShowNotification("🎈 Đã nhặt!", "Đã nhặt: " .. item.name .. " (Tổng: " .. CollectedCount .. ")", 2, Color3.fromRGB(0, 255, 255))
    end
    
    return success
end

-- Farm chính
local function FarmLoop()
    if not AutoFarm then return end
    
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character then return end
    
    -- Tìm vật phẩm
    local items = FindEventItems()
    
    if #items == 0 then
        print("[AutoFarm] ⚠️ Không tìm thấy vật phẩm nào!")
        return
    end
    
    -- Lấy vật phẩm gần nhất
    local target = items[1]
    if not target then return end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    local currentPos = rootPart.Position
    local dist = (currentPos - target.position).Magnitude
    
    if dist < 10 then
        -- Ở gần -> nhặt
        CollectItem(target)
        wait(0.5)
    else
        -- Di chuyển đến gần
        print("[AutoFarm] 🚶 Đang di chuyển đến: " .. target.name .. " (Khoảng cách: " .. tostring(dist) .. ")")
        MoveToPosition(target.position)
        wait(0.3)
    end
end

