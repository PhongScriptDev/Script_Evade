                FarmConnection:Disconnect()
            end
            
            FarmConnection = game:GetService("RunService").Stepped:Connect(function()
                if AutoFarm then
                    pcall(function()
                        FarmLoop()
                    end)
                end
            end)
            
            print("[AutoFarm] ===== ĐANG CHẠY =====")
        else
            print("[AutoFarm] ===== ĐÃ TẮT =====")
            ShowNotification("❌ Auto Farm", "Đã tắt! Tổng: " .. CollectedCount .. " Bubble", 3, Color3.fromRGB(255, 0, 0))
            
            if FarmConnection then
                FarmConnection:Disconnect()
                FarmConnection = nil
            end
        end
    end
})

