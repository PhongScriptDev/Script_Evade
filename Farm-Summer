local function HandleError(errorMessage)
    if not AntiErrorCode then return end
    
    print("[Anti Error] Phát hiện lỗi: " .. tostring(errorMessage))
    
    local recoverableErrors = {
        "Datamodel",
        "Replication",
        "Network",
        "Memory",
        "Workspace",
        "Players",
        "RunService",
        "HttpService",
        "TweenService",
        "UserInputService",
        "ContextActionService",
        "VirtualUser"
    }
    
    local canRecover = false
    for _, err in ipairs(recoverableErrors) do
        if tostring(errorMessage):find(err) then
            canRecover = true
            break
        end
    end
    
    if canRecover then
        print("[Anti Error] Đang cố gắng khôi phục lỗi...")
        pcall(function()
            game:GetService("RunService"):BindToRenderStep("AntiError", 0, function()
                -- No operation
            end)
        end)
        wait(0.5)
        ShowNotification("🔄 Đã khôi phục!", "Đã xử lý lỗi: " .. tostring(errorMessage), 3, Color3.fromRGB(0, 255, 255))
    else
        print("[Anti Error] Lỗi quá VIP, không thể xử lý! Đang tham gia lại...")
        ShowNotification("🔄 ĐANG REJOIN!", "Lỗi quá VIP, đang tham gia lại server mới...", 5, Color3.fromRGB(255, 200, 0))
        
        RejoinAttempts = RejoinAttempts + 1
        if RejoinAttempts <= MaxRejoinAttempts then
            local LocalPlayer = game.Players.LocalPlayer
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                LastPosition = char.HumanoidRootPart.Position
            end
            
            pcall(function()
                game:GetService("TeleportService"):Teleport(game.PlaceId)
            end)
        else
            ShowNotification("❌ QUÁ NHIỀU LẦN REJOIN!", "Đã vượt quá số lần thử! Hãy tắt Anti Error Code và thử lại.", 5, Color3.fromRGB(255, 0, 0))
            RejoinAttempts = 0
        end
    end
end

local function SetupErrorHandler()
    if ErrorConnection then
        ErrorConnection:Disconnect()
        ErrorConnection = nil
    end
    
    ErrorConnection = game:GetService("ScriptContext").Error:Connect(function(errorMessage, script)
        if AntiErrorCode then
            HandleError(errorMessage)
        end
    end)
    
    pcall(function()
        local coreGui = game:GetService("CoreGui")
        if coreGui then
            coreGui.ChildAdded:Connect(function(child)
                if AntiErrorCode and child:IsA("ScreenGui") then
                    local errorText = child:FindFirstChild("ErrorText")
                    if errorText and errorText:IsA("TextLabel") then
                        HandleError(errorText.Text)
                    end
                end
            end)
        end
    end)
end

