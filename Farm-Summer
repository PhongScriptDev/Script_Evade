-- =============================================
local function RevivePlayer()
    if IsReviving then return end
    IsReviving = true
    
    local LocalPlayer = game.Players.LocalPlayer
    local char = LocalPlayer.Character
    
    if not char then
        pcall(function()
            LocalPlayer:LoadCharacter()
            print("[Revive] Đã respawn (không có nhân vật)")
        end)
        IsReviving = false
        return
    end
    
    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid then
        pcall(function()
            LocalPlayer:LoadCharacter()
            print("[Revive] Đã respawn (không có Humanoid)")
        end)
        IsReviving = false
        return
    end
    
    local isDowned = char:GetAttribute("Downed") or false
    local health = humanoid.Health or 0
    local isDead = humanoid:GetState() == Enum.HumanoidStateType.Dead
    
    if isDowned or health <= 0 or isDead then
        print("[Revive] Phát hiện bị hạ gục! Đang hồi sinh...")
        
        pcall(function()
            humanoid.Health = 100
        end)
        
        pcall(function()
            local downedState = char:FindFirstChild("Downed")
            if downedState then
                downedState:Destroy()
            end
        end)
        
        pcall(function()
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
            wait(0.05)
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
        end)
        
        pcall(function()
            humanoid.Sit = false
            humanoid.PlatformStand = false
            humanoid.AutoRotate = true
        end)
        
        wait(0.2)
        if humanoid.Health <= 0 then
            pcall(function()
                LocalPlayer:LoadCharacter()
                print("[Revive] Đã respawn (force)")
            end)
        else
            print("[Revive] Hồi sinh thành công!")
        end
        
        -- Teleport lên tường nếu có
        if SafeWall then
            wait(0.1)
            local newChar = LocalPlayer.Character
            if newChar and newChar:FindFirstChild("HumanoidRootPart") then
                newChar.HumanoidRootPart.CFrame = CFrame.new(SafeWall.Position + Vector3.new(0, 2, 0))
            end
        end
    end
    
    IsReviving = false
end

