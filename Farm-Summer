-- HÀM TÌM VẬT PHẨM SỰ KIỆN
-- =============================================
local function FindEventItems()
    local items = {}
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character then return items end
    local rootPos = character:FindFirstChild("HumanoidRootPart")
    if not rootPos then return items end
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsDescendantOf(character) then continue end
        
        local clickDetector = obj:FindFirstChild("ClickDetector")
        local proximityPrompt = obj:FindFirstChild("ProximityPrompt")
        
        if clickDetector or proximityPrompt then
            local isEventItem = false
            local position = nil
            
            -- Kiểm tra attribute (không dùng tên)
            local attrs = {"CurrencyType", "EventCurrency", "Collectible", "Currency", "Reward", "Value", "Points", "Collectable", "Pickup", "Item", "EventItem"}
            for _, attr in ipairs(attrs) do
                if obj:GetAttribute(attr) ~= nil then
                    isEventItem = true
                    break
                end
            end
            
            -- Kiểm tra tên của ClickDetector
            if not isEventItem and clickDetector then
                local detName = clickDetector.Name:lower()
                if detName:find("collect") or detName:find("pickup") or detName:find("event") or detName:find("currency") or detName:find("item") then
                    isEventItem = true
                end
            end
            
            -- Kiểm tra folder chứa
            if not isEventItem then
                local parent = obj.Parent
                if parent then
                    local parentName = parent.Name:lower()
                    if parentName:find("collect") or parentName:find("event") or parentName:find("currency") or parentName:find("item") or parentName:find("pickup") then
                        isEventItem = true
                    end
                end
            end
            
            if isEventItem then
                if obj:IsA("BasePart") then
                    position = obj.Position
                elseif obj:IsA("Model") then
                    if obj:FindFirstChild("PrimaryPart") then
                        position = obj.PrimaryPart.Position
                    elseif obj:FindFirstChild("HumanoidRootPart") then
                        position = obj.HumanoidRootPart.Position
                    elseif obj:FindFirstChild("Head") then
                        position = obj.Head.Position
                    else
                        local sumPos = Vector3.new(0, 0, 0)
                        local count = 0
                        for _, part in ipairs(obj:GetChildren()) do
                            if part:IsA("BasePart") then
                                sumPos = sumPos + part.Position
                                count = count + 1
                            end
                        end
                        if count > 0 then position = sumPos / count end
                    end
                end
                
                if position then
                    table.insert(items, {
                        object = obj,
                        position = position,
                        name = obj.Name,
                        distance = (rootPos.Position - position).Magnitude,
                        clickDetector = clickDetector,
                        proximityPrompt = proximityPrompt
                    })
                end
            end
        end
    end
    
    table.sort(items, function(a, b)
        return a.distance < b.distance
    end)
    
    return items
end

-- =============================================
-- HÀM KIỂM TRA SỰ KIỆN
-- =============================================
local function CheckEventStatus()
    pcall(function()
        local items = FindEventItems()
        local count = #items
        
        if count > 0 then
            EventActive = true
            EventStatusLabel:Set("⏰ Event: ✅ ACTIVE (" .. count .. " items)")
            CurrencyLabel:Set("🎯 Event Items: " .. count)
        else
            EventActive = false
            EventStatusLabel:Set("⏰ Event: ❌ NONE")
            CurrencyLabel:Set("🎯 Event Items: 0")
        end
        
        return EventActive
    end)
    return EventActive
end

-- =============================================
-- HÀM CẬP NHẬT LABEL
-- =============================================
local function UpdateLabels()
    pcall(function()
        local items = FindEventItems()
        TotalItems = #items
        CurrencyLabel:Set("🎯 Event Items: " .. #items)
        
        local LocalPlayer = game.Players.LocalPlayer
        local stats = LocalPlayer:FindFirstChild("leaderstats")
        if stats then
            local level = stats:FindFirstChild("Level")
            local exp = stats:FindFirstChild("Exp") or stats:FindFirstChild("Experience")
            local expToNext = stats:FindFirstChild("ExpToNext") or stats:FindFirstChild("ExperienceToNext")
            
            if level then
                LevelLabel:Set("⭐ Current Level: " .. level.Value)
            end
            if exp and expToNext then
                ExpLabel:Set("✨ Exp: " .. exp.Value .. " / " .. expToNext.Value)
            elseif exp then
                ExpLabel:Set("✨ Exp: " .. exp.Value)
            end
        end
        
        if tick() - LastEventCheck > 5 then
            LastEventCheck = tick()
            CheckEventStatus()
        end
    end)
end

UpdateLabels()
CheckEventStatus()

