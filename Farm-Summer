-- Kiểm tra người chơi đã chết hẳn chưa
local function IsPlayerFullyDead(character)
    if not character then
        return true
    end
    
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid then
        return true
    end
    
    if humanoid.Health <= 0 then
        local downedState = character:FindFirstChild("Downed")
        if downedState then
            return false
        end
        
        if character:FindFirstChild("DeathAnim") then
            return true
        end
        
        local torso = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
        if not torso then
            return true
        end
        
        if humanoid:GetState() == Enum.HumanoidStateType.Dead then
            return true
        end
        
        for _, child in ipairs(character:GetChildren()) do
            if child.Name:lower():find("dead") or child.Name:lower():find("death") then
                return true
            end
        end
        
        return false
    end
    
    return false
end

-- Kiểm tra người chơi đang bị gục
local function IsPlayerDowned(character)
    if not character then
        return false
    end
    
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid then
        return false
    end
    
    if humanoid.Health <= 0 then
        local downedState = character:FindFirstChild("Downed")
        if downedState then
            return true
        end
        
        local torso = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
        if torso then
            if humanoid:GetState() == Enum.HumanoidStateType.Physics then
                return true
            end
        end
    end
    
    return false
end

