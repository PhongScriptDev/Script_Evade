-- FARM LOOP (TỐI ƯU - GIẢM LAG)
local function FarmLoop()
    if not AutoFarm then return end
    
    FarmLoopCount = FarmLoopCount + 1
    if FarmLoopCount % 3 ~= 0 then return end
    if tick() - FarmCooldown < 0.5 then return end
    
    local LocalPlayer = game.Players.LocalPlayer
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    if char:GetAttribute("Downed") then
        FarmCooldown = tick()
        return
    end
    
    -- Kiểm tra map đang bình chọn/tạm dừng
    local gameState = workspace:FindFirstChild("GameState")
    if gameState then
        local stateText = tostring(gameState.Value or "")
        if stateText:lower():find("voting") or stateText:lower():find("bình chọn") or
           stateText:lower():find("paused") or stateText:lower():find("tạm dừng") then
            if not IsAtWall then TeleportToWall() end
            FarmCooldown = tick()
            return
        end
    end
    
    -- Tìm Bubble
    local bubbles = FindBubbles()
    local bubbleCount = #bubbles
    pcall(function() BubbleLabel:Set("🎈 Bubble trong map: " .. bubbleCount) end)
    
    -- Không có Bubble -> về tường
    if bubbleCount == 0 then
        if not IsAtWall then
            TeleportToWall()
            ShowNotification("📍 Về tường", "Không có Bubble!", 1.5, Color3.fromRGB(0, 200, 255))
        end
        FarmCooldown = tick()
        return
    end
    
    -- Lấy Bubble gần nhất
    local currentPos = root.Position
    local nearestBubble = nil
    local nearestDist = math.huge
    for _, bubble in ipairs(bubbles) do
        local dist = (currentPos - bubble.position).Magnitude
        if dist < nearestDist then
            nearestDist = dist
            nearestBubble = bubble
        end
    end
    
    if not nearestBubble then
        FarmCooldown = tick()
        return
    end
    
    -- Nếu đang ở tường -> TELEPORT TỨC THỜI đến Bubble
    if IsAtWall then
        ShowNotification("🎈 Tìm thấy Bubble!", "Teleport đến Bubble...", 1.5, Color3.fromRGB(0, 255, 255))
        TeleportToBubble(nearestBubble.position)
        FarmCooldown = tick()
        return
    end
    
    -- Nếu đang ở Bubble -> nhặt và về tường
    if not IsAtWall then
        local distToBubble = (currentPos - nearestBubble.position).Magnitude
        if distToBubble < 10 then
            -- Nhặt Bubble
            pcall(function()
                local clickDetector = nearestBubble.object:FindFirstChild("ClickDetector")
                if clickDetector then clickDetector:FireClick() end
                local proximityPrompt = nearestBubble.object:FindFirstChild("ProximityPrompt")
                if proximityPrompt then proximityPrompt:Fire() end
                CollectedCount = CollectedCount + 1
                ShowNotification("🎈 Đã nhặt!", "Bubble #" .. CollectedCount, 2, Color3.fromRGB(0, 255, 255))
                TotalLabel:Set("🎯 Đã nhặt: " .. CollectedCount .. " Bubble")
            end)
            -- TELEPORT TỨC THỜI về tường
            TeleportToWall()
            ShowNotification("📍 Về tường", "Đã nhặt Bubble xong!", 1.5, Color3.fromRGB(0, 200, 255))
            FarmCooldown = tick()
        else
            -- TELEPORT TỨC THỜI đến Bubble
            TeleportToBubble(nearestBubble.position)
            FarmCooldown = tick()
        end
        return
    end
end

