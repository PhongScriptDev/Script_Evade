local FarmToken = false
local FarmTokenConnection = nil
local FarmTokenCooldown = 0
local CurrentTarget = nil
local TargetPositionWall = nil

-- Tìm người chơi bị hạ gục
local function FindDownedPlayer()
    local LocalPlayer = game.Players.LocalPlayer
    local nearestDowned = nil
    local nearestDist = math.huge
    
    for _, player in ipairs(game.Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = player.Character
            if character then
                -- Kiểm tra health
                local humanoid = character:FindFirstChild("Humanoid")
                if humanoid and humanoid.Health <= 0 then
                    local root = character:FindFirstChild("HumanoidRootPart")
                    if root then
                        local dist = (root.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
                        if dist < nearestDist then
                            nearestDist = dist
                            nearestDowned = player
                        end
                    end
                end
                
                -- Kiểm tra Downed state
                local downedState = character:FindFirstChild("Downed")
                if downedState then
                    local root = character:FindFirstChild("HumanoidRootPart")
                    if root then
                        local dist = (root.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
                        if dist < nearestDist then
                            nearestDist = dist
                            nearestDowned = player
                        end
                    end
                end
            end
        end
    end
    
    return nearestDowned
end

-- Kiểm tra bot gần vị trí
local function IsBotNearPositionToken(pos, radius)
    radius = radius or 50
    local LocalPlayer = game.Players.LocalPlayer
    
    for _, player in ipairs(game.Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local enemy = player.Character
            if enemy and enemy:FindFirstChild("HumanoidRootPart") then
                local dist = (pos - enemy.HumanoidRootPart.Position).Magnitude
                if dist < radius then
                    return true
                end
            end
        end
    end
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("HumanoidRootPart") then
            local name = obj.Name:lower()
            if name:find("bot") or name:find("next") or name:find("npc") then
                local dist = (pos - obj.HumanoidRootPart.Position).Magnitude
                if dist < radius then
                    return true
                end
            end
        end
    end
    
    return false
end

-- Tìm vị trí an toàn trong map (trên cao, không bot)
local function FindSafePositionToken()
    UpdateMapBounds()
    
    for attempt = 1, 30 do
        local testPos = Vector3.new(
            math.random(MapBounds.MinX + 50, MapBounds.MaxX - 50),
            math.random(80, MapBounds.MaxY - 20),
            math.random(MapBounds.MinZ + 50, MapBounds.MaxZ - 50)
        )
        
        if IsInsideMap(testPos) and not IsBotNearPositionToken(testPos, 50) then
            return testPos
        end
    end
    
    return Vector3.new(0, 100, 0)
end

-- Carry người chơi
local function CarryPlayer(player)
    if not player then return false end
    
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character then return false end
    
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid then return false end
    
    -- Teleport đến người chơi
    local targetChar = player.Character
    if targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
        local root = character:FindFirstChild("HumanoidRootPart")
        if root then
            root.CFrame = targetChar.HumanoidRootPart.CFrame + Vector3.new(0, 2, 0)
        end
    end
    
    -- Thực hiện Carry
    pcall(function()
        humanoid:Carry(player)
        print("[Farm Token] Đã carry: " .. player.Name)
        CarriedPlayer = player
        IsCarrying = true
        ShowNotification("🤝 Đang carry!", "Đang carry " .. player.Name, 2, Color3.fromRGB(255, 200, 0))
        return true
    end)
    
    return false
end

-- Cứu người chơi (Resurrect)
local function ResurrectPlayer(player)
    if not player then return false end
    
    local targetChar = player.Character
    if not targetChar then return false end
    
    local humanoid = targetChar:FindFirstChild("Humanoid")
    if not humanoid then return false end
    
    -- Hồi sinh
    pcall(function()
        humanoid.Health = 100
        print("[Farm Token] Đã hồi sinh: " .. player.Name)
        ShowNotification("❤️ Đã cứu!", "Đã hồi sinh " .. player.Name, 3, Color3.fromRGB(0, 255, 0))
        
        -- Xóa Downed state
        local downed = targetChar:FindFirstChild("Downed")
        if downed then
            downed:Destroy()
        end
        
        return true
    end)
    
    return false
end

-- Farm Token Loop
local function FarmTokenLoop()
    if not FarmToken then return end
    
    if tick() - FarmTokenCooldown < 1 then
        return
    end
    
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character then return end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    -- Tìm người chơi bị hạ gục
    local downedPlayer = FindDownedPlayer()
    
    if downedPlayer then
        print("[Farm Token] Tìm thấy người bị hạ gục: " .. downedPlayer.Name)
        
        -- Kiểm tra bot gần người đó
        local targetChar = downedPlayer.Character
        if targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
            local targetPos = targetChar.HumanoidRootPart.Position
            
            if not IsBotNearPositionToken(targetPos, 50) then
                -- Không có bot gần -> carry và cứu
                CarryPlayer(downedPlayer)
                wait(0.3)
                
                -- Teleport lên vị trí an toàn
                local safePos = FindSafePositionToken()
                rootPart.CFrame = CFrame.new(safePos)
                print("[Farm Token] Teleport lên vị trí an toàn: " .. tostring(safePos))
                
                wait(0.2)
                
                -- Cứu người chơi
                ResurrectPlayer(downedPlayer)
                
                -- Thả người chơi
                pcall(function()
                    local humanoid = character:FindFirstChild("Humanoid")
                    if humanoid then
                        humanoid:DropCarry()
                        IsCarrying = false
                        CarriedPlayer = nil
                        print("[Farm Token] Đã thả người chơi")
                    end
                end)
                
                FarmTokenCooldown = tick()
                return
            else
                print("[Farm Token] Có bot gần người bị hạ gục, đợi...")
                -- Teleport lên tường an toàn chờ
                if SafeWall then
                    local wallPos = SafeWall.Position + Vector3.new(0, 1, 0)
                    rootPart.CFrame = CFrame.new(wallPos)
                    ShowNotification("⚠️ Chờ bot", "Bot gần người bị hạ gục, đợi bot đi xa", 2, Color3.fromRGB(255, 200, 0))
                end
                FarmTokenCooldown = tick()
                return
            end
        end
    else
        -- Không có ai bị hạ gục -> ở tường
        if SafeWall then
            local wallPos = SafeWall.Position + Vector3.new(0, 1, 0)
            if (rootPart.Position - wallPos).Magnitude > 10 then
                rootPart.CFrame = CFrame.new(wallPos)
                print("[Farm Token] Không có ai bị hạ gục, về tường")
            end
        end
        FarmTokenCooldown = tick()
    end
end

