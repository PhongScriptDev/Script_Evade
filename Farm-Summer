local function CreateESPPlayers()
    for _, v in ipairs(ESPObjects) do pcall(function() v:Destroy() end) end
    ESPObjects = {}
    if not ESPPlayers then return end
    local LocalPlayer = game.Players.LocalPlayer
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    for _, player in ipairs(game.Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local enemy = player.Character
            if enemy and enemy:FindFirstChild("HumanoidRootPart") then
                local humanoid = enemy:FindFirstChild("Humanoid")
                if not humanoid then return end
                local isDowned = false
                local isDead = false
                if humanoid.Health <= 0 then
                    if enemy:FindFirstChild("Downed") then isDowned = true
                    else isDead = true end
                end
                if isDead then continue end
                local pos = enemy.HumanoidRootPart.Position
                local dist = (root.Position - pos).Magnitude
                if dist < 150 then
                    local billboard = Instance.new("BillboardGui")
                    billboard.Name = "ESPPlayer"
                    billboard.Size = UDim2.new(0, 200, 0, 50)
                    billboard.Adornee = enemy.HumanoidRootPart
                    billboard.StudsOffset = Vector3.new(0, 4, 0)
                    billboard.AlwaysOnTop = true
                    billboard.Parent = enemy.HumanoidRootPart
                    local frame = Instance.new("Frame")
                    frame.Size = UDim2.new(1, 0, 1, 0)
                    frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                    frame.BackgroundTransparency = 0.5
                    frame.BorderSizePixel = 0
                    frame.Parent = billboard
                    local nameLabel = Instance.new("TextLabel")
                    nameLabel.Size = UDim2.new(1, 0, 0.5, 0)
                    nameLabel.Position = UDim2.new(0, 0, 0, 0)
                    nameLabel.Text = isDowned and "💀 " .. player.Name or "👤 " .. player.Name
                    nameLabel.TextColor3 = isDowned and Color3.fromRGB(255, 0, 0) or GetRainbowColor(0)
                    nameLabel.TextSize = 14
                    nameLabel.BackgroundTransparency = 1
                    nameLabel.Parent = frame
                    local distLabel = Instance.new("TextLabel")
                    distLabel.Size = UDim2.new(1, 0, 0.5, 0)
                    distLabel.Position = UDim2.new(0, 0, 0.5, 0)
                    distLabel.Text = string.format("📏 %.1f mét | %s", dist, isDowned and "⚠️ BỊ GỤC" or "🟢 Sống")
                    distLabel.TextColor3 = isDowned and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(0, 255, 0)
                    distLabel.TextSize = 12
                    distLabel.BackgroundTransparency = 1
                    distLabel.Parent = frame
                    table.insert(ESPObjects, billboard)
                    table.insert(ESPObjects, frame)
                    table.insert(ESPObjects, nameLabel)
                    table.insert(ESPObjects, distLabel)
                end
            end
        end
    end
end

