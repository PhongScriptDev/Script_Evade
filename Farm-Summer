-- CHỐNG NEXTBOT
-- =============================================
local AntiNextBot = false
local TeleportConnection = nil
local SkyPositions = {}
local CurrentSkyPos = nil
local IsSpecialRound = false
local BotPositions = {}

-- Tạo vị trí trên trời
local function GenerateSkyPositions()
    SkyPositions = {}
    for i = 1, 50 do
        local x = math.random(-350, 350)
        local z = math.random(-350, 350)
        local y = math.random(200, 450)
        table.insert(SkyPositions, Vector3.new(x, y, z))
    end
end

-- Kiểm tra vị trí an toàn
local function IsPositionSafe(position, minDistance)
    local LocalPlayer = game.Players.LocalPlayer
    
    for _, player in ipairs(game.Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local enemyChar = player.Character
            if enemyChar and enemyChar:FindFirstChild("HumanoidRootPart") then
                local enemyPos = enemyChar.HumanoidRootPart.Position
                local dist = (position - enemyPos).Magnitude
                if dist < minDistance then
                    return false
                end
            end
        end
    end
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("HumanoidRootPart") then
            local name = obj.Name:lower()
            if name:find("bot") or name:find("next") or name:find("npc") or name:find("enemy") then
                local enemyPos = obj.HumanoidRootPart.Position
                local dist = (position - enemyPos).Magnitude
                if dist < minDistance then
                    return false
                end
            end
        end
    end
    
    return true
end

-- Dịch chuyển lên trời
local function TeleportToSky()
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character then return end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    if #SkyPositions == 0 then
        GenerateSkyPositions()
    end
    
    local safePos = nil
    local attempts = 0
    
    while safePos == nil and attempts < 20 do
        attempts = attempts + 1
        local randomPos = SkyPositions[math.random(1, #SkyPositions)]
        
        if IsPositionSafe(randomPos, 50) then
            safePos = randomPos
            break
        else
            table.remove(SkyPositions, table.find(SkyPositions, randomPos))
            if #SkyPositions == 0 then
                GenerateSkyPositions()
            end
        end
    end
    
    if not safePos then
        safePos = Vector3.new(
            math.random(-300, 300),
            math.random(250, 450),
            math.random(-300, 300)
        )
    end
    
    rootPart.CFrame = CFrame.new(safePos)
    CurrentSkyPos = safePos
    
    local humanoid = character:FindFirstChild("Humanoid")
    if humanoid then
        humanoid.PlatformStand = false
    end
end

-- Dịch chuyển khẩn cấp
local function EmergencyTeleport()
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character then return end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    local safePos = Vector3.new(
        math.random(-400, 400),
        math.random(300, 500),
        math.random(-400, 400)
    )
    
    rootPart.CFrame = CFrame.new(safePos)
    CurrentSkyPos = safePos
    
    print("[NextBot] Dịch chuyển khẩn cấp!")
end

-- Kiểm tra và phản ứng
local function CheckAndReact()
    if not AntiNextBot then return end
    
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character then return end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    local currentPos = rootPart.Position
    
    -- Nếu ở dưới đất -> dịch chuyển lên trời
    if currentPos.Y < 50 then
        TeleportToSky()
        return
    end
    
    -- Kiểm tra bot gần
    local botNearby = false
    local nearestDist = math.huge
    
    for _, player in ipairs(game.Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local enemyChar = player.Character
            if enemyChar and enemyChar:FindFirstChild("HumanoidRootPart") then
                local dist = (currentPos - enemyChar.HumanoidRootPart.Position).Magnitude
                if dist < nearestDist then
                    nearestDist = dist
                end
                if dist < 45 then
                    botNearby = true
                    break
                end
            end
        end
    end
    
    if botNearby then
        print("[NextBot] Phát hiện bot gần! Dịch chuyển...")
        EmergencyTeleport()
        return
    end
    
    -- Dịch chuyển định kỳ
    local currentTime = tick()
    local interval = IsSpecialRound and 3 or 5
    
    if not character:FindFirstChild("LastTeleportTime") then
        local timeVal = Instance.new("NumberValue")
        timeVal.Name = "LastTeleportTime"
        timeVal.Value = currentTime
        timeVal.Parent = character
    else
        local lastTime = character.LastTeleportTime.Value
        if currentTime - lastTime > interval then
            TeleportToSky()
            character.LastTeleportTime.Value = currentTime
        end
    end
end

-- Kiểm tra vòng đặc biệt
local function CheckSpecialRound()
    local gameState = workspace:FindFirstChild("GameState")
    if gameState then
        local stateText = tostring(gameState.Value or "")
        if stateText:lower():find("special") or stateText:lower():find("boss") then
            IsSpecialRound = true
        else
            IsSpecialRound = false
        end
    end
end

