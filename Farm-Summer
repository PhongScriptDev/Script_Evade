-- =============================================
-- HÀM TÌM VẬT PHẨM SỰ KIỆN (KHÔNG CẦN TÊN)
-- =============================================
local function FindEventItems()
    local items = {}
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character then return items end
    local rootPos = character:FindFirstChild("HumanoidRootPart")
    if not rootPos then return items end
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        local isEventItem = false
        local position = nil
        
        -- CÁCH 1: ClickDetector
        if obj:FindFirstChild("ClickDetector") then
            if not obj:IsDescendantOf(character) then
                isEventItem = true
            end
        end
        
        -- CÁCH 2: ProximityPrompt
        if not isEventItem then
            if obj:FindFirstChild("ProximityPrompt") then
                if not obj:IsDescendantOf(character) then
                    isEventItem = true
                end
            end
        end
        
        -- CÁCH 3: Attribute
        if not isEventItem then
            local attrs = {"Collectible", "EventItem", "Pickup", "Collectable", "Currency", "Reward", "Item"}
            for _, attr in ipairs(attrs) do
                if obj:GetAttribute(attr) then
                    isEventItem = true
                    break
                end
            end
        end
        
        -- NẾU LÀ VẬT PHẨM EVENT -> LẤY VỊ TRÍ
        if isEventItem then
            if obj:IsA("BasePart") then
                position = obj.Position
            elseif obj:IsA("Model") then
                if obj:FindFirstChild("PrimaryPart") then
                    position = obj.PrimaryPart.Position
                elseif obj:FindFirstChild("HumanoidRootPart") then
                    position = obj.HumanoidRootPart.Position
                elseif obj:FindFirstChild("Head") then
                    position = obj.Head.Position
                else
                    local sumPos = Vector3.new(0, 0, 0)
                    local count = 0
                    for _, part in ipairs(obj:GetChildren()) do
                        if part:IsA("BasePart") then
                            sumPos = sumPos + part.Position
                            count = count + 1
                        end
                    end
                    if count > 0 then position = sumPos / count end
                end
            end
            
            if position then
                table.insert(items, {
                    object = obj,
                    position = position,
                    name = obj.Name,
                    distance = (rootPos.Position - position).Magnitude
                })
            end
        end
    end
    
    table.sort(items, function(a, b)
        return a.distance < b.distance
    end)
    
    return items
end

-- =============================================
-- LOG FUNCTIONS
-- =============================================
local function UpdateEventLog(message)
    EventLogIndex = EventLogIndex + 1
    table.insert(EventLogLines, "[" .. os.date("%H:%M:%S") .. "] " .. message)
    if #EventLogLines > 5 then
        table.remove(EventLogLines, 1)
    end
    if EventLog then
        EventLog:Set(table.concat(EventLogLines, "\n"))
    end
end

local function UpdateLVLog(message)
    LVLogIndex = LVLogIndex + 1
    table.insert(LVLogLines, "[" .. os.date("%H:%M:%S") .. "] " .. message)
    if #LVLogLines > 5 then
        table.remove(LVLogLines, 1)
    end
    if LVLog then
        LVLog:Set(table.concat(LVLogLines, "\n"))
    end
end

-- =============================================
-- TƯỜNG AN TOÀN
-- =============================================
local function FindSafeWallPosition()
    local mapCenter = Vector3.new(0, 0, 0)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Part") and obj.Size.Magnitude > 100 then
            mapCenter = obj.Position
            break
        end
    end
    return Vector3.new(mapCenter.X - 400, math.random(250, 400), mapCenter.Z + math.random(-100, 100))
end

local function CreateSafeWall(position)
    if SafeWall then SafeWall:Destroy() end
    SafeWall = Instance.new("Part")
    SafeWall.Name = "SafeWall_Private"
    SafeWall.Size = Vector3.new(50, 2, 50)
    SafeWall.CFrame = CFrame.new(position)
    SafeWall.Anchored = true
    SafeWall.CanCollide = true
    SafeWall.Transparency = 0.2
    SafeWall.Material = Enum.Material.Glass
    SafeWall.Locked = true
    SafeWall.Color = Color3.fromRGB(0, 200, 255)
    SafeWall.Parent = workspace
    WallPosition = position
end

local function TeleportToWall()
    if not SafeWall then return false end
    local char = game.Players.LocalPlayer.Character
    if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    root.CFrame = CFrame.new(SafeWall.Position + Vector3.new(0, 1, 0))
    IsAtWall = true
    return true
end

local function TeleportToItem(targetPos)
    local char = game.Players.LocalPlayer.Character
    if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    root.CFrame = CFrame.new(targetPos)
    IsAtWall = false
    return true
end

-- =============================================
-- FARM LOOP CHÍNH
-- =============================================
local function FarmLoop()
    if not AutoFarm then return end
    
    FarmLoopCount = FarmLoopCount + 1
    if FarmLoopCount % 3 ~= 0 then return end
    if tick() - FarmCooldown < 0.5 then return end
    
    local LocalPlayer = game.Players.LocalPlayer
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    if char:GetAttribute("Downed") then
        UpdateEventLog("⚠️ Downed, cannot farm...")
        FarmCooldown = tick()
        return
    end
    
    local gameState = workspace:FindFirstChild("GameState")
    if gameState then
        local stateText = tostring(gameState.Value or "")
        if stateText:lower():find("voting") or stateText:lower():find("paused") then
            if not IsAtWall then
                TeleportToWall()
                UpdateEventLog("⏸️ Map paused, waiting on wall...")
            end
            FarmCooldown = tick()
            return
        end
    end
    
    local items = FindEventItems()
    TotalItems = #items
    
    if TotalItems == 0 then
        if not IsAtWall then
            TeleportToWall()
            UpdateEventLog("🔍 No event items found, waiting on wall...")
        end
        FarmCooldown = tick()
        return
    end
    
    local currentPos = root.Position
    local nearestItem = items[1]
    
    if not nearestItem then
        FarmCooldown = tick()
        return
    end
    
    if IsAtWall then
        UpdateEventLog("🎈 Found event item! Teleporting...")
        TeleportToItem(nearestItem.position)
        FarmCooldown = tick()
        return
    end
    
    if not IsAtWall then
        local distToItem = (currentPos - nearestItem.position).Magnitude
        if distToItem < 10 then
            pcall(function()
                local clickDetector = nearestItem.object:FindFirstChild("ClickDetector")
                if clickDetector then clickDetector:FireClick() end
                local proximityPrompt = nearestItem.object:FindFirstChild("ProximityPrompt")
                if proximityPrompt then proximityPrompt:Fire() end
                CollectedCount = CollectedCount + 1
                UpdateEventLog("✅ Collected Item #" .. CollectedCount .. " (" .. nearestItem.name .. ")")
            end)
            TeleportToWall()
            UpdateEventLog("📍 Back to wall, waiting for next...")
            FarmCooldown = tick()
        else
            UpdateEventLog("🎈 Teleporting to event item...")
            TeleportToItem(nearestItem.position)
            FarmCooldown = tick()
        end
        return
    end
end

