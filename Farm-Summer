local function FindSafeWallPosition()
    local mapCenter = Vector3.new(0, 0, 0)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Part") and obj.Size.Magnitude > 100 then
            mapCenter = obj.Position
            break
        end
    end
    return Vector3.new(
        mapCenter.X - 400,
        math.random(250, 400),
        mapCenter.Z + math.random(-100, 100)
    )
end

local function CreateSafeWall(position)
    if SafeWall then SafeWall:Destroy() end
    SafeWall = Instance.new("Part")
    SafeWall.Name = "SafeWall_Private"
    SafeWall.Size = Vector3.new(50, 2, 50)
    SafeWall.CFrame = CFrame.new(position)
    SafeWall.Anchored = true
    SafeWall.CanCollide = true
    SafeWall.Transparency = 0.2
    SafeWall.Material = Enum.Material.Glass
    SafeWall.Locked = true
    SafeWall.Color = Color3.fromRGB(0, 200, 255)
    SafeWall.Parent = workspace
    WallPosition = position
    if WallConnection then WallConnection:Disconnect() end
    WallConnection = game:GetService("RunService").Heartbeat:Connect(function()
        pcall(function()
            if not SafeWall then return end
            local char = game.Players.LocalPlayer.Character
            if not char then return end
            local root = char:FindFirstChild("HumanoidRootPart")
            if not root then return end
            if root.Position.Y < WallPosition.Y - 5 then
                root.CFrame = CFrame.new(WallPosition + Vector3.new(0, 1, 0))
            end
        end)
    end)
end

local function UpdateWallForNewMap()
    local newMapName = workspace:FindFirstChild("Map") and workspace.Map.Name or "Unknown"
    if newMapName ~= CurrentMapName then
        CurrentMapName = newMapName
        CreateSafeWall(FindSafeWallPosition())
        ShowNotification("📍 Đổi map!", "Tường đã được cập nhật", 2)
    end
end

local function TeleportToWall()
    if not SafeWall then CreateSafeWall(FindSafeWallPosition()) end
    if not SafeWall then return false end
    local char = game.Players.LocalPlayer.Character
    if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    local wallPos = SafeWall.Position + Vector3.new(0, 1, 0)
    root.CFrame = CFrame.new(wallPos)
    IsAtWall = true
    return true
end

