local function CreateSafeWall(position)
    if SafeWall then
        SafeWall:Destroy()
        SafeWall = nil
    end
    
    -- Tạo tường rộng hơn (30x30)
    SafeWall = Instance.new("Part")
    SafeWall.Name = "SafeWall_Private"
    SafeWall.Size = Vector3.new(30, 1, 30)
    SafeWall.CFrame = CFrame.new(position)
    SafeWall.Anchored = true
    SafeWall.CanCollide = true
    SafeWall.Transparency = 0.3 -- Hơi trong suốt nhưng vẫn thấy
    SafeWall.Material = Enum.Material.Glass
    SafeWall.Locked = true
    SafeWall.Color = Color3.fromRGB(0, 200, 255) -- Màu xanh dương để dễ thấy
    
    -- Chỉ người dùng script mới thấy và va chạm
    SafeWall.Parent = game:GetService("Workspace")
    
    WallPosition = position
    print("[SafeWall] Đã tạo tường tại: " .. tostring(position))
    
    -- Theo dõi nhân vật để giữ trên tường
    if WallConnection then
        WallConnection:Disconnect()
        WallConnection = nil
    end
    
    WallConnection = game:GetService("RunService").Heartbeat:Connect(function()
        pcall(function()
            if not SafeWall then return end
            local LocalPlayer = game.Players.LocalPlayer
            local character = LocalPlayer.Character
            if not character then return end
            
            local rootPart = character:FindFirstChild("HumanoidRootPart")
            if not rootPart then return end
            
            local currentPos = rootPart.Position
            
            if currentPos.Y < WallPosition.Y - 5 then
                rootPart.CFrame = CFrame.new(WallPosition + Vector3.new(0, 0.5, 0))
                print("[SafeWall] Teleport lại lên tường")
            end
        end)
    end)
end

-- Tìm vị trí tường: XA MAP, TRÊN TRÁI
local function FindSafeWallPosition()
    local mapCenter = Vector3.new(0, 0, 0)
    
    -- Tìm center của map
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Part") and obj.Size.Magnitude > 100 then
            mapCenter = obj.Position
            break
        end
    end
    
    -- Vị trí tường: xa map về bên trái, trên cao
    local safePos = Vector3.new(
        mapCenter.X - 400, -- Xa về bên trái
        math.random(250, 400), -- Trên cao
        mapCenter.Z + math.random(-100, 100) -- Hơi lệch Z
    )
    
    return safePos
end

