-- CHỐNG GỤC
-- =============================================
local AntiDied = false
local DeathCheckConnection = nil

-- Kiểm tra bị gục
local function IsPlayerDowned(character)
    if not character then return false end
    
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid then return false end
    
    if humanoid.Health <= 0 then
        local downedState = character:FindFirstChild("Downed")
        if downedState then
            return true
        end
        
        local torso = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
        if torso and humanoid:GetState() == Enum.HumanoidStateType.Physics then
            return true
        end
    end
    
    return false
end

-- Kiểm tra chết hẳn
local function IsPlayerDead(character)
    if not character then return true end
    
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid then return true end
    
    if humanoid.Health <= 0 then
        if character:FindFirstChild("Downed") then
            return false
        end
        
        if character:FindFirstChild("DeathAnim") then
            return true
        end
        
        if humanoid:GetState() == Enum.HumanoidStateType.Dead then
            return true
        end
    end
    
    return false
end

-- Hồi sinh
local function RevivePlayer()
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    
    if not character then
        return
    end
    
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid then
        return
    end
    
    -- Dịch chuyển lên trời
    pcall(function()
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if rootPart then
            local pos = Vector3.new(
                math.random(-300, 300),
                math.random(250, 450),
                math.random(-300, 300)
            )
            rootPart.CFrame = CFrame.new(pos)
        end
    end)
    
    -- Hồi máu
    pcall(function()
        humanoid.Health = 100
    end)
    
    -- Xóa trạng thái gục
    pcall(function()
        local downed = character:FindFirstChild("Downed")
        if downed then
            downed:Destroy()
        end
    end)
    
    -- Đứng dậy
    pcall(function()
        humanoid.Sit = false
        humanoid.PlatformStand = false
    end)
    
    -- Nếu vẫn chết thì respawn
    wait(0.2)
    if humanoid.Health <= 0 then
        LocalPlayer:LoadCharacter()
    end
end

-- Bắt đầu kiểm tra
local function StartDeathCheck()
    if DeathCheckConnection then
        DeathCheckConnection:Disconnect()
    end
    
    DeathCheckConnection = game:GetService("RunService").Heartbeat:Connect(function()
        if AntiDied then
            local LocalPlayer = game.Players.LocalPlayer
            local character = LocalPlayer.Character
            
            if character then
                local humanoid = character:FindFirstChild("Humanoid")
                if humanoid then
                    local isDowned = IsPlayerDowned(character)
                    local isDead = IsPlayerDead(character)
                    
                    if isDowned then
                        RevivePlayer()
                    elseif isDead then
                        RevivePlayer()
                    end
                end
            end
        end
    end)
end

