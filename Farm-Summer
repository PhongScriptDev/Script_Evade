local function UpdateAllLabels()
    pcall(function()
        local elapsed = math.floor(tick() - StartTime)
        local hours = math.floor(elapsed / 3600)
        local minutes = math.floor((elapsed % 3600) / 60)
        local seconds = elapsed % 60
        local timeStr = string.format("%02d:%02d:%02d", hours, minutes, seconds)
        local timeInfo, dateInfo, period, zodiac = GetTimeInfo()
        TimeLabel:Set("⏰ Giờ: " .. timeInfo .. " | " .. dateInfo .. " | " .. period .. " | Năm " .. zodiac)
        RuntimeLabel:Set("🚀 Đã chạy: " .. timeStr)
        local afkHours = math.floor(AFKTime / 3600)
        local afkMinutes = math.floor((AFKTime % 3600) / 60)
        local afkSeconds = math.floor(AFKTime % 60)
        AFKLabel:Set("🛌 AFK: " .. string.format("%02d:%02d:%02d", afkHours, afkMinutes, afkSeconds))
        local LocalPlayer = game.Players.LocalPlayer
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local pos = char.HumanoidRootPart.Position
            PositionLabel:Set(string.format("📍 Vị trí: X: %.1f | Y: %.1f | Z: %.1f", pos.X, pos.Y, pos.Z))
        end
        local stats = LocalPlayer:FindFirstChild("leaderstats")
        if stats then
            local level = stats:FindFirstChild("Level")
            local exp = stats:FindFirstChild("Exp") or stats:FindFirstChild("Experience")
            if level then
                CurrentLevel = level.Value
                LevelLabel:Set("⭐ Level hiện tại: " .. CurrentLevel)
            end
            if exp then
                CurrentExp = exp.Value
                ExpLabel:Set("✨ Exp hiện tại: " .. CurrentExp)
            end
        end
        UpdateRoundInfo()
        RoundStatusLabel:Set("🔄 Trạng thái map: " .. MapStatus)
        if RoundTimeLeft > 0 then
            local rHours = math.floor(RoundTimeLeft / 3600)
            local rMinutes = math.floor((RoundTimeLeft % 3600) / 60)
            local rSeconds = math.floor(RoundTimeLeft % 60)
            RoundInfoLabel:Set("⏳ The loop is running: " .. string.format("%02d:%02d:%02d", rHours, rMinutes, rSeconds) .. " | Ring type: " .. RoundType)
        else
            RoundInfoLabel:Set("⏳ The loop is running: 00:00:00 | Ring type: " .. RoundType)
        end
    end)
end

