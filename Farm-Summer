-- Tạo danh sách vị trí an toàn trong map
local function GenerateSafePositions()
    SafePositions = {}
    for i = 1, 50 do
        local pos = Vector3.new(
            math.random(-180, 180),
            math.random(60, 180),
            math.random(-180, 180)
        )
        table.insert(SafePositions, pos)
    end
end

-- Kiểm tra vị trí có an toàn không (không có bot)
local function IsPositionSafe(pos)
    local LocalPlayer = game.Players.LocalPlayer
    
    -- Kiểm tra player
    for _, player in ipairs(game.Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local enemy = player.Character
            if enemy and enemy:FindFirstChild("HumanoidRootPart") then
                local dist = (pos - enemy.HumanoidRootPart.Position).Magnitude
                if dist < 55 then
                    return false
                end
            end
        end
    end
    
    -- Kiểm tra NPC bot
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("HumanoidRootPart") then
            local name = obj.Name:lower()
            if name:find("bot") or name:find("next") or name:find("npc") then
                local dist = (pos - obj.HumanoidRootPart.Position).Magnitude
                if dist < 55 then
                    return false
                end
            end
        end
    end
    
    return true
end

-- Tìm vị trí an toàn nhất
local function FindSafestPosition()
    -- Tạo danh sách nếu chưa có
    if #SafePositions == 0 then
        GenerateSafePositions()
    end
    
    -- Xáo trộn để random
    for i = #SafePositions, 2, -1 do
        local j = math.random(i)
        SafePositions[i], SafePositions[j] = SafePositions[j], SafePositions[i]
    end
    
    -- Tìm vị trí an toàn
    for _, pos in ipairs(SafePositions) do
        if IsPositionSafe(pos) then
            return pos
        end
    end
    
    -- Fallback: tạo mới
    for attempt = 1, 30 do
        local pos = Vector3.new(
            math.random(-180, 180),
            math.random(60, 180),
            math.random(-180, 180)
        )
        if IsPositionSafe(pos) then
            return pos
        end
    end
    
    return Vector3.new(0, 120, 0)
end

-- Kiểm tra vòng đặc biệt
local function CheckSpecialRound()
