local function CollectItemWithRetry(item)
    if not item or IsCollecting then return false end
    IsCollecting = true
    local success = false
    local attempt = 0
    local maxAttempts = 3
    local beforeCurrency = GetCurrentCurrency()
    while attempt < maxAttempts and not success do
        attempt = attempt + 1
        StopEmote()
        if item.clickDetector then
            pcall(function() item.clickDetector:FireClick() success = true end)
        end
        if not success and item.proximityPrompt then
            pcall(function() item.proximityPrompt:Fire() success = true end)
        end
        if success then break end
        if attempt < maxAttempts then
            local char = game.Players.LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                char.HumanoidRootPart.CFrame = CFrame.new(item.position + Vector3.new(0, 0.5, 0))
                wait(0.1)
            end
        end
    end
    local afterCurrency = GetCurrentCurrency()
    local gained = afterCurrency - beforeCurrency
    if success and gained > 0 then
        CollectedCount = CollectedCount + gained
        CurrentCurrency = afterCurrency
        SendNotification("🔔 Thông báo nhận vật phẩm sự kiện!", "❓ Vật phẩm nhận được: " .. gained, 2.5)
        SendNotification("🔔 Thông báo vật phẩm sự kiện...", "📌 Vật phẩm hiện tại của bạn là: " .. afterCurrency, 2.5)
        CurrentCurrencyLabel:Set("💰 Current currency: " .. afterCurrency)
        RetryCount = 0
        IsCollecting = false
        return true
    end
    local stillExists = false
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj == item.object then
            stillExists = true
            break
        end
    end
    if not stillExists then
        if afterCurrency > beforeCurrency then
            CollectedCount = CollectedCount + (afterCurrency - beforeCurrency)
            CurrentCurrency = afterCurrency
            CurrentCurrencyLabel:Set("💰 Current currency: " .. afterCurrency)
            SendNotification("🔔 Thông báo nhận vật phẩm sự kiện!", "❓ Vật phẩm nhận được: " .. (afterCurrency - beforeCurrency), 2.5)
            SendNotification("🔔 Thông báo vật phẩm sự kiện...", "📌 Vật phẩm hiện tại của bạn là: " .. afterCurrency, 2.5)
            IsCollecting = false
            return true
        end
    end
    IsCollecting = false
    return false
end

local function ScanGameForEvent()
    local found = false
    local name = "Unknown"
    local timeLeft = "Unknown"
    local source = "none"
    local LocalPlayer = game.Players.LocalPlayer
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        for _, gui in ipairs(playerGui:GetDescendants()) do
            if gui:IsA("TextLabel") or gui:IsA("TextButton") or gui:IsA("Frame") then
                local text = gui.Text or ""
                local textLower = text:lower()
                local eventKeywords = {
                    "sự kiện", "event", "summer", "halloween", "christmas", 
                    "valentine", "easter", "spring", "fall", "winter", "newyear",
                    "festival", "mùa hè", "giáng sinh", "lễ hội",
                    "bubble", "coconut", "candy", "gift", "present", "coin",
                    "token", "collect", "reward", "currency"
                }
                for _, keyword in ipairs(eventKeywords) do
                    if textLower:find(keyword) then
                        found = true
                        name = text
                        source = "menu"
                        break
                    end
                end
                if textLower:find("ngày") or textLower:find("còn lại") or textLower:find("remaining") then
                    if text:match("%d+") then
                        timeLeft = text
                    end
                end
                if found then break end
            end
        end
    end
    if not found then
        for _, obj in ipairs(workspace:GetDescendants()) do
            local nameLower = obj.Name:lower()
            if nameLower:find("event") or nameLower:find("summer") or 
               nameLower:find("halloween") or nameLower:find("christmas") or
               nameLower:find("festival") then
                found = true
                name = obj.Name
                source = "map"
                break
            end
        end
    end
    return found, name, timeLeft, source
end

