-- HÀM TÌM VẬT PHẨM (TỐI ƯU)
-- =============================================
local function FindEventItems()
    local items = {}
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character then return items end
    local rootPos = character:FindFirstChild("HumanoidRootPart")
    if not rootPos then return items end
    
    local activeItems = GetActiveItems()
    if #activeItems == 0 then
        return items
    end
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsDescendantOf(character) then continue end
        
        local objName = obj.Name or ""
        local isMatch = false
        
        for _, itemName in ipairs(activeItems) do
            if objName:lower():find(itemName:lower()) then
                isMatch = true
                break
            end
        end
        
        if isMatch then
            local position = nil
            
            if obj:IsA("BasePart") then
                position = obj.Position
            elseif obj:IsA("Model") then
                if obj:FindFirstChild("PrimaryPart") then
                    position = obj.PrimaryPart.Position
                elseif obj:FindFirstChild("HumanoidRootPart") then
                    position = obj.HumanoidRootPart.Position
                elseif obj:FindFirstChild("Head") then
                    position = obj.Head.Position
                else
                    local sumPos = Vector3.new(0, 0, 0)
                    local count = 0
                    for _, part in ipairs(obj:GetChildren()) do
                        if part:IsA("BasePart") then
                            sumPos = sumPos + part.Position
                            count = count + 1
                        end
                    end
                    if count > 0 then position = sumPos / count end
                end
            end
            
            if position then
                local clickDetector = obj:FindFirstChild("ClickDetector")
                local proximityPrompt = obj:FindFirstChild("ProximityPrompt")
                
                table.insert(items, {
                    object = obj,
                    position = position,
                    distance = (rootPos.Position - position).Magnitude,
                    clickDetector = clickDetector,
                    proximityPrompt = proximityPrompt,
                    name = objName
                })
            end
        end
    end
    
    table.sort(items, function(a, b)
        return a.distance < b.distance
    end)
    
    return items
end

-- =============================================
-- KIỂM TRA TRẠNG THÁI MAP
-- =============================================
local function CheckMapState()
    local gameState = workspace:FindFirstChild("GameState")
    if gameState then
        local stateText = tostring(gameState.Value or "")
        
        if stateText:lower():find("voting") or stateText:lower():find("bình chọn") then
            if not IsWaitingForVote then
                IsWaitingForVote = true
                SendNotification("⏳ Đang bình chọn!", "Chờ hết thời gian bình chọn...", 3)
            end
            return true, "voting"
        end
        
        if stateText:lower():find("paused") or stateText:lower():find("tạm dừng") then
            if not IsWaitingForPause then
                IsWaitingForPause = true
                SendNotification("⏸️ Đang tạm dừng!", "Chờ game tiếp tục...", 3)
            end
            return true, "paused"
        end
        
        if IsWaitingForVote or IsWaitingForPause then
            IsWaitingForVote = false
            IsWaitingForPause = false
            SendNotification("✅ Tiếp tục!", "Đã hết thời gian chờ!", 2)
        end
    end
    
    return false, "running"
end

