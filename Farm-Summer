                if AutoFarm then 
                    pcall(FarmLoop) 
                end
            end)
            print("[Farm] Auto Farm đã bật thành công!")
        else
            print("[Farm] Đang tắt Auto Farm...")
            if FarmConnection then 
                FarmConnection:Disconnect() 
