                if dist < radius then
                    return true
                end
            end
        end
    end
    
    return false
end

-- FARM LOOP
local function FarmLoop()
    if not AutoFarm then return end
    
    if tick() - FarmCooldown < 0.5 then
        return
    end
    
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character then return end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    local currentPos = rootPart.Position
    
    if #AllBubbles == 0 or CurrentIndex > #AllBubbles then
        ScanAllBubbles()
        CurrentIndex = 1
        if #AllBubbles == 0 then
            if not IsAtWall then
                TeleportToWall()
                ShowNotification("📍 Về tường", "Không có Bubble, đang về tường", 2, Color3.fromRGB(0, 200, 255))
            end
            FarmCooldown = tick()
            return
        end
        ShowNotification("🎈 Đã quét!", "Tìm thấy " .. #AllBubbles .. " Bubble trong map", 3, Color3.fromRGB(0, 255, 255))
    end
    
    local target = nil
    for i = CurrentIndex, #AllBubbles do
        if not AllBubbles[i].collected then
            target = AllBubbles[i]
            CurrentIndex = i
            break
        end
    end
    
    if not target then
        if not IsAtWall then
            TeleportToWall()
            ShowNotification("📍 Về tường", "Đã nhặt hết Bubble!", 2, Color3.fromRGB(0, 200, 255))
        end
        CurrentIndex = #AllBubbles + 1
        FarmCooldown = tick()
        return
    end
    
    if IsBotNearPosition(target.position, 60) then
        print("[AutoFarm] Bot gần Bubble, chờ...")
        if not IsAtWall then
            TeleportToWall()
            ShowNotification("⚠️ Chờ bot", "Bot gần Bubble, đợi bot đi xa", 2, Color3.fromRGB(255, 200, 0))
        end
        FarmCooldown = tick()
        return
    end
    
    IsAtWall = false
    TeleportToBubble(target.position)
    print("[AutoFarm] Teleport đến Bubble #" .. CurrentIndex)
    ShowNotification("🎈 Teleport!", "Đang đến Bubble #" .. CurrentIndex, 1.5, Color3.fromRGB(255, 200, 0))
    
    wait(0.1)
    CollectBubble(target)
    
    wait(0.1)
    TeleportToWall()
    print("[AutoFarm] Đã nhặt xong, teleport lên tường")
    
    CurrentIndex = CurrentIndex + 1
    FarmCooldown = tick()
end

