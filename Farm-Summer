local function SendNotification(title, content, duration)
    duration = duration or 2.5
    if tick() - LastNotifyTime < 0.3 then return end
    LastNotifyTime = tick()
    pcall(function()
        Rayfield:Notify({
            Title = title,
            Content = content,
            Duration = duration,
            Image = 0
        })
    end)
end

