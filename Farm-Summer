local AntiNextBot = false
local TeleportConnection = nil
local IsSpecialRound = false

local function TeleportToSky()
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character then return end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    local safePos = Vector3.new(
        math.random(-180, 180),
        math.random(100, 180),
        math.random(-180, 180)
    )
    
    for attempt = 1, 20 do
        local testPos = Vector3.new(
            math.random(-180, 180),
            math.random(100, 180),
            math.random(-180, 180)
        )
        
        local isSafe = true
        for _, player in ipairs(game.Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local enemy = player.Character
                if enemy and enemy:FindFirstChild("HumanoidRootPart") then
                    local dist = (testPos - enemy.HumanoidRootPart.Position).Magnitude
                    if dist < 50 then
                        isSafe = false
                        break
                    end
                end
            end
        end
        
        if isSafe then
            safePos = testPos
            break
        end
    end
    
    rootPart.CFrame = CFrame.new(safePos)
    
    local humanoid = character:FindFirstChild("Humanoid")
    if humanoid then
        humanoid.PlatformStand = false
        humanoid.Sit = false
    end
end

local function EmergencyTeleport()
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character then return end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    local pos = Vector3.new(
        math.random(-150, 150),
        math.random(120, 180),
        math.random(-150, 150)
    )
    
    rootPart.CFrame = CFrame.new(pos)
    ShowNotification("⚠️ NextBot", "Phát hiện bot gần! Đã teleport!", 2)
end

local function CheckBots()
    if not AntiNextBot then return end
    
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character then return end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    local currentPos = rootPart.Position
    
    if currentPos.Y < 20 then
        TeleportToSky()
        return
    end
    
    if currentPos.Y > 250 then
        TeleportToSky()
        return
    end
    
    local botNear = false
    local nearestDist = math.huge
    
    for _, player in ipairs(game.Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local enemy = player.Character
            if enemy and enemy:FindFirstChild("HumanoidRootPart") then
                local dist = (currentPos - enemy.HumanoidRootPart.Position).Magnitude
                if dist < nearestDist then
                    nearestDist = dist
                end
                if dist < 50 then
                    botNear = true
                    break
                end
            end
        end
    end
    
    if botNear then
        EmergencyTeleport()
        return
    end
    
    local interval = IsSpecialRound and 3 or 5
    if not character:FindFirstChild("LastTeleportTime") then
        local t = Instance.new("NumberValue")
        t.Name = "LastTeleportTime"
        t.Value = tick()
        t.Parent = character
    else
        if tick() - character.LastTeleportTime.Value > interval then
            TeleportToSky()
            character.LastTeleportTime.Value = tick()
        end
    end
end

local function CheckSpecialRound()
    local gameState = workspace:FindFirstChild("GameState")
    if gameState then
        local stateText = tostring(gameState.Value or "")
        if stateText:lower():find("special") or stateText:lower():find("boss") then
            IsSpecialRound = true
        else
            IsSpecialRound = false
        end
    end
end

