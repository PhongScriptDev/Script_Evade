-- Hồi sinh người chơi sau khi dịch chuyển
local function RevivePlayerAfterTeleport(character)
    if not character then
        print("[Chống Gục] Không có nhân vật để hồi sinh!")
        return false
    end
    
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid then
        print("[Chống Gục] Không tìm thấy Humanoid!")
        return false
    end
    
    print("[Chống Gục] Đang hồi sinh...")
    
    pcall(function()
        humanoid.Health = 100
        print("[Chống Gục] Đã hồi máu về 100")
    end)
    
    pcall(function()
        local downedState = character:FindFirstChild("Downed")
        if downedState then
            downedState:Destroy()
            print("[Chống Gục] Đã xóa trạng thái gục")
        end
    end)
    
    pcall(function()
        local deathAnim = character:FindFirstChild("DeathAnim")
        if deathAnim then
            deathAnim:Destroy()
            print("[Chống Gục] Đã xóa animation chết")
        end
    end)
    
    pcall(function()
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
        humanoid.PlatformStand = false
        print("[Chống Gục] Đã reset trạng thái Humanoid")
    end)
    
    pcall(function()
        humanoid.Sit = false
        humanoid.AutoRotate = true
        print("[Chống Gục] Đã bắt nhân vật đứng dậy")
    end)
    
    pcall(function()
        humanoid.WalkSpeed = 16
        humanoid.JumpPower = 50
        print("[Chống Gục] Đã khôi phục di chuyển")
    end)
    
    wait(0.2)
    if humanoid.Health <= 0 then
        print("[Chống Gục] Hồi sinh thất bại! Đang hồi sinh lại...")
        local LocalPlayer = game.Players.LocalPlayer
        LocalPlayer:LoadCharacter()
        
        wait(0.3)
        local newChar = LocalPlayer.Character
        if newChar and newChar:FindFirstChild("HumanoidRootPart") then
            local rootPart = newChar.HumanoidRootPart
            local pos = Vector3.new(
                math.random(-300, 300),
                math.random(250, 450),
                math.random(-300, 300)
            )
            rootPart.CFrame = CFrame.new(pos)
        end
        print("[Chống Gục] Đã hồi sinh lại thành công")
        return true
    end
    
    print("[Chống Gục] Hồi sinh thành công!")
    return true
end

-- Hồi sinh khẩn cấp
local function EmergencyRevive()
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    
    if not character then
        print("[Chống Gục] Không tìm thấy nhân vật để hồi sinh khẩn cấp!")
        return
    end
    
    local isDowned = IsPlayerDowned(character)
    local isDead = IsPlayerFullyDead(character)
    
    if isDowned then
        print("[Chống Gục] KHẨN CẤP: Người chơi đang bị gục!")
        print("[Chống Gục] Loại: GỤC (có thể hồi sinh)")
        
        -- Bước 1: Dịch chuyển lên trời ngay lập tức
        local teleported = TeleportToSafeSky()
        if teleported then
            print("[Chống Gục] Bước 1: Đã dịch chuyển lên trời!")
        end
        
        -- Bước 2: Hồi sinh ngay sau khi dịch chuyển
        wait(0.05)
        local revived = RevivePlayerAfterTeleport(character)
        if revived then
            print("[Chống Gục] Bước 2: Hồi sinh thành công!")
            print("[Chống Gục] TRẠNG THÁI: ĐÃ HỒI SINH")
        end
        
    elseif isDead then
        print("[Chống Gục] KHẨN CẤP: Người chơi đã chết hẳn!")
        print("[Chống Gục] Loại: CHẾT (không thể hồi sinh)")
        
        pcall(function()
            LocalPlayer:LoadCharacter()
            print("[Chống Gục] Đã hồi sinh lại")
        end)
        
        wait(0.3)
        local newChar = LocalPlayer.Character
        if newChar and newChar:FindFirstChild("HumanoidRootPart") then
            local rootPart = newChar.HumanoidRootPart
            local pos = Vector3.new(
                math.random(-300, 300),
                math.random(250, 450),
                math.random(-300, 300)
            )
            rootPart.CFrame = CFrame.new(pos)
            print("[Chống Gục] Nhân vật mới đã dịch chuyển lên trời")
        end
        
        wait(0.1)
        local newHumanoid = newChar and newChar:FindFirstChild("Humanoid")
        if newHumanoid then
            pcall(function()
                newHumanoid.Health = 100
                print("[Chống Gục] Đã tự động hồi máu cho nhân vật mới")
            end)
        end
        
        print("[Chống Gục] TRẠNG THÁI: ĐÃ HỒI SINH LẠI")
    end
end

-- Bắt đầu kiểm tra gục/chết
local function StartDeathCheck()
    if DeathCheckConnection then
        DeathCheckConnection:Disconnect()
        DeathCheckConnection = nil
    end
    
    DeathCheckConnection = game:GetService("RunService").Heartbeat:Connect(function()
        if AntiDied then
            local LocalPlayer = game.Players.LocalPlayer
            local character = LocalPlayer.Character
            
            if character then
                local humanoid = character:FindFirstChild("Humanoid")
                if humanoid then
                    local isDowned = IsPlayerDowned(character)
                    local isDead = IsPlayerFullyDead(character)
                    
                    if isDowned then
                        print("[Chống Gục] PHÁT HIỆN GỤC! Đang hồi sinh khẩn cấp...")
                        EmergencyRevive()
                    elseif isDead then
                        print("[Chống Gục] PHÁT HIỆN CHẾT! Đang hồi sinh lại...")
                        EmergencyRevive()
                    end
                end
            end
        end
    end)
end

-- Theo dõi sự kiện hồi sinh
local function MonitorDeathEvents()
    if AntiDiedConnection then
        AntiDiedConnection:Disconnect()
        AntiDiedConnection = nil
    end
    
    local LocalPlayer = game.Players.LocalPlayer
    
    AntiDiedConnection = LocalPlayer.CharacterAdded:Connect(function(character)
        if AntiDied then
            print("[Chống Gục] Nhân vật mới đã xuất hiện!")
            wait(0.1)
            
            local humanoid = character:FindFirstChild("Humanoid")
            if humanoid then
                pcall(function()
                    humanoid.Health = 100
                    print("[Chống Gục] Đã tự động hồi máu khi xuất hiện")
                end)
            end
            
            wait(0.1)
            local rootPart = character:FindFirstChild("HumanoidRootPart")
            if rootPart then
                pcall(function()
                    local safePos = Vector3.new(
                        math.random(-300, 300),
                        math.random(250, 450),
                        math.random(-300, 300)
                    )
                    rootPart.CFrame = CFrame.new(safePos)
                    print("[Chống Gục] Đã dịch chuyển lên trời khi xuất hiện")
                end)
            end
        end
    end)
end

