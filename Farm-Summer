local function StopEmote()
    pcall(function()
        local char = game.Players.LocalPlayer.Character
        if char then
            local humanoid = char:FindFirstChild("Humanoid")
            if humanoid then
                -- Tắt emote bằng cách reset animation
                humanoid:LoadAnimation(nil)
                -- Hoặc dùng cách khác
                local animator = char:FindFirstChild("Animator")
                if animator then
                    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                        track:Stop()
                    end
                end
            end
        end
    end)
end

-- =============================================
-- HÀM NHẶT VẬT PHẨM (CÓ KIỂM TRA SỐ LƯỢNG)
-- =============================================
local function CollectItemWithRetry(item)
    if not item or IsCollecting then return false end
    IsCollecting = true
    
    local success = false
    local attempt = 0
    local maxAttempts = 3
    local beforeCurrency = GetCurrentCurrency()
    
    while attempt < maxAttempts and not success do
        attempt = attempt + 1
        
        -- Tắt emote khi teleport
        StopEmote()
        
        if item.clickDetector then
            pcall(function()
                item.clickDetector:FireClick()
                success = true
            end)
        end
        
        if not success and item.proximityPrompt then
            pcall(function()
                item.proximityPrompt:Fire()
                success = true
            end)
        end
        
        if success then
            break
        end
        
        if attempt < maxAttempts then
            local char = game.Players.LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                char.HumanoidRootPart.CFrame = CFrame.new(item.position + Vector3.new(0, 0.5, 0))
                wait(0.1)
            end
        end
    end
    
    -- Kiểm tra số lượng vật phẩm sau khi nhặt
    local afterCurrency = GetCurrentCurrency()
    local gained = afterCurrency - beforeCurrency
    
    if success and gained > 0 then
        CollectedCount = CollectedCount + gained
        CurrentCurrency = afterCurrency
        
        SendNotification("🔔 Thông báo nhận vật phẩm sự kiện!", "❓ Vật phẩm nhận được: " .. gained, 2.5)
        SendNotification("🔔 Thông báo vật phẩm sự kiện...", "📌 Vật phẩm hiện tại của bạn là: " .. afterCurrency, 2.5)
        
        CurrentCurrencyLabel:Set("💰 Current currency: " .. afterCurrency)
        RetryCount = 0
        IsCollecting = false
        return true
    end
    
    -- Kiểm tra nếu vật phẩm biến mất
    local stillExists = false
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj == item.object then
            stillExists = true
            break
        end
    end
    
    if not stillExists then
        -- Vật phẩm biến mất, kiểm tra xem đã nhận được chưa
        if afterCurrency > beforeCurrency then
            CollectedCount = CollectedCount + (afterCurrency - beforeCurrency)
            CurrentCurrency = afterCurrency
            CurrentCurrencyLabel:Set("💰 Current currency: " .. afterCurrency)
            SendNotification("🔔 Thông báo nhận vật phẩm sự kiện!", "❓ Vật phẩm nhận được: " .. (afterCurrency - beforeCurrency), 2.5)
            SendNotification("🔔 Thông báo vật phẩm sự kiện...", "📌 Vật phẩm hiện tại của bạn là: " .. afterCurrency, 2.5)
            IsCollecting = false
            return true
        end
    end
    
    IsCollecting = false
    return false
end

-- =============================================
-- FARM LOOP
-- =============================================
local function FarmLoop()
    if not AutoFarm then return end
    
    if tick() - FarmCooldown < 0.3 then return end
    
    local isWaiting, state = CheckMapState()
    if isWaiting then
        FarmCooldown = tick()
        return
    end
    
    local LocalPlayer = game.Players.LocalPlayer
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    if char:GetAttribute("Downed") then
        FarmCooldown = tick()
        return
    end
    
    CheckAndKeepOnWall()
    
    local items = FindEventItems()
    TotalItems = #items
    CurrencyLabel:Set("🎯 Event Items: " .. TotalItems)
    
    if TotalItems == 0 then
        if not IsAtWall then
            TeleportToWall()
        end
        FarmCooldown = tick()
        return
    end
    
    local currentPos = root.Position
    local nearestItem = items[1]
    
    if not nearestItem then
        FarmCooldown = tick()
        return
    end
    
    local distToItem = (currentPos - nearestItem.position).Magnitude
    
    if IsAtWall then
        SendNotification("❗ Tìm thấy!", "📌 Đang đến vật phẩm...", 1.5)
        StopEmote()
        TeleportToItem(nearestItem.position)
        FarmCooldown = tick()
        return
    end
    
    if distToItem < 20 then
        local collected = CollectItemWithRetry(nearestItem)
        TeleportToWall()
        SendNotification("📍 Về tường", "🔄 Đã quay lại!", 1.5)
        FarmCooldown = tick()
        return
    end
    
    TeleportToItem(nearestItem.position)
    FarmCooldown = tick()
end

