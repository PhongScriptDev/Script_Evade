-- =============================================
-- AUTO RESCUE (TỰ ĐỘNG CỨU NGƯỜI)
-- =============================================
local function FindDownedPlayer()
    local LocalPlayer = game.Players.LocalPlayer
    local nearestDowned = nil
    local nearestDist = math.huge
    
    for _, player in ipairs(game.Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char then
                -- Kiểm tra nếu người chơi đang bị carry
                local beingCarried = false
                local humanoid = char:FindFirstChild("Humanoid")
                if humanoid then
                    local carryingPart = char:FindFirstChild("CarryingPart")
                    if carryingPart then
                        beingCarried = true
                    end
                end
                
                -- Bỏ qua nếu đang được carry
                if beingCarried then
                    continue
                end
                
                -- Kiểm tra health
                if humanoid and humanoid.Health <= 0 then
                    local root = char:FindFirstChild("HumanoidRootPart")
                    if root then
                        local dist = (root.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
                        if dist < nearestDist then
                            nearestDist = dist
                            nearestDowned = player
                        end
                    end
                end
                
                -- Kiểm tra Downed state
                local downedState = char:FindFirstChild("Downed")
                if downedState then
                    local root = char:FindFirstChild("HumanoidRootPart")
                    if root then
                        local dist = (root.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
                        if dist < nearestDist then
                            nearestDist = dist
                            nearestDowned = player
                        end
                    end
                end
            end
        end
    end
    
    return nearestDowned
end

local function RescueLoop()
    if not AutoRescue then return end
    
    local isWaiting, state = CheckMapState()
    if isWaiting then
        return
    end
    
    local LocalPlayer = game.Players.LocalPlayer
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    if char:GetAttribute("Downed") then
        return
    end
    
    CheckAndKeepOnWall()
    
    local downedPlayer = FindDownedPlayer()
    
    if downedPlayer then
        local targetChar = downedPlayer.Character
        if targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
            local targetPos = targetChar.HumanoidRootPart.Position
            
            -- Tắt emote trước khi teleport
            StopEmote()
            
            -- Teleport đến người bị hạ gục
            root.CFrame = CFrame.new(targetPos + Vector3.new(0, 2, 0))
            wait(0.2)
            
            -- Carry người chơi
            local humanoid = char:FindFirstChild("Humanoid")
            if humanoid then
                pcall(function()
                    humanoid:Carry(downedPlayer)
                    SendNotification("🤝 Đang carry!", "Đang carry " .. downedPlayer.Name, 2)
                end)
            end
            
            -- Teleport về tường
            TeleportToWall()
            wait(0.3)
            
            -- Thả người chơi xuống tường
            pcall(function()
                local humanoid2 = char:FindFirstChild("Humanoid")
                if humanoid2 then
                    humanoid2:DropCarry()
                end
            end)
            
            -- Cứu người chơi (Resurrect)
            if targetChar then
                local targetHumanoid = targetChar:FindFirstChild("Humanoid")
                if targetHumanoid then
                    pcall(function()
                        targetHumanoid.Health = 100
                        local downed = targetChar:FindFirstChild("Downed")
                        if downed then
                            downed:Destroy()
                        end
                        RescuedCount = RescuedCount + 1
                        SendNotification("❤️ Đã cứu!", "Đã cứu " .. downedPlayer.Name .. " (#" .. RescuedCount .. ")", 3)
                    end)
                end
            end
            
            -- Đảm bảo người được cứu đứng trên tường
            if targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
                local targetRoot = targetChar.HumanoidRootPart
                targetRoot.CFrame = CFrame.new(SafeWall.Position + Vector3.new(0, 1.5, 0))
            end
        end
    end
end

