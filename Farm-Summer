        end
    end
})

-- =============================================
-- AUTO FARM EVENT
-- =============================================
local AutoFarm = false
local FarmConnection = nil
local Collected = 0
local AllBubbles = {}
local CurrentIndex = 1

local function ScanBubbles()
    AllBubbles = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        local name = obj.Name or ""
        if name:lower():find("bubble") then
            local pos = nil
            if obj:IsA("BasePart") then
                pos = obj.Position
            elseif obj:IsA("Model") and obj:FindFirstChild("PrimaryPart") then
                pos = obj.PrimaryPart.Position
            elseif obj:IsA("Model") and obj:FindFirstChild("HumanoidRootPart") then
                pos = obj.HumanoidRootPart.Position
            end
            if pos then
                table.insert(AllBubbles, {
                    object = obj,
                    position = pos,
                    name = obj.Name,
                    collected = false
                })
            end
        end
    end
    print("[Farm] Tìm thấy " .. #AllBubbles .. " Bubble")
    return AllBubbles
end

local function TeleportToBubble(pos)
    local char = game.Players.LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then
        root.CFrame = CFrame.new(pos)
        return true
    end
    return false
end

local function CollectBubble(item)
    if not item or item.collected then return false end
    
    local success = false
    local click = item.object:FindFirstChild("ClickDetector")
    if click then
        pcall(function() click:FireClick() success = true end)
    end
    
    local prompt = item.object:FindFirstChild("ProximityPrompt")
    if prompt then
        pcall(function() prompt:Fire() success = true end)
    end
    
    if not success then
        success = true
    end
    
    if success then
        item.collected = true
        Collected = Collected + 1
        print("[Farm] Đã nhặt Bubble #" .. Collected)
        return true
    end
    return false
end

local function FarmLoop()
    if not AutoFarm then return end
    
    if #AllBubbles == 0 or CurrentIndex > #AllBubbles then
        ScanBubbles()
        CurrentIndex = 1
        if #AllBubbles == 0 then
            return
        end
    end
    
    local target = nil
    for i = CurrentIndex, #AllBubbles do
        if not AllBubbles[i].collected then
            target = AllBubbles[i]
            CurrentIndex = i
            break
        end
    end
    
    if not target then
        CurrentIndex = #AllBubbles + 1
        return
    end
    
    TeleportToBubble(target.position)
    wait(0.2)
    CollectBubble(target)
    CurrentIndex = CurrentIndex + 1
end

MainTab:CreateToggle({
    Name = "Auto Farm Event 🎈",
    Description = "Tự động teleport đến Bubble",
    CurrentValue = false,
    Callback = function(Value)
        AutoFarm = Value
        if AutoFarm then
            Collected = 0
            CurrentIndex = 1
            AllBubbles = {}
            print("[Farm] Bật")
            ScanBubbles()
            if FarmConnection then
                FarmConnection:Disconnect()
            end
            FarmConnection = game:GetService("RunService").Stepped:Connect(function()
                pcall(FarmLoop)
            end)
        else
            print("[Farm] Tắt")
            if FarmConnection then
                FarmConnection:Disconnect()
                FarmConnection = nil
            end
        end
    end
})

