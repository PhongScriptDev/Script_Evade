-- =============================================
local function FindSafeWallPosition()
    local mapCenter = Vector3.new(0, 0, 0)
    local mapRadius = 0
    
    -- Tìm center và bán kính của map
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Part") and obj.Size.Magnitude > 50 then
            mapCenter = obj.Position
            mapRadius = math.max(mapRadius, obj.Size.X, obj.Size.Z)
            break
        end
    end
    
    if mapCenter == Vector3.new(0, 0, 0) then
        local char = game.Players.LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            mapCenter = char.HumanoidRootPart.Position
        end
    end
    
    -- Tính khoảng cách an toàn: xa hơn map 300-500 studs
    local safeDistance = math.random(350, 500)
    local angle = math.random() * 2 * math.pi
    
    -- Vị trí tường: xa map, trên cao
    local safePos = Vector3.new(
        mapCenter.X + math.cos(angle) * safeDistance,
        math.random(200, 350),
        mapCenter.Z + math.sin(angle) * safeDistance
    )
    
    return safePos
end

