local AutoFarm = false
local FarmConnection = nil
local ScanCooldown = 0
local IsTeleportingToTarget = false
local TargetPosition = Vector3.new(443.9, 246.4, -48.5) -- Vị trí từ ảnh

-- QUÉT TOÀN BỘ MAP TÌM BUBBLE
local function ScanAllBubbles()
    AllBubbles = {}
    local LocalPlayer = game.Players.LocalPlayer
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        local name = obj.Name or ""
        if name:lower():find("bubble") then
            local position = nil
            
            if obj:IsA("BasePart") then
                position = obj.Position
            elseif obj:IsA("Model") then
                if obj:FindFirstChild("PrimaryPart") then
                    position = obj.PrimaryPart.Position
                elseif obj:FindFirstChild("HumanoidRootPart") then
                    position = obj.HumanoidRootPart.Position
                elseif obj:FindFirstChild("Head") then
                    position = obj.Head.Position
                else
                    local sumPos = Vector3.new(0, 0, 0)
                    local count = 0
                    for _, part in ipairs(obj:GetChildren()) do
                        if part:IsA("BasePart") then
                            sumPos = sumPos + part.Position
                            count = count + 1
                        end
                    end
                    if count > 0 then
                        position = sumPos / count
                    end
                end
            end
            
            if position then
                table.insert(AllBubbles, {
                    object = obj,
                    position = position,
                    name = obj.Name,
                    collected = false
                })
            end
        end
    end
    
    TotalBubbles = #AllBubbles
    print("[AutoFarm] Quét hoàn tất! Tìm thấy " .. TotalBubbles .. " Bubble")
    BubbleLabel:Set("🎈 Bubble trong map: " .. TotalBubbles)
    return AllBubbles
end

-- TELEPORT ĐẾN BUBBLE
local function TeleportToBubble(targetPos)
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character then return false end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end
    
    rootPart.CFrame = CFrame.new(targetPos)
    return true
end

-- NHẶT BUBBLE
local function CollectBubble(item)
    if not item or not item.object then return false end
    if item.collected then return false end
    
    local success = false
    
    local clickDetector = item.object:FindFirstChild("ClickDetector")
    if clickDetector then
        pcall(function()
            clickDetector:FireClick()
            success = true
        end)
    end
    
    local proximityPrompt = item.object:FindFirstChild("ProximityPrompt")
    if proximityPrompt then
        pcall(function()
            proximityPrompt:Fire()
            success = true
        end)
    end
    
    if not success then
        success = true
    end
    
    if success then
        item.collected = true
        CollectedCount = CollectedCount + 1
        print("[AutoFarm] Đã nhặt Bubble #" .. CollectedCount)
        TotalLabel:Set("🎯 Đã nhặt: " .. CollectedCount .. " Bubble")
        ShowNotification("🎈 Đã nhặt!", "Bubble #" .. CollectedCount .. "/" .. TotalBubbles, 2, Color3.fromRGB(0, 255, 255))
        return true
    end
    
    return false
end

-- TELEPORT VỀ VỊ TRÍ CỐ ĐỊNH
local function TeleportToTargetPosition()
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character then return false end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end
    
    rootPart.CFrame = CFrame.new(TargetPosition)
    print("[AutoFarm] Teleport về vị trí cố định: " .. tostring(TargetPosition))
    return true
end

-- FARM LOOP
local function FarmLoop()
    if not AutoFarm then return end
    
    if tick() - FarmCooldown < 0.5 then
        return
    end
    
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character then return end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    local currentPos = rootPart.Position
    
    -- Quét lại nếu hết Bubble
    if #AllBubbles == 0 or CurrentIndex > #AllBubbles then
        ScanAllBubbles()
        CurrentIndex = 1
        if #AllBubbles == 0 then
            FarmCooldown = tick()
            return
        end
        ShowNotification("🎈 Đã quét!", "Tìm thấy " .. #AllBubbles .. " Bubble trong map", 3, Color3.fromRGB(0, 255, 255))
    end
    
    -- Tìm Bubble chưa nhặt
    local target = nil
    for i = CurrentIndex, #AllBubbles do
        if not AllBubbles[i].collected then
            target = AllBubbles[i]
            CurrentIndex = i
            break
        end
    end
    
    if not target then
        -- Đã nhặt hết -> teleport về vị trí cố định
        if (currentPos - TargetPosition).Magnitude > 10 then
            TeleportToTargetPosition()
            ShowNotification("📍 Về vị trí cố định!", "Đã teleport về X: 443.9 Y: 246.4 Z: -48.5", 2, Color3.fromRGB(0, 200, 255))
        end
        CurrentIndex = #AllBubbles + 1
        FarmCooldown = tick()
        return
    end
    
    -- TELEPORT ĐẾN BUBBLE
    if (currentPos - target.position).Magnitude > 10 then
        TeleportToBubble(target.position)
        print("[AutoFarm] Teleport đến Bubble #" .. CurrentIndex)
        ShowNotification("🎈 Teleport!", "Đang đến Bubble #" .. CurrentIndex, 1.5, Color3.fromRGB(255, 200, 0))
    end
    
    wait(0.1)
    
    -- Nhặt Bubble
    local collected = CollectBubble(target)
    if collected then
        -- Sau khi nhặt xong, TELEPORT NGAY VỀ VỊ TRÍ CỐ ĐỊNH
        wait(0.1)
        TeleportToTargetPosition()
        print("[AutoFarm] Teleport về vị trí cố định sau khi nhặt")
    end
    
    -- Chuyển tiếp
    CurrentIndex = CurrentIndex + 1
    FarmCooldown = tick()
end

MainTab:CreateToggle({
    Name = "Auto Farm Event 🎈",
    Description = "Quét toàn bộ map, teleport đến Bubble, sau đó về vị trí cố định",
    CurrentValue = false,
    Callback = function(Value)
        AutoFarm = Value
        
        if AutoFarm then
            CollectedCount = 0
            CurrentIndex = 1
            AllBubbles = {}
            
            print("[AutoFarm] ĐÃ BẬT")
            ShowNotification("🎈 Auto Farm", "Đang quét toàn bộ map...", 3, Color3.fromRGB(0, 255, 255))
            
            -- Teleport về vị trí cố định
            wait(0.3)
            TeleportToTargetPosition()
            ShowNotification("📍 Vị trí cố định", "Đã teleport về X: 443.9 Y: 246.4 Z: -48.5", 2, Color3.fromRGB(0, 200, 255))
            
            wait(0.3)
            ScanAllBubbles()
            ShowNotification("🎈 Tìm thấy!", "Đã tìm thấy " .. TotalBubbles .. " Bubble", 3, Color3.fromRGB(0, 255, 0))
            
            if FarmConnection then
                FarmConnection:Disconnect()
            end
            
            FarmConnection = game:GetService("RunService").Stepped:Connect(function()
                if AutoFarm then
                    pcall(function()
                        FarmLoop()
                    end)
                end
            end)
            
            print("[AutoFarm] ĐANG CHẠY")
        else
            print("[AutoFarm] ĐÃ TẮT")
            ShowNotification("❌ Auto Farm", "Đã tắt! Tổng: " .. CollectedCount .. " Bubble", 3, Color3.fromRGB(255, 0, 0))
            
            if FarmConnection then
                FarmConnection:Disconnect()
                FarmConnection = nil
            end
        end
    end
})

