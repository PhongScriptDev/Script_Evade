-- QUÉT TOÀN BỘ MAP TÌM BUBBLE
local function ScanAllBubbles()
    AllBubbles = {}
    local LocalPlayer = game.Players.LocalPlayer
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        local name = obj.Name or ""
        if name:lower():find("bubble") then
            local position = nil
            
            if obj:IsA("BasePart") then
                position = obj.Position
            elseif obj:IsA("Model") then
                if obj:FindFirstChild("PrimaryPart") then
                    position = obj.PrimaryPart.Position
                elseif obj:FindFirstChild("HumanoidRootPart") then
                    position = obj.HumanoidRootPart.Position
                elseif obj:FindFirstChild("Head") then
                    position = obj.Head.Position
                else
                    local sumPos = Vector3.new(0, 0, 0)
                    local count = 0
                    for _, part in ipairs(obj:GetChildren()) do
                        if part:IsA("BasePart") then
                            sumPos = sumPos + part.Position
                            count = count + 1
                        end
                    end
                    if count > 0 then
                        position = sumPos / count
                    end
                end
            end
            
            if position then
                table.insert(AllBubbles, {
                    object = obj,
                    position = position,
                    name = obj.Name,
                    collected = false
                })
            end
        end
    end
    
    TotalBubbles = #AllBubbles
    print("[AutoFarm] Quét hoàn tất! Tìm thấy " .. TotalBubbles .. " Bubble")
    BubbleLabel:Set("🎈 Bubble trong map: " .. TotalBubbles)
    return AllBubbles
end

