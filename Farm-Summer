-- =============================================
-- HÀM PHÁT HIỆN VẬT PHẨM SỰ KIỆN (KHÔNG DÙNG TÊN)
-- =============================================
local function FindEventCurrency()
    local items = {}
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character then return items end
    local rootPos = character:FindFirstChild("HumanoidRootPart")
    if not rootPos then return items end
    
    local allObjects = workspace:GetDescendants()
    
    for _, obj in ipairs(allObjects) do
        -- KIỂM TRA VẬT PHẨM CÓ THỂ TƯƠNG TÁC
        local clickDetector = obj:FindFirstChild("ClickDetector")
        local proximityPrompt = obj:FindFirstChild("ProximityPrompt")
        
        if clickDetector or proximityPrompt then
            -- Bỏ qua object của người chơi
            if not obj:IsDescendantOf(character) then
                -- KIỂM TRA CÓ GIÁ TRỊ KHÔNG (attribute Value)
                local hasValue = false
                if clickDetector then
                    local val = clickDetector:GetAttribute("Value")
                    if val and val > 0 then hasValue = true end
                end
                if not hasValue and proximityPrompt then
                    local val = proximityPrompt:GetAttribute("Value")
                    if val and val > 0 then hasValue = true end
                end
                
                -- KIỂM TRA ATTRIBUTE (bất kỳ attribute nào liên quan đến currency)
                if not hasValue then
                    local attrs = {"CurrencyType", "EventCurrency", "Collectible", "Currency", "Reward", "Points", "Item"}
                    for _, attr in ipairs(attrs) do
                        if obj:GetAttribute(attr) then
                            hasValue = true
                            break
                        end
                    end
                end
                
                if hasValue then
                    local position = nil
                    if obj:IsA("BasePart") then
                        position = obj.Position
                    elseif obj:IsA("Model") then
                        if obj:FindFirstChild("PrimaryPart") then
                            position = obj.PrimaryPart.Position
                        elseif obj:FindFirstChild("HumanoidRootPart") then
                            position = obj.HumanoidRootPart.Position
                        elseif obj:FindFirstChild("Head") then
                            position = obj.Head.Position
                        else
                            local sumPos = Vector3.new(0, 0, 0)
                            local count = 0
                            for _, part in ipairs(obj:GetChildren()) do
                                if part:IsA("BasePart") then
                                    sumPos = sumPos + part.Position
                                    count = count + 1
                                end
                            end
                            if count > 0 then position = sumPos / count end
                        end
                    end
                    
                    if position then
                        table.insert(items, {
                            object = obj,
                            position = position,
                            name = obj.Name,
                            distance = (rootPos.Position - position).Magnitude,
                            clickDetector = clickDetector,
                            proximityPrompt = proximityPrompt
                        })
                    end
                end
            end
        end
    end
    
    table.sort(items, function(a, b)
        return a.distance < b.distance
    end)
    
    return items
end

-- =============================================
-- HÀM KIỂM TRA SỰ KIỆN
-- =============================================
local function CheckEventStatus()
    pcall(function()
        local items = FindEventCurrency()
        local count = #items
        
        if count > 0 then
            EventActive = true
            EventStatusLabel:Set("⏰ Event: ✅ ACTIVE (" .. count .. " items)")
        else
            EventActive = false
            EventStatusLabel:Set("⏰ Event: ❌ NONE")
        end
        
        return EventActive
    end)
    return EventActive
end

-- =============================================
-- HÀM CẬP NHẬT LABEL
-- =============================================
local function UpdateLabels()
    pcall(function()
        local items = FindEventCurrency()
        TotalItems = #items
        CurrencyLabel:Set("🎯 Event Currency in server: " .. #items)
        
        local LocalPlayer = game.Players.LocalPlayer
        local stats = LocalPlayer:FindFirstChild("leaderstats")
        if stats then
            local level = stats:FindFirstChild("Level")
            local exp = stats:FindFirstChild("Exp") or stats:FindFirstChild("Experience")
            local expToNext = stats:FindFirstChild("ExpToNext") or stats:FindFirstChild("ExperienceToNext")
            
            if level then
                LevelLabel:Set("⭐ Current Level: " .. level.Value)
            end
            if exp and expToNext then
                ExpLabel:Set("✨ Exp: " .. exp.Value .. " / " .. expToNext.Value)
            elseif exp then
                ExpLabel:Set("✨ Exp: " .. exp.Value)
            end
        end
        
        if tick() - LastEventCheck > 5 then
            LastEventCheck = tick()
            CheckEventStatus()
        end
    end)
end

