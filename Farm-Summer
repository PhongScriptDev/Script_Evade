local function FindSafeWallPosition()
    local mapCenter = Vector3.new(0, 0, 0)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Part") and obj.Size.Magnitude > 100 then
            mapCenter = obj.Position
            break
        end
    end
    return Vector3.new(mapCenter.X - 400, math.random(250, 400), mapCenter.Z + math.random(-100, 100))
end

local function CreateSafeWall(position)
    if SafeWall then SafeWall:Destroy() end
    SafeWall = Instance.new("Part")
    SafeWall.Name = "SafeWall_Private"
    SafeWall.Size = Vector3.new(50, 2, 50)
    SafeWall.CFrame = CFrame.new(position)
    SafeWall.Anchored = true
    SafeWall.CanCollide = true
    SafeWall.Transparency = 0.2
    SafeWall.Material = Enum.Material.Glass
    SafeWall.Locked = true
    SafeWall.Color = Color3.fromRGB(0, 200, 255)
    SafeWall.Parent = workspace
    WallPosition = position
end

local function TeleportToWall()
    if not SafeWall then return false end
    local char = game.Players.LocalPlayer.Character
    if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    root.CFrame = CFrame.new(SafeWall.Position + Vector3.new(0, 1, 0))
    IsAtWall = true
    return true
end

local function TeleportToCurrency(targetPos)
    local char = game.Players.LocalPlayer.Character
    if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    root.CFrame = CFrame.new(targetPos)
    IsAtWall = false
    return true
end

local function CollectCurrency(item)
    if not item then return false end
    
    local success = false
    pcall(function()
        if item.clickDetector then
            item.clickDetector:FireClick()
            success = true
        end
        if item.proximityPrompt then
            item.proximityPrompt:Fire()
            success = true
        end
    end)
    
    if success then
        CollectedCount = CollectedCount + 1
        UpdateEventLog("✅ Collected #" .. CollectedCount)
        CurrencyLabel:Set("🎯 Event Currency in server: " .. TotalItems)
        return true
    end
    return false
end

-- =============================================
-- FARM LOOP
-- =============================================
local function FarmLoop()
    if not AutoFarm then return end
    
    if not CheckEventStatus() then
        if AutoFarm then
            UpdateEventLog("❌ NO EVENT! Stopped.")
            AutoFarm = false
            if FarmConnection then
                FarmConnection:Disconnect()
                FarmConnection = nil
            end
            Rayfield:Notify({
                Title = "⛔ No Event!",
                Content = "No event detected. Auto Farm stopped.",
                Duration = 5,
                Image = 0
            })
        end
        return
    end
    
    FarmLoopCount = FarmLoopCount + 1
    if FarmLoopCount % 3 ~= 0 then return end
    if tick() - FarmCooldown < 0.5 then return end
    
    local LocalPlayer = game.Players.LocalPlayer
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    if char:GetAttribute("Downed") then
        UpdateEventLog("⚠️ Downed")
        FarmCooldown = tick()
        return
    end
    
    local gameState = workspace:FindFirstChild("GameState")
    if gameState then
        local stateText = tostring(gameState.Value or "")
        if stateText:lower():find("voting") or stateText:lower():find("paused") then
            if not IsAtWall then
                TeleportToWall()
                UpdateEventLog("⏸️ Paused")
            end
            FarmCooldown = tick()
            return
        end
    end
    
    local items = FindEventCurrency()
    TotalItems = #items
    
    if TotalItems == 0 then
        if not IsAtWall then
            TeleportToWall()
            UpdateEventLog("🔍 No items")
        end
        FarmCooldown = tick()
        return
    end
    
    local currentPos = root.Position
    local nearestItem = items[1]
    
    if not nearestItem then
        FarmCooldown = tick()
        return
    end
    
    local distToItem = (currentPos - nearestItem.position).Magnitude
    
    if IsAtWall then
        UpdateEventLog("🎯 Found item! Teleporting...")
        TeleportToCurrency(nearestItem.position)
        FarmCooldown = tick()
        return
    end
    
    if not IsAtWall then
        if distToItem < 15 then
            CollectCurrency(nearestItem)
            TeleportToWall()
            UpdateEventLog("📍 Back to wall")
            FarmCooldown = tick()
        else
            UpdateEventLog("🎯 Teleporting...")
            TeleportToCurrency(nearestItem.position)
            FarmCooldown = tick()
        end
        return
    end
end

