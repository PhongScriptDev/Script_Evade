local function GetActiveItems()
    local active = {}
    local hasManual = false
    for _, name in ipairs(ItemNameList) do
        local trimmed = name:gsub("^%s+", ""):gsub("%s+$", "")
        if trimmed ~= "" and trimmed:lower() ~= "none" then
            hasManual = true
            break
        end
    end
    if hasManual then
        for _, name in ipairs(ItemNameList) do
            local trimmed = name:gsub("^%s+", ""):gsub("%s+$", "")
            if trimmed ~= "" and trimmed:lower() ~= "none" then
                table.insert(active, trimmed)
            end
        end
        EventStatusLabel:Set("📌 Item target: " .. table.concat(active, ", "))
        return active
    end
    local detected = {}
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character then return detected end
    local currencyNames = {}
    local stats = LocalPlayer:FindFirstChild("leaderstats")
    if stats then
        for _, child in ipairs(stats:GetChildren()) do
            if child:IsA("NumberValue") or child:IsA("IntValue") then
                local name = child.Name
                local skipNames = {"Level", "Exp", "Experience", "Wins", "Kills", "Deaths", "Points", "Score", "Coin", "Robux"}
                local shouldSkip = false
                for _, skip in ipairs(skipNames) do
                    if name == skip then
                        shouldSkip = true
                        break
                    end
                end
                if not shouldSkip then
                    table.insert(currencyNames, name)
                end
            end
        end
    end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsDescendantOf(character) then continue end
        local clickDetector = obj:FindFirstChild("ClickDetector")
        local proximityPrompt = obj:FindFirstChild("ProximityPrompt")
        if clickDetector or proximityPrompt then
            local objName = obj.Name or ""
            local nameLower = objName:lower()
            local isCurrency = false
            for _, cName in ipairs(currencyNames) do
                if nameLower:find(cName:lower()) then
                    isCurrency = true
                    break
                end
            end
            if not isCurrency then
                if obj:GetAttribute("CurrencyType") or obj:GetAttribute("EventCurrency") or 
                   obj:GetAttribute("Currency") or obj:GetAttribute("Value") then
                    isCurrency = true
                end
            end
            if isCurrency then
                table.insert(detected, objName)
            end
        end
    end
    if #detected > 0 then
        EventStatusLabel:Set("📌 Item target: 🔍 Auto Detect (" .. #detected .. " items)")
    else
        EventStatusLabel:Set("📌 Item target: ⚠️ No items found!")
    end
    return detected
end

local function FindEventItems()
    local items = {}
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character then return items end
    local rootPos = character:FindFirstChild("HumanoidRootPart")
    if not rootPos then return items end
    local activeItems = GetActiveItems()
    if #activeItems == 0 then return items end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsDescendantOf(character) then continue end
        local objName = obj.Name or ""
        local isMatch = false
        for _, itemName in ipairs(activeItems) do
            if objName:lower():find(itemName:lower()) then
                isMatch = true
                break
            end
        end
        if isMatch then
            local position = nil
            if obj:IsA("BasePart") then
                position = obj.Position
            elseif obj:IsA("Model") then
                if obj:FindFirstChild("PrimaryPart") then
                    position = obj.PrimaryPart.Position
                elseif obj:FindFirstChild("HumanoidRootPart") then
                    position = obj.HumanoidRootPart.Position
                elseif obj:FindFirstChild("Head") then
                    position = obj.Head.Position
                else
                    local sumPos = Vector3.new(0, 0, 0)
                    local count = 0
                    for _, part in ipairs(obj:GetChildren()) do
                        if part:IsA("BasePart") then
                            sumPos = sumPos + part.Position
                            count = count + 1
                        end
                    end
                    if count > 0 then position = sumPos / count end
                end
            end
            if position then
                table.insert(items, {
                    object = obj,
                    position = position,
                    distance = (rootPos.Position - position).Magnitude,
                    clickDetector = obj:FindFirstChild("ClickDetector"),
                    proximityPrompt = obj:FindFirstChild("ProximityPrompt"),
                    name = objName
                })
            end
        end
    end
    table.sort(items, function(a, b) return a.distance < b.distance end)
    return items
end

