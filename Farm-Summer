local function AutoRevive()
    if IsReviving then return end
    IsReviving = true
    local LocalPlayer = game.Players.LocalPlayer
    local char = LocalPlayer.Character
    if not char then
        pcall(function() LocalPlayer:LoadCharacter() end)
        IsReviving = false
        return
    end
    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid then
        pcall(function() LocalPlayer:LoadCharacter() end)
        IsReviving = false
        return
    end
    local isDowned = char:GetAttribute("Downed") or false
    local health = humanoid.Health or 0
    local isDead = humanoid:GetState() == Enum.HumanoidStateType.Dead
    if isDowned or health <= 0 or isDead then
        pcall(function() humanoid.Health = 100 end)
        pcall(function()
            local downedState = char:FindFirstChild("Downed")
            if downedState then downedState:Destroy() end
        end)
        pcall(function()
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
            wait(0.05)
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
        end)
        pcall(function()
            humanoid.Sit = false
            humanoid.PlatformStand = false
            humanoid.AutoRotate = true
        end)
        wait(0.2)
        if humanoid.Health <= 0 then
            pcall(function() LocalPlayer:LoadCharacter() end)
        else
            SendNotification("🔔 Thông báo hồi sinh!", "👤 Đã hồi sinh thành công...", 3)
        end
        if SafeWall then
            wait(0.1)
            local newChar = LocalPlayer.Character
            if newChar and newChar:FindFirstChild("HumanoidRootPart") then
                newChar.HumanoidRootPart.CFrame = CFrame.new(SafeWall.Position + Vector3.new(0, 2, 0))
            end
        end
        IsDowned = false
        IsDead = false
        IsWaitingToJoin = false
    end
    IsReviving = false
end

local function AutoJoinMap()
    local LocalPlayer = game.Players.LocalPlayer
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return false end
    for _, gui in ipairs(playerGui:GetDescendants()) do
        if gui:IsA("TextButton") or gui:IsA("ImageButton") then
            local text = gui.Text or ""
            local name = gui.Name or ""
            local nameLower = name:lower()
            local textLower = text:lower()
            if textLower:find("close") or textLower:find("đóng") or 
               nameLower:find("close") or nameLower:find("đóng") or
               textLower:find("x") or text:find("✕") or text:find("×") then
                pcall(function() gui:Fire() return true end)
            end
            if textLower:find("join") or textLower:find("vào") or 
               textLower:find("play") or textLower:find("chơi") or
               textLower:find("start") or textLower:find("bắt đầu") then
                pcall(function() gui:Fire() return true end)
            end
        end
    end
    return false
end

