            IsSpecialRound = true
        else
            IsSpecialRound = false
        end
    end
end

-- Kiểm tra NextBot
local function CheckNextBot()
    if not AntiNextBot then return end
    
    if tick() - NextBotCheckCooldown < 0.2 then
        return
    end
    NextBotCheckCooldown = tick()
    
    local LocalPlayer = game.Players.LocalPlayer
    local character = LocalPlayer.Character
    if not character then return end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    local currentPos = rootPart.Position
    
    -- Kiểm tra vòng đặc biệt
    CheckSpecialRound()
    
    -- Quét toàn bộ map tìm bot
    local nearestDist = math.huge
    local botNear = false
    local botApproaching = false
    
    -- Kiểm tra players
    for _, player in ipairs(game.Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local enemy = player.Character
            if enemy and enemy:FindFirstChild("HumanoidRootPart") then
                local enemyPos = enemy.HumanoidRootPart.Position
                local dist = (currentPos - enemyPos).Magnitude
                if dist < nearestDist then
                    nearestDist = dist
                end
                if dist < 60 then
                    botNear = true
                end
            end
        end
    end
    
    -- Kiểm tra NPC bot
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("HumanoidRootPart") then
            local name = obj.Name:lower()
            if name:find("bot") or name:find("next") or name:find("npc") then
                local enemyPos = obj.HumanoidRootPart.Position
                local dist = (currentPos - enemyPos).Magnitude
                if dist < nearestDist then
                    nearestDist = dist
                end
                if dist < 60 then
                    botNear = true
                end
            end
        end
    end
    
    -- Nếu bot gần -> teleport đến vị trí an toàn
    if botNear then
        local safePos = FindSafestPosition()
        if safePos then
            rootPart.CFrame = CFrame.new(safePos)
            ShowNotification("🛡️ NextBot", "Phát hiện bot! Teleport đến vị trí an toàn", 2, Color3.fromRGB(255, 200, 0))
            print("[NextBot V2] Teleport đến: " .. tostring(safePos))
        end
        return
    end
    
    -- Teleport định kỳ
    local interval = IsSpecialRound and 2.5 or 5
    if not character:FindFirstChild("LastTeleportTime") then
        local t = Instance.new("NumberValue")
        t.Name = "LastTeleportTime"
        t.Value = tick()
        t.Parent = character
    else
        if tick() - character.LastTeleportTime.Value > interval then
            local safePos = FindSafestPosition()
            if safePos then
                rootPart.CFrame = CFrame.new(safePos)
                character.LastTeleportTime.Value = tick()
            end
        end
    end
end

