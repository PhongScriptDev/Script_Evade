-- Hàm kiểm tra vật phẩm hợp lệ
local function isValidItem(part)
    if not part then return false end
    local nameLower = string.lower(part.Name)
    -- Kiểm tra tên vật phẩm (bubble, coconut, event)
    if not string.find(nameLower, "bubble") and not string.find(nameLower, "coconut") then
        return false
    end
    -- Bỏ qua hiệu ứng, animation, accessory
    if part:FindFirstChildWhichIsA("ParticleEmitter") or 
       part:FindFirstChildWhichIsA("Trail") or 
       part:FindFirstChildWhichIsA("Beam") or
       part:IsA("Accessory") or
       part:FindFirstChildWhichIsA("Animation") then
        return false
    end
    -- Bỏ qua vật phẩm của người chơi
    for _, player in ipairs(game.Players:GetPlayers()) do
        if player.Character and part:IsDescendantOf(player.Character) then
            return false
        end
    end
    return true
end

-- Hàm lấy tất cả vật phẩm trên map
local function getAllItems()
    local items = {}
    for _, v in ipairs(workspace:GetDescendants()) do
        if (v:IsA("BasePart") or v:IsA("Model")) then
            if isValidItem(v) then
                local part = v:IsA("BasePart") and v or v:FindFirstChildWhichIsA("BasePart")
                if part then
                    table.insert(items, part)
                end
            end
        end
    end
    return items
end

-- Hàm kiểm tra nextbot gần
local function isNextbotNear(position)
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("Model") and v:GetAttribute("Nextbot") == true then
            local root = v:FindFirstChild("HumanoidRootPart") or v:FindFirstChildWhichIsA("BasePart")
            if root then
                local distance = (position - root.Position).Magnitude
                if distance <= 12 then
                    return true
                end
            end
        end
    end
    return false
end

-- Hàm tìm vật phẩm an toàn gần nhất
local function getClosestSafeItem(hrp, items)
    local closest, minDst = nil, math.huge
    for _, part in ipairs(items) do
        local dst = (hrp.Position - part.Position).Magnitude
        if dst < minDst and not isNextbotNear(part.Position) then
            closest = part
            minDst = dst
        end
    end
    return closest
end

-- Hàm teleport mượt
local function teleportTo(hrp, pos, duration)
    duration = duration or 0.2
    local tween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = CFrame.new(pos)})
    tween:Play()
    tween.Completed:Wait()
end

-- Hàm thu thập vật phẩm
local function collectItem(item)
    if not item then return false end
    pcall(function()
        local collectId = item.Parent:GetAttribute("Id") or item:GetAttribute("Id") or "a19ac91bff904b7385e826fd6a23dc01"
        ReplicatedStorage.Events.Collectibles.Invoke:InvokeServer(game.Players.LocalPlayer, collectId, "Collect")
        CollectedCount = CollectedCount + 1
        TotalLabel:Set("🎯 Đã nhặt: " .. CollectedCount .. " Bubble")
        ShowNotification("🎈 Đã nhặt!", "Bubble #" .. CollectedCount, 2, Color3.fromRGB(0, 255, 255))
        return true
    end)
    return false
end

-- Farm loop chính (cập nhật)
local function FarmLoop()
    if not AutoFarm then return end
    if tick() - FarmCooldown < 0.5 then return end
    
    local LocalPlayer = game.Players.LocalPlayer
    local char = LocalPlayer.Character
    if not char then return end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local isDowned = char:GetAttribute("Downed")
    if isDowned then
        FarmCooldown = tick()
        return
    end
    
    -- Kiểm tra trạng thái map
    local gameState = workspace:FindFirstChild("GameState")
    if gameState then
        local stateText = tostring(gameState.Value or "")
        if stateText:lower():find("voting") or stateText:lower():find("bình chọn") or
           stateText:lower():find("paused") or stateText:lower():find("tạm dừng") then
            if not IsAtWall then TeleportToWall() end
            FarmCooldown = tick()
            return
        end
    end
    
    -- Lấy danh sách vật phẩm
    local items = getAllItems()
    TotalBubbles = #items
    BubbleLabel:Set("🎈 Bubble trong map: " .. TotalBubbles)
    
    -- Nếu không có vật phẩm
    if #items == 0 then
        noItemTimer = noItemTimer + 0.5
        if noItemTimer >= 20 then
            if IsAtWall then TeleportToWall() end
        end
        FarmCooldown = tick()
        return
    else
        noItemTimer = 0
    end
    
    -- Tìm vật phẩm an toàn gần nhất
    local item = getClosestSafeItem(hrp, items)
    if not item then
        FarmCooldown = tick()
        return
    end
    
    -- Lưu vị trí hiện tại
    if not originalPosition then
        originalPosition = hrp.Position + Vector3.new(0, 200, 0)
    end
    
    -- Nếu đang ở tường thì bỏ anchor
    if IsAtWall then
        hrp.Anchored = false
        IsAtWall = false
    end
    
    -- Teleport đến vật phẩm
    local startPos = hrp.Position
    teleportTo(hrp, item.Position, 0.2)
    
    -- Thu thập vật phẩm
    collectItem(item)
    
    wait(0.3)
    
    -- Kiểm tra lại trạng thái
    isDowned = char:GetAttribute("Downed")
    if isDowned then
        hrp.Anchored = false
        FarmCooldown = tick()
        return
    end
    
    -- Quay về vị trí ban đầu hoặc lên tường
    if IsAtWall then
        teleportTo(hrp, originalPosition, 0.2)
        hrp.Anchored = true
    else
        teleportTo(hrp, startPos, 0.2)
    end
    
    FarmCooldown = tick()
end

