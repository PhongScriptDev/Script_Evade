    return 0
end

-- =============================================
-- TƯỜNG AN TOÀN (RỘNG, NGƯỜI KHÁC THẤY ĐƯỢC)
-- =============================================
local function FindSafeWallPosition()
    local mapCenter = Vector3.new(0, 0, 0)
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Part") and obj.Size.Magnitude > 50 then
            mapCenter = obj.Position
            break
        end
    end
    
    if mapCenter == Vector3.new(0, 0, 0) then
        local char = game.Players.LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            mapCenter = char.HumanoidRootPart.Position
        end
    end
    
    return Vector3.new(
        mapCenter.X + math.random(-150, 150),
        math.random(150, 280),
        mapCenter.Z + math.random(-150, 150)
    )
end

local function CreateSafeWall(position)
    if SafeWall then SafeWall:Destroy() end
    
    SafeWall = Instance.new("Part")
    SafeWall.Name = "SafeWall_Private"
    SafeWall.Size = Vector3.new(80, 3, 80)
    SafeWall.CFrame = CFrame.new(position)
    SafeWall.Anchored = true
    SafeWall.CanCollide = true
    SafeWall.Transparency = 0.1
    SafeWall.Material = Enum.Material.Glass
    SafeWall.Locked = true
    SafeWall.Color = Color3.fromRGB(0, 200, 255)
    SafeWall.Parent = workspace -- Mọi người đều thấy được
    WallPosition = position
end

local function TeleportToWall()
    if not SafeWall then 
        CreateSafeWall(FindSafeWallPosition())
        wait(0.1)
    end
    
    if not SafeWall then return false end
    
    local char = game.Players.LocalPlayer.Character
    if not char then return false end
    
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    
    root.CFrame = CFrame.new(SafeWall.Position + Vector3.new(0, 1.5, 0))
    IsAtWall = true
    
    local humanoid = char:FindFirstChild("Humanoid")
    if humanoid then
        humanoid.PlatformStand = false
        humanoid.Sit = false
    end
    
    return true
end

local function CheckAndKeepOnWall()
    if not AutoFarm and not FarmLV and not AutoRescue then return end
    if not SafeWall then return end
    
    local char = game.Players.LocalPlayer.Character
    if not char then return end
    
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    if root.Position.Y < WallPosition.Y - 5 then
        TeleportToWall()
    end
end

local function TeleportToItem(targetPos)
