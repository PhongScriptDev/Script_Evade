-- 8. HÀM AUTO FARM EVENT (BUBBLE)
-- =============================================
local function ScanAllBubbles()
    AllBubbles = {}
    local LocalPlayer = game.Players.LocalPlayer
    for _, obj in ipairs(workspace:GetDescendants()) do
        local name = obj.Name or ""
        if name:lower():find("bubble") then
            local position = nil
            if obj:IsA("BasePart") then
                position = obj.Position
            elseif obj:IsA("Model") then
                if obj:FindFirstChild("PrimaryPart") then
                    position = obj.PrimaryPart.Position
                elseif obj:FindFirstChild("HumanoidRootPart") then
                    position = obj.HumanoidRootPart.Position
                elseif obj:FindFirstChild("Head") then
                    position = obj.Head.Position
                else
                    local sumPos = Vector3.new(0, 0, 0)
                    local count = 0
                    for _, part in ipairs(obj:GetChildren()) do
                        if part:IsA("BasePart") then
                            sumPos = sumPos + part.Position
                            count = count + 1
                        end
                    end
                    if count > 0 then position = sumPos / count end
                end
            end
            if position then
                table.insert(AllBubbles, {
                    object = obj,
                    position = position,
                    name = obj.Name,
                    collected = false
                })
            end
        end
    end
    TotalBubbles = #AllBubbles
    return AllBubbles
end

local function TeleportToBubble(targetPos)
    local char = game.Players.LocalPlayer.Character
    if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    root.CFrame = CFrame.new(targetPos)
    return true
end

local function CollectBubble(item)
    if not item or not item.object or item.collected then return false end
    local success = false
    local clickDetector = item.object:FindFirstChild("ClickDetector")
    if clickDetector then
        pcall(function() clickDetector:FireClick() success = true end)
    end
    local proximityPrompt = item.object:FindFirstChild("ProximityPrompt")
    if proximityPrompt then
        pcall(function() proximityPrompt:Fire() success = true end)
    end
    if not success then success = true end
    if success then
        item.collected = true
        CollectedCount = CollectedCount + 1
        ShowNotification("🎈 Đã nhặt!", "Bubble #" .. CollectedCount .. "/" .. TotalBubbles, 2, Color3.fromRGB(0, 255, 255))
        return true
    end
    return false
end

local function IsBotNearPosition(pos, radius)
    radius = radius or 60
    local LocalPlayer = game.Players.LocalPlayer
    for _, player in ipairs(game.Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local enemy = player.Character
            if enemy and enemy:FindFirstChild("HumanoidRootPart") then
                if (pos - enemy.HumanoidRootPart.Position).Magnitude < radius then
                    return true
                end
            end
        end
    end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("HumanoidRootPart") then
            local name = obj.Name:lower()
            if name:find("bot") or name:find("next") or name:find("npc") then
                if (pos - obj.HumanoidRootPart.Position).Magnitude < radius then
                    return true
                end
            end
        end
    end
    return false
end

local function FarmLoop()
    if not AutoFarm then return end
    if tick() - FarmCooldown < 0.5 then return end
    local LocalPlayer = game.Players.LocalPlayer
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    if #AllBubbles == 0 or CurrentIndex > #AllBubbles then
        ScanAllBubbles()
        CurrentIndex = 1
        if #AllBubbles == 0 then
            if not IsAtWall then TeleportToWall() end
            FarmCooldown = tick()
            return
        end
    end
    local target = nil
    for i = CurrentIndex, #AllBubbles do
        if not AllBubbles[i].collected then
            target = AllBubbles[i]
            CurrentIndex = i
            break
        end
    end
    if not target then
        if not IsAtWall then TeleportToWall() end
        CurrentIndex = #AllBubbles + 1
        FarmCooldown = tick()
        return
    end
    if IsBotNearPosition(target.position, 60) then
        if not IsAtWall then TeleportToWall() end
        FarmCooldown = tick()
        return
    end
    IsAtWall = false
    TeleportToBubble(target.position)
    wait(0.1)
    CollectBubble(target)
    wait(0.1)
    TeleportToWall()
    CurrentIndex = CurrentIndex + 1
    FarmCooldown = tick()
end

