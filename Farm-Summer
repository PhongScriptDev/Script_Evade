local function UpdateServerInfo()
    pcall(function()
        local players = game.Players:GetPlayers()
        local playerCount = #players
        local maxPlayers = game.Players.MaxPlayers
        
        PlayerCountLabel:Set("👤 Players: " .. playerCount)
        MaxPlayersLabel:Set("📊 Max players: " .. maxPlayers)
        ServerIDLabel:Set("🆔 Server ID: " .. game.JobId)
        
        local info = "📋 SERVER INFORMATION\n"
        info = info .. "═══════════════════════════\n"
        info = info .. "🆔 Server ID: " .. game.JobId .. "\n"
        info = info .. "👤 Players: " .. playerCount .. "/" .. maxPlayers .. "\n"
        info = info .. "⏰ Time: " .. os.date("%H:%M:%S") .. "\n"
        info = info .. "📅 Date: " .. os.date("%d/%m/%Y") .. "\n"
        info = info .. "═══════════════════════════\n"
        
        local names = {}
        for _, p in ipairs(players) do
            table.insert(names, p.Name)
        end
        table.sort(names)
        for i, name in ipairs(names) do
            if i <= 10 then
                info = info .. "   👤 " .. name .. "\n"
            else
                info = info .. "   ... and " .. (#names - 10) .. " more\n"
                break
            end
        end
        
        ServerInfoParagraph:Set(info)
    end)
end

