    Callback = function(Value)
        AntiNextBot = Value
        if AntiNextBot then
            print("[NextBot] Bật")
            if NextBotConnection then
                NextBotConnection:Disconnect()
            end
            NextBotConnection = game:GetService("RunService").Heartbeat:Connect(function()
