    end
    
    if not ShowFPS then return end
    
    -- Tạo ScreenGui
    FPSScreenGui = Instance.new("ScreenGui")
    FPSScreenGui.Name = "FPS_Counter"
    FPSScreenGui.ResetOnSpawn = false
    FPSScreenGui.Parent = game:GetService("CoreGui")
    
    -- Tạo Frame chính (hình vuông, viền tròn, rainbow)
    FPSFrame = Instance.new("Frame")
    FPSFrame.Size = UDim2.new(0, 70, 0, 40)
    FPSFrame.Position = UDim2.new(1, -85, 0, 10) -- Góc phải trên
    FPSFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    FPSFrame.BackgroundTransparency = 0.8
    FPSFrame.BorderSizePixel = 2
    FPSFrame.ClipsDescendants = true
    FPSFrame.Parent = FPSScreenGui
    
    -- Bo góc
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = FPSFrame
    
    -- Label FPS
    FPSLabel = Instance.new("TextLabel")
    FPSLabel.Size = UDim2.new(1, 0, 1, 0)
    FPSLabel.Position = UDim2.new(0, 0, 0, 0)
    FPSLabel.Text = "FPS: 0"
    FPSLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    FPSLabel.TextSize = 14
    FPSLabel.Font = Enum.Font.GothamBold
    FPSLabel.BackgroundTransparency = 1
    FPSLabel.TextScaled = true
    FPSLabel.Parent = FPSFrame
    
    -- Cập nhật FPS
    local frameCount = 0
    local lastTime = tick()
    
    if FPSConnection then
        FPSConnection:Disconnect()
        FPSConnection = nil
    end
    
    FPSConnection = game:GetService("RunService").Heartbeat:Connect(function()
        if not ShowFPS then return end
        frameCount = frameCount + 1
        local currentTime = tick()
        if currentTime - lastTime >= 1 then
            local fps = math.floor(frameCount / (currentTime - lastTime))
            if FPSLabel then
                FPSLabel.Text = "FPS: " .. fps
            end
            frameCount = 0
            lastTime = currentTime
        end
        
        -- Cập nhật viền rainbow
        if FPSFrame then
            local hue = (tick() * 0.5) % 1
            FPSFrame.BorderColor3 = Color3.fromHSV(hue, 1, 1)
        end
    end)
end

