    zzzParts = clearEffects(zzzParts)
    sweatParts = clearEffects(sweatParts)
    smokeParts = clearEffects(smokeParts)
    exclaimParts = clearEffects(exclaimParts)
    isSleeping = false
    isWakeUpEffect = false
    speedBoosted = false
    speedIncreaseTime = 0
end)

