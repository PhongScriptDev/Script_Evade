                for i, zzz in pairs(zzzParts) do
                    if zzz and zzz.Parent then
                        zzz.Position = head.Position + Vector3.new(
                            math.sin(tick() * 0.5 + i) * 1.5,
                            2 + i * 0.5 + math.sin(tick() * 0.3 + i) * 0.3,
                            math.cos(tick() * 0.5 + i) * 1.5
