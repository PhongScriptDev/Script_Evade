local function updateEffects(char)
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    if not effectActive then return end
    
    local rootPart = char.HumanoidRootPart
    local rootPos = rootPart.Position
    
    for _, v in pairs(auraParts) do v:Destroy() end
    for _, v in pairs(dotParts) do v:Destroy() end
    for _, v in pairs(numberParts) do v:Destroy() end
    for _, v in pairs(errorParts) do v:Destroy() end
    auraParts = {}
    dotParts = {}
    numberParts = {}
    errorParts = {}
    
    if not isEnabled then return end
    
    local auraRed, auraGreen = createAuraEffect(char)
    auraRed.Position = rootPos - Vector3.new(0, 2, 0)
    auraGreen.Position = rootPos - Vector3.new(0, 2.5, 0)
    table.insert(auraParts, auraRed)
    table.insert(auraParts, auraGreen)
    
    for i = 1, 20 do
        local dot = createDotEffect(char)
        local angle = (i / 20) * math.pi * 2
        local radius = 1.5 + math.random() * 2
        dot.Position = rootPos + Vector3.new(
            math.cos(angle) * radius,
            -1 + math.random() * 0.5,
            math.sin(angle) * radius
        )
        table.insert(dotParts, dot)
    end
    
    local nums = createNumberEffect(char)
    for _, num in pairs(nums) do
        table.insert(numberParts, num)
    end
    
    local errors = createErrorEffect(char)
    for _, err in pairs(errors) do
        table.insert(errorParts, err)
    end
end

-- Toggle chính (Rayfield Gen2 chuẩn)
local Toggle = MainTab:CreateToggle({
    name = "TheKill Evolution (Enhance yourself)",
    callback = function(Value)
        isEnabled = Value
        local player = game.Players.LocalPlayer
        local char = player.Character
        
        if Value then
            -- Reset biến tốc độ
            speedBoosted = false
            speedIncreaseTime = 0
            
            -- Đặt tốc độ ban đầu
            if char and char:FindFirstChild("Humanoid") then
                char.Humanoid.WalkSpeed = baseSpeed
            end
            
            afkTimer = 0
            effectActive = true
            
            -- Loop quản lý tốc độ (đếm ngược 5 phút)
            spawn(function()
                while isEnabled and char and char:FindFirstChild("Humanoid") do
                    if not speedBoosted then
                        speedIncreaseTime = speedIncreaseTime + 1
                        
                        -- Hiển thị thời gian còn lại (mỗi 10 giây)
                        if speedIncreaseTime % 10 == 0 then
                            local remaining = math.floor((requiredTime - speedIncreaseTime) / 60)
                            local seconds = math.floor((requiredTime - speedIncreaseTime) % 60)
                            if remaining >= 0 then
                                print("Time until speed boost: " .. remaining .. "m " .. seconds .. "s")
                            end
                        end
                        
                        -- Kiểm tra nếu đủ 5 phút
                        if speedIncreaseTime >= requiredTime then
                            applySpeedBoost(char)
                        end
                    end
                    wait(1)
                end
            end)
            
            -- Loop xử lý hiệu ứng (giữ nguyên)
            spawn(function()
                local elapsed = 0
                while isEnabled and char and char:FindFirstChild("HumanoidRootPart") do
                    local rootPart = char.HumanoidRootPart
                    local rootPos = rootPart.Position
                    elapsed = elapsed + 0.05
                    
                    local humanoid = char:FindFirstChild("Humanoid")
                    if humanoid then
                        local isMoving = humanoid.MoveDirection.Magnitude > 0.1
                        if not isMoving then
                            afkTimer = afkTimer + 0.05
                            if afkTimer >= 10 and not isSleeping and humanoid.RigType == Enum.HumanoidRigType.R6 then
                                if isMale then
                                    createAfkAnimationMale(char)
                                end
                            end
                        else
                            afkTimer = 0
                            if isSleeping then
                                wakeUpMale(char)
                            end
                        end
                    end
                    
                    -- Chỉ cập nhật hiệu ứng khi không ngủ
                    if not isSleeping and effectActive then
                        -- Cập nhật aura
                        for _, part in pairs(auraParts) do
                            if part and part.Parent then
                                if part.Color == Color3.fromRGB(255, 0, 0) then
                                    part.Position = rootPos - Vector3.new(0, 2, 0)
                                    part.Size = Vector3.new(3, 0.5 + math.sin(tick() * 2) * 0.2, 3)
                                    part.Transparency = 0.3 + math.sin(tick() * 0.5) * 0.1
                                else
                                    part.Position = rootPos - Vector3.new(0, 2.5, 0)
                                    part.Size = Vector3.new(2.5, 0.5 + math.sin(tick() * 3) * 0.2, 2.5)
                                    part.Transparency = 0.3 + math.sin(tick() * 0.7) * 0.1
                                end
                            end
                        end
                        
                        -- Cập nhật dot
                        for i, dot in pairs(dotParts) do
                            if dot and dot.Parent then
                                local angle = (i / #dotParts) * math.pi * 2 + tick() * 0.5
                                local radius = 1.5 + math.sin(tick() + i) * 1.5
                                dot.Position = rootPos + Vector3.new(
                                    math.cos(angle) * radius,
                                    -1 + math.sin(tick() * 0.5 + i) * 0.5,
                                    math.sin(angle) * radius
                                )
                                local hue = (tick() * 0.1 + i / #dotParts) % 1
                                dot.Color = Color3.fromHSV(hue, 1, 1)
                                local moveFactor = humanoid and humanoid.MoveDirection.Magnitude or 0
                                dot.Transparency = 0.3 + math.sin(tick() * 0.5 + i) * 0.2 + moveFactor * 0.5
                            end
                        end
                        
                        -- Cập nhật số
                        for i, num in pairs(numberParts) do
                            if num and num.Parent then
                                local angle = (i / #numberParts) * math.pi * 2 + tick() * 0.3
                                local radius = 2 + math.sin(tick() * 0.5 + i) * 1.5
                                local yPos = -1 + (tick() * 0.2 + i * 0.1) % 3
                                
                                if yPos < 1.5 then
                                    num.Position = rootPos + Vector3.new(
                                        math.cos(angle) * radius,
                                        yPos,
                                        math.sin(angle) * radius
                                    )
                                    num.Position = num.Position + Vector3.new(
                                        math.sin(tick() * 10 + i) * 0.1,
                                        0,
                                        math.cos(tick() * 10 + i) * 0.1
                                    )
                                else
                                    local splitAngle = angle + math.sin(tick() * 2 + i) * 0.5
                                    num.Position = rootPos + Vector3.new(
                                        math.cos(splitAngle) * (radius + math.sin(tick() * 3 + i) * 0.5),
                                        1.5 + math.sin(tick() * 0.5 + i) * 0.2,
                                        math.sin(splitAngle) * (radius + math.cos(tick() * 3 + i) * 0.5)
                                    )
                                    num.Transparency = math.min(num.Transparency + 0.01, 1)
                                end
                            end
                        end
                        
                        -- Cập nhật Error!
                        for i, err in pairs(errorParts) do
                            if err and err.Parent then
                                local angle = (i / #errorParts) * math.pi * 2 + tick() * 0.2
                                local radius = 1 + math.sin(tick() * 0.3 + i) * 1.5
                                local yPos = -2 + (tick() * 0.15 + i * 0.05) % 3.5
                                
                                if yPos < 2.5 then
                                    err.Position = rootPos + Vector3.new(
                                        math.cos(angle) * radius,
                                        yPos,
                                        math.sin(angle) * radius
                                    )
                                    err.Position = err.Position + Vector3.new(
                                        math.sin(tick() * 15 + i * 2) * 0.15,
                                        math.cos(tick() * 12 + i * 1.5) * 0.15,
                                        math.sin(tick() * 18 + i * 2.5) * 0.15
                                    )
                                    err.Color = Color3.fromRGB(
                                        math.random(150, 255),
                                        math.random(0, 50),
                                        math.random(0, 50)
                                    )
                                    err.Transparency = 0.2 + math.sin(tick() * 2 + i) * 0.3
                                else
                                    err.Position = rootPos + Vector3.new(
                                        math.cos(angle + tick() * 2) * (radius + math.sin(tick() * 4 + i) * 0.3),
                                        2.5 + math.sin(tick() * 0.3 + i) * 0.2,
                                        math.sin(angle + tick() * 2) * (radius + math.cos(tick() * 4 + i) * 0.3)
                                    )
                                    err.Transparency = math.min(err.Transparency + 0.015, 1)
                                    err.Position = err.Position + Vector3.new(
                                        math.sin(tick() * 8 + i) * 0.05 * (1 - err.Transparency),
                                        0,
                                        math.cos(tick() * 8 + i) * 0.05 * (1 - err.Transparency)
                                    )
                                end
                            end
                        end
                    end
                    
                    wait(0.05)
                end
            end)
            
        else
            -- Tắt: reset
            speedBoosted = false
            speedIncreaseTime = 0
            
            if char and char:FindFirstChild("Humanoid") then
                char.Humanoid.WalkSpeed = baseSpeed
                if isSleeping then
                    wakeUpMale(char)
                end
            end
            
            -- Xóa tất cả
            for _, v in pairs(auraParts) do
                spawn(function()
                    for i = 1, 10 do
                        v.Transparency = v.Transparency + 0.1
                        wait(0.05)
                    end
                    v:Destroy()
                end)
            end
            
            for _, v in pairs(dotParts) do
                spawn(function()
                    for i = 1, 10 do
                        v.Transparency = v.Transparency + 0.1
                        wait(0.05)
                    end
                    v:Destroy()
                end)
            end
            
            for _, v in pairs(numberParts) do
                spawn(function()
                    for i = 1, 10 do
                        v.Transparency = v.Transparency + 0.1
                        wait(0.05)
                    end
                    v:Destroy()
                end)
            end
            
            for _, v in pairs(errorParts) do
                spawn(function()
                    for i = 1, 10 do
                        v.Transparency = v.Transparency + 0.1
                        wait(0.05)
                    end
                    v:Destroy()
                end)
            end
            
            wait(0.5)
            auraParts = {}
            dotParts = {}
            numberParts = {}
            errorParts = {}
            isSleeping = false
            afkTimer = 0
            effectActive = true
        end
    end
})

