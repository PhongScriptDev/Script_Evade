end

-- Hàm xóa hiệu ứng
local function clearEffects(effects)
    for _, v in pairs(effects) do
        pcall(function() v:Destroy() end)
    end
    return {}
end

-- Hàm update hiệu ứng
local function updateEffects(char)
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    if not isEnabled then return end
    
    local rootPart = char.HumanoidRootPart
    local rootPos = rootPart.Position
    
    -- Xóa dot cũ
    dotParts = clearEffects(dotParts)
    
    -- Tạo dot mới
    for i = 1, 20 do
        local dot = createDotEffect(char)
        local angle = (i / 20) * math.pi * 2
        local radius = 1.5 + math.random() * 2
        dot.Position = rootPos + Vector3.new(
            math.cos(angle) * radius,
            -1 + math.random() * 0.5,
            math.sin(angle) * radius
        )
        table.insert(dotParts, dot)
    end
end

-- Hàm xử lý AFK
local function handleAfk(char)
    if not char or not char:FindFirstChild("Head") then return end
    if isSleeping then return end
    
    isSleeping = true
    zzzParts = createZzzEffect(char)
    
    spawn(function()
        while isSleeping and char and char:FindFirstChild("Head") do
            local head = char.Head
            for i, zzz in pairs(zzzParts) do
                if zzz and zzz.Parent then
                    zzz.Position = head.Position + Vector3.new(
                        math.sin(tick() * 0.5 + i) * 1.5,
                        2 + i * 0.5 + math.sin(tick() * 0.3 + i) * 0.3,
                        math.cos(tick() * 0.5 + i) * 1.5
                    )
                    zzz.Transparency = 0.3 + math.sin(tick() * 0.5 + i) * 0.2
                end
            end
            wait(0.1)
        end
    end)
end

-- Hàm thức dậy
local function wakeUp(char)
    if not isSleeping then return end
    isSleeping = false
    
    local head = char:FindFirstChild("Head")
    if not head then return end
    
    -- Tạo !
    local exclaim = Instance.new("Part")
    exclaim.Size = Vector3.new(0.5, 0.5, 0.5)
    exclaim.Shape = Enum.PartType.Ball
    exclaim.Material = Enum.Material.Neon
    exclaim.Color = Color3.fromRGB(255, 255, 0)
    exclaim.Anchored = true
    exclaim.CanCollide = false
    exclaim.Parent = workspace
    
    local textLabel = Instance.new("BillboardGui", exclaim)
    textLabel.Size = UDim2.new(2, 0, 2, 0)
    textLabel.AlwaysOnTop = true
    
    local text = Instance.new("TextLabel", textLabel)
    text.Size = UDim2.new(1, 0, 1, 0)
    text.BackgroundTransparency = 1
    text.Text = "!"
    text.TextColor3 = Color3.fromRGB(255, 255, 0)
    text.TextScaled = true
    text.Font = Enum.Font.GothamBold
    
    exclaim.Position = head.Position + Vector3.new(0, 2, 0)
    
    spawn(function()
        for i = 1, 20 do
            exclaim.Transparency = i / 20
            exclaim.Position = exclaim.Position + Vector3.new(0, 0.05, 0)
            wait(0.05)
        end
        exclaim:Destroy()
    end)
    
    -- Xóa Zzz
    zzzParts = clearEffects(zzzParts)
end

-- Toggle chính
local Toggle = MainTab:CreateToggle({
    name = "TheKill Evolution (Enhance yourself)",
    callback = function(Value)
        isEnabled = Value
        local player = game.Players.LocalPlayer
        local char = player.Character
        
        if Value then
            speedBoosted = false
            speedIncreaseTime = 0
            
            if char and char:FindFirstChild("Humanoid") then
                char.Humanoid.WalkSpeed = baseSpeed
            end
            
            if char then
                updateEffects(char)
            end
            
            -- Loop tăng tốc
            spawn(function()
                while isEnabled and char and char:FindFirstChild("Humanoid") do
                    if not speedBoosted then
                        speedIncreaseTime = speedIncreaseTime + 1
                        if speedIncreaseTime >= requiredTime then
                            applySpeedBoost(char)
                        end
                    end
                    wait(1)
                end
            end)
            
            -- Loop chính (xử lý tất cả hiệu ứng)
            spawn(function()
                local lastPos = Vector3.new()
                local isJumping = false
                
                while isEnabled and char and char:FindFirstChild("HumanoidRootPart") do
                    local rootPart = char.HumanoidRootPart
                    local rootPos = rootPart.Position
                    local humanoid = char:FindFirstChild("Humanoid")
                    
                    if humanoid then
                        local isMoving = humanoid.MoveDirection.Magnitude > 0.1
                        local velocity = humanoid.Velocity
                        local isInAir = velocity.Y > 1 or velocity.Y < -1
                        
                        -- Xử lý AFK
                        if not isMoving then
                            afkTimer = afkTimer + 0.05
                            if afkTimer >= 10 and not isSleeping then
                                handleAfk(char)
                            end
                        else
                            afkTimer = 0
                            if isSleeping then
                                wakeUp(char)
                            end
                        end
                        
                        -- === HIỆU ỨNG SUY NGHĨ ===
                        
                        -- 1. Mồ hôi khi di chuyển (chảy từ mặt xuống)
                        if isMoving and not isInAir then
                            -- Tạo mồ hôi mới
                            if #sweatParts < 8 then
                                local newSweats = createSweatEffect(char)
                                for _, sweat in pairs(newSweats) do
                                    table.insert(sweatParts, sweat)
                                end
                            end
                            
                            -- Cập nhật mồ hôi chảy xuống
                            for i, sweat in pairs(sweatParts) do
                                if sweat and sweat.Parent then
                                    -- Di chuyển xuống dần
                                    sweat.Position = sweat.Position + Vector3.new(0, -0.05, 0)
                                    sweat.Transparency = sweat.Transparency + 0.01
                                    
                                    -- Xóa khi chảy xuống chân hoặc quá mờ
                                    if sweat.Position.Y < rootPos.Y - 1.5 or sweat.Transparency > 0.9 then
                                        sweat:Destroy()
                                        table.remove(sweatParts, i)
                                    end
                                end
                            end
                        else
                            -- Xóa mồ hôi khi không di chuyển
                            sweatParts = clearEffects(sweatParts)
                        end
                        
                        -- 2. Khói khi nhảy
                        if isInAir and not isJumping then
                            isJumping = true
                            -- Tạo khói dưới chân
                            local newSmokes = createSmokeEffect(char)
                            for _, smoke in pairs(newSmokes) do
                                table.insert(smokeParts, smoke)
                            end
                        elseif not isInAir then
                            isJumping = false
                            -- Xóa khói từ từ
                            for i, smoke in pairs(smokeParts) do
                                if smoke and smoke.Parent then
                                    smoke.Transparency = smoke.Transparency + 0.05
                                    if smoke.Transparency > 0.95 then
                                        smoke:Destroy()
                                        table.remove(smokeParts, i)
                                    end
                                end
                            end
                        end
                        
                        -- Cập nhật khói (bay lên và lan tỏa)
                        for _, smoke in pairs(smokeParts) do
                            if smoke and smoke.Parent then
                                smoke.Position = smoke.Position + Vector3.new(
                                    math.sin(tick() + math.random()) * 0.02,
                                    0.03,
                                    math.cos(tick() + math.random()) * 0.02
                                )
                                smoke.Size = smoke.Size + Vector3.new(0.02, 0.02, 0.02)
                                smoke.Transparency = math.min(smoke.Transparency + 0.005, 1)
                            end
                        end
                    end
                    
                    -- Cập nhật dot (dấu chấm)
                    for i, dot in pairs(dotParts) do
                        if dot and dot.Parent then
                            local angle = (i / #dotParts) * math.pi * 2 + tick() * 0.5
                            local radius = 1.5 + math.sin(tick() + i) * 1.5
                            dot.Position = rootPos + Vector3.new(
                                math.cos(angle) * radius,
                                -1 + math.sin(tick() * 0.5 + i) * 0.5,
                                math.sin(angle) * radius
                            )
                            local hue = (tick() * 0.1 + i / #dotParts) % 1
                            dot.Color = Color3.fromHSV(hue, 1, 1)
                            
                            local moveFactor = humanoid and humanoid.MoveDirection.Magnitude or 0
                            dot.Transparency = 0.3 + math.sin(tick() * 0.5 + i) * 0.2 + moveFactor * 0.3
                        end
                    end
                    
                    -- Lưu vị trí cũ để check di chuyển
                    lastPos = rootPos
                    wait(0.05)
                end
            end)
            
        else
            -- Tắt toggle
            speedBoosted = false
            speedIncreaseTime = 0
            
            if char and char:FindFirstChild("Humanoid") then
                char.Humanoid.WalkSpeed = baseSpeed
                if isSleeping then
                    wakeUp(char)
                end
            end
            
            -- Xóa tất cả effect
            dotParts = clearEffects(dotParts)
            sweatParts = clearEffects(sweatParts)
            smokeParts = clearEffects(smokeParts)
            zzzParts = clearEffects(zzzParts)
            
            isSleeping = false
            afkTimer = 0
        end
    end
})

game.Players.LocalPlayer.CharacterAdded:Connect(function(char)
    if isEnabled then
        wait(1)
        speedBoosted = false
        speedIncreaseTime = 0
        if char and char:FindFirstChild("Humanoid") then
            char.Humanoid.WalkSpeed = baseSpeed
        end
        updateEffects(char)
    end
end)

game.Players.LocalPlayer.CharacterRemoving:Connect(function()
    dotParts = clearEffects(dotParts)
    sweatParts = clearEffects(sweatParts)
    smokeParts = clearEffects(smokeParts)
    zzzParts = clearEffects(zzzParts)
    isSleeping = false
    speedBoosted = false
    speedIncreaseTime = 0
end)

print("Rayfield Gen2 Script loaded! (With sweat and smoke effects)")
