local Rayfield = loadstring(game:HttpGet("https://sirius.menu/gen2"))()

local Window = Rayfield:CreateWindow({
    name = "Anti-total & Aura farm",
    subtitle = "TheKill Evolution"
})

local MainTab = Window:CreateTab({
    name = "Anti-total & Aura farm",
    icon = 4483362458
})

-- Biến trạng thái
local isEnabled = false
local dotParts = {}
local zzzParts = {}
local sweatParts = {}
local smokeParts = {}
local isSleeping = false
local afkTimer = 0
local isMale = true

-- Biến quản lý tốc độ
local speedBoosted = false
local speedIncreaseTime = 0
local requiredTime = 300
local baseSpeed = 16
local boostSpeed = 17

-- Hàm tăng tốc độ
local function applySpeedBoost(char)
    if not char or not char:FindFirstChild("Humanoid") then return end
    if speedBoosted then return end
    
    speedBoosted = true
    char.Humanoid.WalkSpeed = boostSpeed
    
    local notif = Instance.new("Part")
    notif.Size = Vector3.new(2, 1, 2)
    notif.Shape = Enum.PartType.Block
    notif.Material = Enum.Material.Neon
    notif.Color = Color3.fromRGB(0, 255, 0)
    notif.Anchored = true
    notif.CanCollide = false
    notif.Transparency = 0.3
    notif.Parent = workspace
    
    local textLabel = Instance.new("BillboardGui", notif)
    textLabel.Size = UDim2.new(4, 0, 2, 0)
    textLabel.AlwaysOnTop = true
    
    local text = Instance.new("TextLabel", textLabel)
    text.Size = UDim2.new(1, 0, 1, 0)
    text.BackgroundTransparency = 1
    text.Text = "⚡ SPEED BOOSTED! 16 → 17 ⚡"
    text.TextColor3 = Color3.fromRGB(0, 255, 255)
    text.TextScaled = true
    text.Font = Enum.Font.GothamBold
    
    notif.Position = char.HumanoidRootPart.Position + Vector3.new(0, 4, 0)
    
    spawn(function()
        for i = 1, 30 do
            notif.Transparency = i / 30
            notif.Position = notif.Position + Vector3.new(0, 0.1, 0)
            wait(0.05)
        end
        notif:Destroy()
    end)
end

-- Hàm tạo hiệu ứng dấu chấm "."
local function createDotEffect(char)
    local dot = Instance.new("Part")
    dot.Size = Vector3.new(0.2, 0.2, 0.2)
    dot.Shape = Enum.PartType.Ball
    dot.Material = Enum.Material.Neon
    dot.Anchored = true
    dot.CanCollide = false
    dot.Transparency = 0
    dot.Parent = workspace
    
    local attachment0 = Instance.new("Attachment", dot)
    local attachment1 = Instance.new("Attachment", dot)
    attachment1.Position = Vector3.new(0, 1, 0)
    
    local beam = Instance.new("Beam", dot)
    beam.Attachment0 = attachment0
    beam.Attachment1 = attachment1
    beam.Width0 = 0.1
    beam.Width1 = 0.1
    beam.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
        ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 255, 0)),
        ColorSequenceKeypoint.new(0.4, Color3.fromRGB(0, 255, 0)),
        ColorSequenceKeypoint.new(0.6, Color3.fromRGB(0, 255, 255)),
        ColorSequenceKeypoint.new(0.8, Color3.fromRGB(0, 0, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 255))
    })
    
    return dot
end

-- HÀM TẠO HIỆU ỨNG MỒ HÔI (suy nghĩ khi di chuyển)
local function createSweatEffect(char)
    local head = char:FindFirstChild("Head")
    if not head then return {} end
    
    local sweats = {}
    for i = 1, 8 do
        local sweat = Instance.new("Part")
        sweat.Size = Vector3.new(0.08, 0.15, 0.08)
        sweat.Shape = Enum.PartType.Ball
        sweat.Material = Enum.Material.Neon
        sweat.Color = Color3.fromRGB(100, 200, 255)
        sweat.Anchored = true
        sweat.CanCollide = false
        sweat.Transparency = 0.4
        sweat.Parent = workspace
        
        -- Thêm Trail để tạo hiệu ứng chảy
        local trail = Instance.new("Trail", sweat)
        trail.Lifetime = 0.5
        trail.MinLength = 0.1
        trail.MaxLength = 0.5
        trail.WidthScale = NumberSequence.new(0.5, 0)
        trail.Color = ColorSequence.new(Color3.fromRGB(100, 200, 255))
        trail.Transparency = NumberSequence.new(0.3, 1)
        
        local angle = math.random() * math.pi * 2
        local radius = 0.5 + math.random() * 0.3
        sweat.Position = head.Position + Vector3.new(
            math.cos(angle) * radius,
            -0.3 + math.random() * 0.2,
            math.sin(angle) * radius
        )
        
        table.insert(sweats, sweat)
    end
    return sweats
end

-- HÀM TẠO HIỆU ỨNG KHÓI (suy nghĩ khi nhảy)
local function createSmokeEffect(char)
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    if not rootPart then return {} end
    
    local smokes = {}
    for i = 1, 6 do
        local smoke = Instance.new("Part")
        smoke.Size = Vector3.new(0.5, 0.5, 0.5)
        smoke.Shape = Enum.PartType.Ball
        smoke.Material = Enum.Material.Neon
        smoke.Color = Color3.fromRGB(200, 200, 200)
        smoke.Anchored = true
        smoke.CanCollide = false
        smoke.Transparency = 0.6
        smoke.Parent = workspace
        
        -- ParticleEmitter cho khói chân thật
        local particles = Instance.new("ParticleEmitter", smoke)
        particles.Texture = "rbxasset://textures/particles/fog_main.dds"
        particles.Rate = 20
        particles.Lifetime = NumberRange.new(1, 2)
        particles.SpreadAngle = Vector2.new(360, 360)
        particles.Speed = NumberRange.new(0.5, 1.5)
        particles.Drag = 2
        particles.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.5),
            NumberSequenceKeypoint.new(0.5, 0.7),
            NumberSequenceKeypoint.new(1, 1)
        })
        particles.Size = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.5),
            NumberSequenceKeypoint.new(1, 2)
        })
        particles.Color = ColorSequence.new(Color3.fromRGB(200, 200, 200))
        
        local angle = math.random() * math.pi * 2
        local radius = 1 + math.random() * 0.5
        smoke.Position = rootPart.Position + Vector3.new(
            math.cos(angle) * radius,
            0.2 + math.random() * 0.3,
            math.sin(angle) * radius
        )
        
        table.insert(smokes, smoke)
    end
    return smokes
end

-- Hàm tạo Zzz
local function createZzzEffect(char)
    local zzzParts = {}
    local head = char:FindFirstChild("Head")
    if not head then return zzzParts end
    
    for i = 1, 3 do
        local zzz = Instance.new("Part")
        zzz.Size = Vector3.new(0.3, 0.3, 0.3)
        zzz.Shape = Enum.PartType.Ball
        zzz.Material = Enum.Material.Neon
        zzz.Color = Color3.fromRGB(100, 200, 255)
        zzz.Anchored = true
        zzz.CanCollide = false
        zzz.Transparency = 0
        zzz.Parent = workspace
        
        local textLabel = Instance.new("BillboardGui", zzz)
        textLabel.Size = UDim2.new(2, 0, 2, 0)
        textLabel.AlwaysOnTop = true
        
        local text = Instance.new("TextLabel", textLabel)
        text.Size = UDim2.new(1, 0, 1, 0)
        text.BackgroundTransparency = 1
        text.Text = "Zzz"
        text.TextColor3 = Color3.fromRGB(100, 200, 255)
        text.TextScaled = true
        text.Font = Enum.Font.GothamBold
        
        zzz.Position = head.Position + Vector3.new(math.random(-2, 2), 2 + i * 0.5, math.random(-2, 2))
