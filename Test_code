-- Biến trạng thái
local isEnabled = false
local dotParts = {}
local zzzParts = {}
local sweatParts = {}
local smokeParts = {}
local exclaimParts = {}
local isSleeping = false
local afkTimer = 0
local isWakeUpEffect = false

-- Biến quản lý tốc độ
local speedBoosted = false
local speedIncreaseTime = 0
local requiredTime = 300
local baseSpeed = 16
local boostSpeed = 17

-- Hàm tăng tốc độ
local function applySpeedBoost(char)
    if not char or not char:FindFirstChild("Humanoid") then return end
    if speedBoosted then return end
    
    speedBoosted = true
    char.Humanoid.WalkSpeed = boostSpeed
    
    local notif = Instance.new("Part")
    notif.Size = Vector3.new(2, 1, 2)
    notif.Shape = Enum.PartType.Block
    notif.Material = Enum.Material.Neon
    notif.Color = Color3.fromRGB(0, 255, 0)
    notif.Anchored = true
    notif.CanCollide = false
    notif.Transparency = 0.3
    notif.Parent = workspace
    
    local textLabel = Instance.new("BillboardGui", notif)
    textLabel.Size = UDim2.new(4, 0, 2, 0)
    textLabel.AlwaysOnTop = true
    
    local text = Instance.new("TextLabel", textLabel)
    text.Size = UDim2.new(1, 0, 1, 0)
    text.BackgroundTransparency = 1
    text.Text = "⚡ SPEED BOOSTED! 16 → 17 ⚡"
    text.TextColor3 = Color3.fromRGB(0, 255, 255)
    text.TextScaled = true
    text.Font = Enum.Font.GothamBold
    
    notif.Position = char.HumanoidRootPart.Position + Vector3.new(0, 4, 0)
    
    spawn(function()
        for i = 1, 30 do
            notif.Transparency = i / 30
            notif.Position = notif.Position + Vector3.new(0, 0.1, 0)
            wait(0.05)
        end
        notif:Destroy()
    end)
end

-- HÀM TẠO DẤU CHẤM
local function createDot()
    local dot = Instance.new("Part")
    dot.Size = Vector3.new(0.3, 0.3, 0.3)
    dot.Shape = Enum.PartType.Ball
    dot.Material = Enum.Material.Neon
    dot.Color = Color3.fromHSV(math.random(), 1, 1)
    dot.Anchored = true
    dot.CanCollide = false
    dot.Transparency = 0.2
    dot.Parent = workspace
    
    -- Beam phát sáng
    local att0 = Instance.new("Attachment", dot)
    local att1 = Instance.new("Attachment", dot)
    att1.Position = Vector3.new(0, 0.5, 0)
    
    local beam = Instance.new("Beam", dot)
    beam.Attachment0 = att0
    beam.Attachment1 = att1
    beam.Width0 = 0.2
    beam.Width1 = 0.2
    beam.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, dot.Color),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(1, dot.Color)
    })
    
    return dot
end

-- HÀM TẠO ZZZ
local function createZzz(char)
    local head = char:FindFirstChild("Head")
    if not head then return {} end
    
    local parts = {}
    for i = 1, 3 do
        local zzz = Instance.new("Part")
        zzz.Size = Vector3.new(0.3, 0.3, 0.3)
        zzz.Shape = Enum.PartType.Ball
        zzz.Material = Enum.Material.Neon
        zzz.Color = Color3.fromRGB(100, 200, 255)
        zzz.Anchored = true
        zzz.CanCollide = false
        zzz.Transparency = 0.2
        zzz.Parent = workspace
        
        local textLabel = Instance.new("BillboardGui", zzz)
        textLabel.Size = UDim2.new(2, 0, 2, 0)
        textLabel.AlwaysOnTop = true
        
        local text = Instance.new("TextLabel", textLabel)
        text.Size = UDim2.new(1, 0, 1, 0)
        text.BackgroundTransparency = 1
        text.Text = "Zzz"
        text.TextColor3 = Color3.fromRGB(100, 200, 255)
        text.TextScaled = true
        text.Font = Enum.Font.GothamBold
        
        -- Lưu offset
        zzz.Offset = Vector3.new(math.random(-2, 2), 2 + i * 0.5, math.random(-2, 2))
        zzz.Angle = math.random() * math.pi * 2
        zzz.Speed = 0.3 + math.random() * 0.3
        
        zzz.Position = head.Position + zzz.Offset
        table.insert(parts, zzz)
    end
    return parts
end

-- HÀM TẠO MỒ HÔI
local function createSweat(char)
    local head = char:FindFirstChild("Head")
    if not head then return {} end
    
    local parts = {}
    for i = 1, 4 do
        local sweat = Instance.new("Part")
        sweat.Size = Vector3.new(0.1, 0.15, 0.1)
        sweat.Shape = Enum.PartType.Ball
        sweat.Material = Enum.Material.Neon
        sweat.Color = Color3.fromRGB(150, 200, 255)
        sweat.Anchored = true
        sweat.CanCollide = false
        sweat.Transparency = 0.3
        sweat.Parent = workspace
        
        -- Trail
        local trail = Instance.new("Trail", sweat)
        trail.Lifetime = 0.8
        trail.MinLength = 0.05
        trail.MaxLength = 0.3
        trail.WidthScale = NumberSequence.new(0.3, 0)
        trail.Color = ColorSequence.new(Color3.fromRGB(150, 200, 255))
        trail.Transparency = NumberSequence.new(0.3, 1)
        
        local angle = math.random() * math.pi * 2
        local radius = 0.4 + math.random() * 0.3
        sweat.Offset = Vector3.new(
            math.cos(angle) * radius,
            -0.3 + math.random() * 0.2,
            math.sin(angle) * radius
        )
        sweat.DropSpeed = 0.02 + math.random() * 0.03
        
        sweat.Position = head.Position + sweat.Offset
        table.insert(parts, sweat)
    end
    return parts
end

-- HÀM TẠO KHÓI
local function createSmoke(char)
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    if not rootPart then return {} end
    
    local parts = {}
    for i = 1, 5 do
        local smoke = Instance.new("Part")
        smoke.Size = Vector3.new(0.5, 0.5, 0.5)
        smoke.Shape = Enum.PartType.Ball
        smoke.Material = Enum.Material.Neon
        smoke.Color = Color3.fromRGB(200, 200, 200)
        smoke.Anchored = true
        smoke.CanCollide = false
        smoke.Transparency = 0.6
        smoke.Parent = workspace
        
        -- Particle
        local particles = Instance.new("ParticleEmitter", smoke)
        particles.Texture = "rbxasset://textures/particles/fog_main.dds"
        particles.Rate = 15
        particles.Lifetime = NumberRange.new(1, 2)
        particles.SpreadAngle = Vector2.new(360, 360)
        particles.Speed = NumberRange.new(0.3, 1)
        particles.Drag = 3
        particles.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.5),
            NumberSequenceKeypoint.new(0.5, 0.7),
            NumberSequenceKeypoint.new(1, 1)
        })
        particles.Size = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.3),
            NumberSequenceKeypoint.new(1, 1.5)
        })
        particles.Color = ColorSequence.new(Color3.fromRGB(200, 200, 200))
        
        local angle = math.random() * math.pi * 2
        local radius = 0.5 + math.random() * 0.5
        smoke.Offset = Vector3.new(
            math.cos(angle) * radius,
            0.2 + math.random() * 0.3,
            math.sin(angle) * radius
        )
        
        smoke.Position = rootPart.Position + smoke.Offset
        table.insert(parts, smoke)
    end
    return parts
end

-- HÀM TẠO !
local function createExclaim(char)
    local head = char:FindFirstChild("Head")
    if not head then return end
    
    local exclaim = Instance.new("Part")
    exclaim.Size = Vector3.new(0.5, 0.5, 0.5)
    exclaim.Shape = Enum.PartType.Ball
    exclaim.Material = Enum.Material.Neon
    exclaim.Color = Color3.fromRGB(255, 255, 0)
    exclaim.Anchored = true
    exclaim.CanCollide = false
    exclaim.Transparency = 0
    exclaim.Parent = workspace
    
    local textLabel = Instance.new("BillboardGui", exclaim)
    textLabel.Size = UDim2.new(2, 0, 2, 0)
    textLabel.AlwaysOnTop = true
    
    local text = Instance.new("TextLabel", textLabel)
    text.Size = UDim2.new(1, 0, 1, 0)
    text.BackgroundTransparency = 1
    text.Text = "!"
    text.TextColor3 = Color3.fromRGB(255, 255, 0)
    text.TextScaled = true
    text.Font = Enum.Font.GothamBold
    
    exclaim.Position = head.Position + Vector3.new(0, 2, 0)
    exclaim.YOffset = 0
    
    table.insert(exclaimParts, exclaim)
    return exclaim
end

-- HÀM XÓA EFFECT
local function clearEffects(effects)
    for _, v in pairs(effects) do
        pcall(function() v:Destroy() end)
    end
    return {}
end

-- Toggle chính
local Toggle = MainTab:CreateToggle({
    name = "TheKill Evolution (Enhance yourself)",
    callback = function(Value)
        isEnabled = Value
        local player = game.Players.LocalPlayer
        local char = player.Character
        
        if Value then
            speedBoosted = false
            speedIncreaseTime = 0
            afkTimer = 0
            isSleeping = false
            
            if char and char:FindFirstChild("Humanoid") then
                char.Humanoid.WalkSpeed = baseSpeed
            end
            
            -- Tạo dot ban đầu
            if char then
                for i = 1, 25 do
                    local dot = createDot()
                    table.insert(dotParts, dot)
                end
                print("Created " .. #dotParts .. " dots")
            end
            
            -- Loop tăng tốc
            spawn(function()
                while isEnabled and char and char:FindFirstChild("Humanoid") do
                    if not speedBoosted then
                        speedIncreaseTime = speedIncreaseTime + 1
                        if speedIncreaseTime >= requiredTime then
                            applySpeedBoost(char)
                        end
                    end
                    wait(1)
                end
            end)
            
            -- Loop chính
            spawn(function()
                while isEnabled and char do
                    local humanoid = char:FindFirstChild("Humanoid")
                    local rootPart = char:FindFirstChild("HumanoidRootPart")
                    local head = char:FindFirstChild("Head")
                    
                    if humanoid and rootPart and head then
                        local rootPos = rootPart.Position
                        local isMoving = humanoid.MoveDirection.Magnitude > 0.1
                        local velocity = humanoid.Velocity
                        local isInAir = velocity.Y > 1.5 or velocity.Y < -1.5
                        
                        -- === XỬ LÝ AFK ===
                        if not isMoving and not isInAir then
                            afkTimer = afkTimer + 0.05
                            if afkTimer >= 10 and not isSleeping then
                                isSleeping = true
                                zzzParts = createZzz(char)
                                print("Zzz created: " .. #zzzParts)
                            end
                        else
                            afkTimer = 0
                            if isSleeping then
                                isSleeping = false
                                -- Xóa Zzz từ từ
                                for _, zzz in pairs(zzzParts) do
                                    spawn(function()
                                        for i = 1, 15 do
                                            if zzz and zzz.Parent then
                                                zzz.Transparency = zzz.Transparency + 0.07
                                                wait(0.05)
                                            end
                                        end
                                        pcall(function() zzz:Destroy() end)
                                    end)
                                end
                                wait(0.5)
                                zzzParts = {}
                                
                                -- Tạo !
                                if not isWakeUpEffect then
                                    isWakeUpEffect = true
                                    createExclaim(char)
                                    print("! created")
                                    wait(1)
                                    isWakeUpEffect = false
                                end
                            end
                        end
                        
                        -- === UPDATE DOT ===
                        for i, dot in pairs(dotParts) do
                            if dot and dot.Parent then
                                local angle = (i / #dotParts) * math.pi * 2 + tick() * 0.8
                                local radius = 1.8 + math.sin(tick() * 0.5 + i) * 0.8
                                local height = -0.5 + math.sin(tick() * 0.7 + i * 0.3) * 0.5
                                
                                dot.Position = rootPos + Vector3.new(
                                    math.cos(angle) * radius,
                                    height,
                                    math.sin(angle) * radius
                                )
                                
                                local hue = (tick() * 0.15 + i / #dotParts) % 1
                                dot.Color = Color3.fromHSV(hue, 1, 1)
                                dot.Transparency = 0.2 + math.sin(tick() * 0.5 + i) * 0.15
                            end
                        end
                        
                        -- === UPDATE ZZZ ===
                        if isSleeping then
                            for i, zzz in pairs(zzzParts) do
                                if zzz and zzz.Parent then
                                    local offset = zzz.Offset or Vector3.new(0, 2 + i * 0.5, 0)
                                    local angle = (zzz.Angle or 0) + tick() * (zzz.Speed or 0.3)
                                    local radius = 0.5 + math.sin(tick() * 0.3 + i) * 0.3
                                    
                                    local finalOffset = Vector3.new(
                                        math.cos(angle) * radius + offset.X,
                                        offset.Y + math.sin(tick() * 0.2 + i) * 0.3,
                                        math.sin(angle) * radius + offset.Z
                                    )
                                    
                                    zzz.Position = head.Position + finalOffset
                                    zzz.Transparency = 0.2 + math.sin(tick() * 0.5 + i * 1.5) * 0.2
                                end
                            end
                        end
                        
                        -- === UPDATE MỒ HÔI ===
                        if isMoving and not isInAir then
                            if #sweatParts < 6 and math.random() < 0.3 then
                                local newSweats = createSweat(char)
                                for _, sweat in pairs(newSweats) do
                                    table.insert(sweatParts, sweat)
                                end
                            end
                            
                            for i, sweat in pairs(sweatParts) do
                                if sweat and sweat.Parent then
                                    sweat.Position = sweat.Position + Vector3.new(0, -(sweat.DropSpeed or 0.02), 0)
                                    sweat.Transparency = sweat.Transparency + 0.008
                                    
                                    if sweat.Position.Y < rootPos.Y - 1.2 or sweat.Transparency > 0.9 then
                                        pcall(function() sweat:Destroy() end)
                                        table.remove(sweatParts, i)
                                    end
                                end
                            end
                        else
                            if #sweatParts > 0 then
                                for i = #sweatParts, 1, -1 do
                                    local sweat = sweatParts[i]
                                    if sweat and sweat.Parent then
                                        sweat.Transparency = sweat.Transparency + 0.05
                                        if sweat.Transparency > 0.9 then
                                            pcall(function() sweat:Destroy() end)
                                            table.remove(sweatParts, i)
                                        end
                                    else
                                        table.remove(sweatParts, i)
                                    end
                                end
                            end
                        end
                        
                        -- === UPDATE KHÓI ===
                        if isInAir then
                            if #smokeParts < 10 then
                                local newSmokes = createSmoke(char)
                                for _, smoke in pairs(newSmokes) do
                                    table.insert(smokeParts, smoke)
                                end
                            end
                        end
                        
                        for i, smoke in pairs(smokeParts) do
                            if smoke and smoke.Parent then
                                smoke.Position = smoke.Position + Vector3.new(
                                    math.sin(tick() + i) * 0.02,
                                    0.03,
                                    math.cos(tick() + i) * 0.02
                                )
                                smoke.Size = smoke.Size + Vector3.new(0.02, 0.02, 0.02)
                                smoke.Transparency = math.min(smoke.Transparency + 0.005, 1)
                                
                                if smoke.Transparency > 0.95 or smoke.Size.X > 2 then
                                    pcall(function() smoke:Destroy() end)
                                    table.remove(smokeParts, i)
                                end
                            end
                        end
                        
                        -- === UPDATE ! ===
                        for i, exclaim in pairs(exclaimParts) do
                            if exclaim and exclaim.Parent then
                                exclaim.YOffset = (exclaim.YOffset or 0) + 0.04
                                exclaim.Position = head.Position + Vector3.new(0, 2 + exclaim.YOffset, 0)
                                exclaim.Transparency = exclaim.Transparency + 0.04
                                
                                if exclaim.Transparency > 1 then
                                    pcall(function() exclaim:Destroy() end)
                                    table.remove(exclaimParts, i)
                                end
                            end
                        end
                    end
                    
                    wait(0.033)
                end
            end)
            
        else
            -- Tắt
            speedBoosted = false
            speedIncreaseTime = 0
            isSleeping = false
            isWakeUpEffect = false
            
            if char and char:FindFirstChild("Humanoid") then
                char.Humanoid.WalkSpeed = baseSpeed
            end
            
            dotParts = clearEffects(dotParts)
            zzzParts = clearEffects(zzzParts)
            sweatParts = clearEffects(sweatParts)
            smokeParts = clearEffects(smokeParts)
            exclaimParts = clearEffects(exclaimParts)
            
            afkTimer = 0
        end
    end
})

game.Players.LocalPlayer.CharacterAdded:Connect(function(char)
    if isEnabled then
        wait(1)
        speedBoosted = false
        speedIncreaseTime = 0
        if char and char:FindFirstChild("Humanoid") then
            char.Humanoid.WalkSpeed = baseSpeed
        end
        
        for i = 1, 25 do
            local dot = createDot()
            table.insert(dotParts, dot)
        end
    end
end)

