-- Hàm tăng tốc độ (chỉ 1 lần duy nhất)
local function applySpeedBoost(char)
    if not char or not char:FindFirstChild("Humanoid") then return end
    if speedBoosted then return end -- Nếu đã tăng rồi thì không tăng nữa
    
    speedBoosted = true
    char.Humanoid.WalkSpeed = boostSpeed
    
    -- Tạo hiệu ứng thông báo tăng tốc
    local notif = Instance.new("Part")
    notif.Size = Vector3.new(2, 1, 2)
    notif.Shape = Enum.PartType.Block
    notif.Material = Enum.Material.Neon
    notif.Color = Color3.fromRGB(0, 255, 0)
    notif.Anchored = true
    notif.CanCollide = false
    notif.Transparency = 0.3
    notif.Parent = workspace
    
    local textLabel = Instance.new("BillboardGui", notif)
    textLabel.Size = UDim2.new(4, 0, 2, 0)
    textLabel.AlwaysOnTop = true
    
    local text = Instance.new("TextLabel", textLabel)
    text.Size = UDim2.new(1, 0, 1, 0)
    text.BackgroundTransparency = 1
    text.Text = "⚡ SPEED BOOSTED! 16 → 17 ⚡"
    text.TextColor3 = Color3.fromRGB(0, 255, 255)
    text.TextScaled = true
    text.Font = Enum.Font.GothamBold
    
    notif.Position = char.HumanoidRootPart.Position + Vector3.new(0, 4, 0)
    
    spawn(function()
        for i = 1, 30 do
            notif.Transparency = i / 30
            notif.Position = notif.Position + Vector3.new(0, 0.1, 0)
            wait(0.05)
        end
        notif:Destroy()
    end)
    
    print("Speed boosted: 16 → 17")
end

-- Hàm tắt tất cả hiệu ứng (giữ lại Zzz)
local function disableAllEffects()
    effectActive = false
    for _, v in pairs(auraParts) do 
        spawn(function()
            for i = 1, 10 do
                v.Transparency = v.Transparency + 0.1
                wait(0.05)
            end
            v:Destroy()
        end)
    end
    for _, v in pairs(dotParts) do 
        spawn(function()
            for i = 1, 10 do
                v.Transparency = v.Transparency + 0.1
                wait(0.05)
            end
            v:Destroy()
        end)
    end
    for _, v in pairs(numberParts) do 
        spawn(function()
            for i = 1, 10 do
                v.Transparency = v.Transparency + 0.1
                wait(0.05)
            end
            v:Destroy()
        end)
    end
    for _, v in pairs(errorParts) do 
        spawn(function()
            for i = 1, 10 do
                v.Transparency = v.Transparency + 0.1
                wait(0.05)
            end
            v:Destroy()
        end)
    end
    wait(0.5)
    auraParts = {}
    dotParts = {}
    numberParts = {}
    errorParts = {}
end

-- Hàm bật lại hiệu ứng
local function enableAllEffects(char)
    effectActive = true
    updateEffects(char)
end

-- Animation AFK cho R6 Nam (giữ nguyên)
local function createAfkAnimationMale(char)
    if not char or not char:FindFirstChild("Humanoid") then return end
    local humanoid = char.Humanoid
    if humanoid.RigType ~= Enum.HumanoidRigType.R6 then return end
    
    local torso = char:FindFirstChild("Torso")
    local head = char:FindFirstChild("Head")
    local leftArm = char:FindFirstChild("Left Arm")
    local rightArm = char:FindFirstChild("Right Arm")
    local leftLeg = char:FindFirstChild("Left Leg")
    local rightLeg = char:FindFirstChild("Right Leg")
    
    if not (torso and head and leftArm and rightArm and leftLeg and rightLeg) then return end
    
    isSleeping = true
    
    -- Tắt hết hiệu ứng
    disableAllEffects()
    
    -- Tạo Zzz
    for i = 1, 3 do
        local zzz = Instance.new("Part")
        zzz.Size = Vector3.new(0.3, 0.3, 0.3)
        zzz.Shape = Enum.PartType.Ball
        zzz.Material = Enum.Material.Neon
        zzz.Color = Color3.fromRGB(100, 200, 255)
        zzz.Anchored = true
        zzz.CanCollide = false
        zzz.Transparency = 0
        zzz.Parent = workspace
        
        local textLabel = Instance.new("BillboardGui", zzz)
        textLabel.Size = UDim2.new(2, 0, 2, 0)
        textLabel.AlwaysOnTop = true
        
        local text = Instance.new("TextLabel", textLabel)
        text.Size = UDim2.new(1, 0, 1, 0)
        text.BackgroundTransparency = 1
        text.Text = "Zzz"
        text.TextColor3 = Color3.fromRGB(100, 200, 255)
        text.TextScaled = true
        text.Font = Enum.Font.GothamBold
        
        zzz.Position = head.Position + Vector3.new(math.random(-2, 2), 2 + i * 0.5, math.random(-2, 2))
        table.insert(zzzParts, zzz)
    end
    
    -- Animation ngủ cho nam
    spawn(function()
        -- Bước 1: 2 chân tách 1 tí
        for i = 1, 10 do
            leftLeg.CFrame = leftLeg.CFrame * CFrame.Angles(0, 0, math.rad(0.5))
            rightLeg.CFrame = rightLeg.CFrame * CFrame.Angles(0, 0, math.rad(-0.5))
            wait(0.05)
        end
        
        -- Bước 2: Nhìn xung quanh trái phải
        for i = 1, 20 do
            head.CFrame = head.CFrame * CFrame.Angles(0, math.rad(math.sin(i/2) * 20), 0)
            wait(0.05)
        end
        
        -- Bước 3: 2 tay để vào nhau
        for i = 1, 15 do
            leftArm.CFrame = torso.CFrame * CFrame.new(-1.2, 0.3, 0.2) * CFrame.Angles(math.rad(-30), math.rad(10), math.rad(20))
            rightArm.CFrame = torso.CFrame * CFrame.new(1.2, 0.3, 0.2) * CFrame.Angles(math.rad(-30), math.rad(-10), math.rad(-20))
            wait(0.05)
        end
        
        -- Bước 4: Di chuyển tay xuống dưới rồi lên trên
        for cycle = 1, 3 do
            -- Xuống dưới
            for i = 1, 15 do
                leftArm.CFrame = leftArm.CFrame * CFrame.new(0, -0.05, 0)
                rightArm.CFrame = rightArm.CFrame * CFrame.new(0, -0.05, 0)
                wait(0.05)
            end
            -- Lên trên
            for i = 1, 15 do
                leftArm.CFrame = leftArm.CFrame * CFrame.new(0, 0.05, 0)
                rightArm.CFrame = rightArm.CFrame * CFrame.new(0, 0.05, 0)
                wait(0.05)
            end
        end
        
        -- Bước 5: Đầu gật (ngủ)
        for i = 1, 30 do
            head.CFrame = head.CFrame * CFrame.Angles(math.rad(0.3), 0, 0)
            wait(0.05)
        end
        
        -- Vòng lặp khi ngủ
        spawn(function()
            while isSleeping and char and char.Parent do
                -- Đầu gật nhẹ
                head.CFrame = head.CFrame * CFrame.Angles(math.rad(math.sin(tick() * 2) * 0.5), 0, 0)
                
                -- Tay hơi cử động
                leftArm.CFrame = leftArm.CFrame * CFrame.Angles(0, 0, math.rad(math.sin(tick() * 0.5) * 2))
                rightArm.CFrame = rightArm.CFrame * CFrame.Angles(0, 0, math.rad(math.sin(tick() * 0.7) * 2))
                
