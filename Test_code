        num.Anchored = true
        num.CanCollide = false
        num.Transparency = 0
        num.Parent = workspace
        
        local textLabel = Instance.new("BillboardGui", num)
        textLabel.Size = UDim2.new(2, 0, 2, 0)
        textLabel.AlwaysOnTop = true
        
        local text = Instance.new("TextLabel", textLabel)
        text.Size = UDim2.new(1, 0, 1, 0)
        text.BackgroundTransparency = 1
